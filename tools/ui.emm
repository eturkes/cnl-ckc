Use datetime.
Use fcntl.
Use hashlib.
Use html.
Use os.
Use pathlib.
Use re.
Use shutil.
Use subprocess.
Use sys.
Use tarfile.
Use tempfile.
Use urllib.parse.
Use wsgiref.simple_server.

Set usage_text to "ui: usage: expected: ui serve [<port>] [<root>] | ui render <outdir> [<root>] | ui check [<root>] | ui request <method> <path> [<root>] [--header <name:value>]* [--body <text>] [--body-hex <hex>] [--token <text>] [--now <utc-iso>] [--commit <40hex>] [--fault after-tmp-write]".
Set census_rx to [[re.compile]]("identify the ([0-9]+) payloads below").
Set ledger_header_text to "# format: docid<TAB>review_sha256<TAB>ace_commit<TAB>verdict<TAB>reviewer<TAB>date<TAB>comment".
Set commit_url_base to "https://github.com/eturkes/cnl-ckc/commit/".
Set verdict_field_names to <"verdict", "reviewer", "comment", "review_sha256", "ledger_sha256", "csrf">.
Set serve_config to {}.

Define [[out_line]] taking text:
    Set line_text to text plus "\n".
    Set data to [[line_text.encode]]("utf-8").
    Do [[sys.stdout.buffer.write]](data).
    Do [[sys.stdout.buffer.flush]]().

Define [[err_line]] taking text:
    Set line_text to text plus "\n".
    Set data to [[line_text.encode]]("utf-8").
    Do [[sys.stderr.buffer.write]](data).
    Do [[sys.stderr.buffer.flush]]().

Define [[usage_fail]] taking nothing:
    Do [[err_line]](usage_text).
    Exit with 2.

Define [[esc_text]] taking value:
    Give back [[html.escape]](value, quote=False).

Define [[esc_attr]] taking value:
    Give back [[html.escape]](value, quote=True).

Define [[url_seg]] taking value:
    Give back [[urllib.parse.quote]](value, safe="").

Define [[sha256_hex]] taking data:
    Set digest_value to [[hashlib.sha256]](data).
    Give back [[digest_value.hexdigest]]().

Define [[valid_ui_id]] taking value:
    Set allowed to [[set]]("abcdefghijklmnopqrstuvwxyz0123456789-").
    Set chars to [[set]](value).
    Set subset to [[chars.issubset]](allowed).
    If not value:
        Give back False.
    If [[value.startswith]]("-"):
        Give back False.
    Set value_bytes to [[bytes]]().
    Try:
        Set value_bytes to [[value.encode]]("utf-8").
    Catch UnicodeEncodeError:
        Give back False.
    If [[len]](value_bytes) is greater than 250:
        Give back False.
    Give back subset.

Define [[valid_post_date]] taking date_text:
    If [[len]](date_text) does not equal 20:
        Give back False.
    Set digit_chars to [[set]]("0123456789").
    Set position to 0.
    For each char_text in date_text:
        Set expected to "".
        If position equals 4:
            Set expected to "-".
        If position equals 7:
            Set expected to "-".
        If position equals 10:
            Set expected to "T".
        If position equals 13:
            Set expected to ":".
        If position equals 16:
            Set expected to ":".
        If position equals 19:
            Set expected to "Z".
        If expected:
            If char_text does not equal expected:
                Give back False.
        Otherwise:
            Set is_digit to char_text is in digit_chars.
            If not is_digit:
                Give back False.
        Set position to position plus 1.
    Try:
        Do [[datetime.datetime.strptime]](date_text, "%Y-%m-%dT%H:%M:%SZ").
    Catch ValueError:
        Give back False.
    Give back True.

Define [[valid_hex64]] taking value:
    If [[len]](value) does not equal 64:
        Give back False.
    Set allowed to [[set]]("0123456789abcdef").
    Set chars to [[set]](value).
    Give back [[chars.issubset]](allowed).

Define [[valid_hex40]] taking value:
    If [[len]](value) does not equal 40:
        Give back False.
    Set allowed to [[set]]("0123456789abcdef").
    Set chars to [[set]](value).
    Give back [[chars.issubset]](allowed).

Define [[commit_field_ok]] taking value:
    Give back [[valid_hex40]](value).


Define [[field_text_ok]] taking value:
    For each char_text in value:
        Set code_point to [[ord]](char_text).
        If code_point is less than 32:
            Give back False.
        If code_point equals 127:
            Give back False.
    Give back True.

Define [[err]] taking detail:
    Give back <"err", detail>.

Define [[ok]] taking value:
    Give back <"ok", value>.

Define [[result_kind]] taking result:
    Set copy_list to [[list]](result).
    Give back [[copy_list.pop]](0).

Define [[result_value]] taking result:
    Set copy_list to [[list]](result).
    Set kind to [[copy_list.pop]](0).
    Give back [[copy_list.pop]](0).

Define [[control_violation]] taking text, gid, relpath:
    Set bad_point to None.
    For each ch in text:
        Set code_point to [[ord]](ch).
        Set bad to False.
        If code_point is less than 32:
            If code_point does not equal 9:
                If code_point does not equal 10:
                    Set bad to True.
        If code_point equals 127:
            Set bad to True.
        If code_point is greater than 8233:
            If code_point is less than 8239:
                Set bad to True.
        If code_point is greater than 8293:
            If code_point is less than 8298:
                Set bad to True.
        If bad:
            If bad_point equals None:
                Set bad_point to code_point.
    If bad_point does not equal None:
        Set hex_text to [[format]](bad_point, "04X").
        Give back "ui: viewmodel: " plus gid plus " unsupported control U+" plus hex_text plus " in " plus relpath.
    Give back "".

Define [[load_text]] taking path, gid, relpath:
    Try:
        Set data to [[path.read_bytes]]().
    Catch OSError:
        Give back [[err]]("ui: viewmodel: " plus gid plus " missing " plus relpath).
    Set text to "".
    Try:
        Set text to [[data.decode]]("utf-8").
    Catch UnicodeDecodeError:
        Give back [[err]]("ui: viewmodel: " plus gid plus " file not UTF-8: " plus relpath).
    Set control_detail to [[control_violation]](text, gid, relpath).
    If control_detail:
        Give back [[err]](control_detail).
    Give back [[ok]](text).

Define [[strip_list_label]] taking payload_line:
    Set label_parts to [[payload_line.split]](". ", 1).
    If [[len]](label_parts) does not equal 2:
        Give back payload_line.
    Set head_text to [[label_parts.pop]](0).
    Set tail_text to [[label_parts.pop]](0).
    If not head_text:
        Give back payload_line.
    Set digit_chars to [[set]]("0123456789").
    Set head_chars to [[set]](head_text).
    Set all_digits to [[head_chars.issubset]](digit_chars).
    If not all_digits:
        Give back payload_line.
    Give back tail_text.

Define [[parse_evidence]] taking text:
    Set census_count to None.
    Set census_hit to [[census_rx.search]](text).
    If census_hit does not equal None:
        Set census_count to [[census_hit.group]](1).
    Set locator_ids to <>.
    Set locator_lines to {}.
    Set locator_counts to {}.
    Set current_locator to "".
    Set current_payloads to <>.
    Set past_first_blank to False.
    Set post_blank_lines to <>.
    For each raw_line in [[text.split]]("\n"):
        Set is_locator to False.
        Set bracketed to [[raw_line.startswith]]("[").
        If bracketed:
            Set closed to [[raw_line.endswith]]("]").
            Set delimited to " | " is in raw_line.
            If closed:
                If delimited:
                    Set body_text to [[raw_line.removeprefix]]("[").
                    Set parts to [[body_text.split]](" | ").
                    Set region_id to [[parts.pop]](0).
                    Set spaced to " " is in region_id.
                    If region_id:
                        If not spaced:
                            Set is_locator to True.
                            If current_locator:
                                Set line_count to [[len]](current_payloads).
                                Do [[locator_counts.update]]({current_locator: line_count}).
                                If line_count equals 1:
                                    Set payload_line to [[current_payloads.pop]](0).
                                    Do [[locator_lines.update]]({current_locator: payload_line}).
                            Do [[locator_ids.append]](region_id).
                            Set current_locator to region_id.
                            Set current_payloads to <>.
        If not is_locator:
            If raw_line equals "":
                Set past_first_blank to True.
            Otherwise:
                If current_locator:
                    Do [[current_payloads.append]](raw_line).
                If past_first_blank:
                    Do [[post_blank_lines.append]](raw_line).
    If current_locator:
        Set line_count to [[len]](current_payloads).
        Do [[locator_counts.update]]({current_locator: line_count}).
        If line_count equals 1:
            Set payload_line to [[current_payloads.pop]](0).
            Do [[locator_lines.update]]({current_locator: payload_line}).
    Set ordered_payloads to <>.
    If not locator_ids:
        For each post_blank_line in post_blank_lines:
            Do [[ordered_payloads.append]]([[strip_list_label]](post_blank_line)).
    Give back <census_count, locator_ids, locator_lines, locator_counts, ordered_payloads>.

Define [[parse_tsv_rows]] taking text, field_count, gid, label:
    Set rows to <>.
    Set line_list to [[text.split]]("\n").
    For each line_text in line_list:
        Set is_comment to [[line_text.startswith]]("#").
        If not is_comment:
            If line_text:
                Set fields to [[line_text.split]]("\t").
                If [[len]](fields) does not equal field_count:
                    Give back [[err]]("ui: viewmodel: " plus gid plus " malformed " plus label plus " row: " plus line_text).
                Do [[rows.append]](<fields, line_text>).
    Give back [[ok]](rows).

Define [[list_stems]] taking dir_path, suffix:
    Set stems to <>.
    If [[dir_path.is_dir]]():
        For each entry in [[sorted]]([[dir_path.iterdir]]()):
            Set symlink to [[entry.is_symlink]]().
            If not symlink:
                If [[entry.is_file]]():
                    Set name_text to entry.name.
                    If [[name_text.endswith]](suffix):
                        Do [[stems.append]]([[name_text.removesuffix]](suffix)).
    Give back [[sorted]](stems).

Define [[valid_asset_name]] taking name_text:
    If not name_text:
        Give back False.
    If [[name_text.startswith]]("."):
        Give back False.
    For each ch in name_text:
        Set allowed to False.
        If [[ch.isascii]]():
            If [[ch.isalnum]]():
                Set allowed to True.
        If ch equals ".":
            Set allowed to True.
        If ch equals "_":
            Set allowed to True.
        If ch equals "-":
            Set allowed to True.
        If not allowed:
            Give back False.
    Give back True.

Define [[asset_media_type]] taking name_text:
    If [[name_text.endswith]](".txt"):
        Give back "text/plain; charset=utf-8".
    If [[name_text.endswith]](".pdf"):
        Give back "application/pdf".
    Give back "".

Define [[source_assets]] taking guideline_path:
    Set names to <>.
    Set source_dir to [[guideline_path.joinpath]]("source").
    If [[source_dir.is_symlink]]():
        Give back names.
    If not [[source_dir.is_dir]]():
        Give back names.
    For each entry in [[sorted]]([[source_dir.iterdir]]()):
        Set usable to [[entry.is_file]]().
        If [[entry.is_symlink]]():
            Set usable to False.
        If usable:
            Set name_text to entry.name.
            If [[valid_asset_name]](name_text):
                If [[asset_media_type]](name_text):
                    Do [[names.append]](name_text).
    Give back names.

Define [[readme_title]] taking guideline_path, gid:
    Set readme_path to [[guideline_path.joinpath]]("README.md").
    Try:
        Set data to [[readme_path.read_bytes]]().
    Catch OSError:
        Give back [[ok]](gid).
    Set text to "".
    Try:
        Set text to [[data.decode]]("utf-8").
    Catch UnicodeDecodeError:
        Give back [[err]]("ui: viewmodel: " plus gid plus " file not UTF-8: README.md").
    Set control_detail to [[control_violation]](text, gid, "README.md").
    If control_detail:
        Give back [[err]](control_detail).
    For each line_text in [[text.split]]("\n"):
        If [[line_text.startswith]]("# "):
            Set heading to [[line_text.removeprefix]]("# ").
            Set heading to [[heading.strip]]().
            If heading:
                Give back [[ok]](heading).
    Give back [[ok]](gid).

Define [[humanize_section]] taking section_text:
    Set segs to <>.
    For each raw_seg in [[section_text.split]](">"):
        Set seg to [[raw_seg.strip]]().
        If seg:
            Do [[segs.append]](seg).
    If [[len]](segs) equals 0:
        Give back "".
    Set head to [[segs.pop]](0).
    Set head_parts to [[head.split]](" ").
    Set head_word to "".
    Set head_number to "".
    If [[len]](head_parts) equals 2:
        Set head_word to [[head_parts.pop]](0).
        Set head_number to [[head_parts.pop]](0).
        If not [[head_number.isascii]]():
            Set head_word to "".
        If not [[head_number.isdigit]]():
            Set head_word to "".
    Set out_segs to <>.
    If head_word equals "Rec":
        Do [[out_segs.append]]("Recommendation " plus head_number).
    Otherwise:
        Set drop_head to False.
        If head_word equals "BOX":
            If [[len]](segs) is greater than 0:
                Set drop_head to True.
        If not drop_head:
            Do [[out_segs.append]](head).
    For each seg in segs:
        Do [[out_segs.append]](seg).
    Set title_joiner to " · ".
    Give back [[title_joiner.join]](out_segs).

Define [[human_date]] taking date_text:
    If not [[date_text.endswith]]("Z"):
        Give back date_text.
    Set parts to [[date_text.removesuffix]]("Z").
    Set parts to [[parts.split]]("T").
    If [[len]](parts) does not equal 2:
        Give back date_text.
    Set day_text to [[parts.pop]](0).
    Set time_text to [[parts.pop]](0).
    Give back day_text plus " " plus time_text plus " UTC".

Define [[document_title]] taking docid, section_text, page_text, region_id, shared:
    Set base to [[humanize_section]](section_text).
    If not base:
        Give back docid.
    If not shared:
        Give back base.
    Set page_number to [[page_text.strip]]().
    If [[page_number.startswith]]("p"):
        Set page_number to [[page_number.removeprefix]]("p").
    If not [[page_number.isascii]]():
        Set page_number to "".
    If not [[page_number.isdigit]]():
        Set page_number to "".
    Set last_part to "".
    For each part in [[region_id.split]]("-"):
        Set last_part to part.
    Set passage_number to "".
    If [[last_part.isascii]]():
        If [[last_part.isdigit]]():
            Set passage_number to [[str]]([[int]](last_part)).
    If page_number:
        If passage_number:
            Give back base plus ", page " plus page_number plus ", passage " plus passage_number.
    Give back base plus " (" plus region_id plus ")".

Define [[first_output_line]] taking result:
    Set stderr_text to [[result.stderr.decode]]("utf-8", errors="replace").
    For each line_text in [[stderr_text.splitlines]]():
        Set stripped to [[line_text.strip]]().
        If stripped:
            Give back stripped.
    Set stdout_text to [[result.stdout.decode]]("utf-8", errors="replace").
    For each line_text in [[stdout_text.splitlines]]():
        Set stripped to [[line_text.strip]]().
        If stripped:
            Give back stripped.
    Give back "validator produced no diagnostic".

Define [[goal_py_path]] taking nothing:
    Set argv_copy to [[list]](sys.argv).
    Set script_text to [[argv_copy.pop]](0).
    Set script_path to [[pathlib.Path]](script_text).
    Set resolved to [[script_path.resolve]]().
    Set tool_dir to resolved.parent.
    Give back [[tool_dir.joinpath]]("goal.py").

Define [[git_output]] taking work_dir, arg_list:
    Set command to <"git">.
    For each arg_text in arg_list:
        Do [[command.append]](arg_text).
    Set result to None.
    Try:
        Set result to [[subprocess.run]](command, capture_output=True, cwd=work_dir).
    Catch OSError:
        Give back None.
    If result.returncode does not equal 0:
        Give back None.
    Give back [[result.stdout.decode]]("utf-8", errors="replace").

Define [[corpus_head_hex]] taking root_path:
    Set work_dir to [[str]]([[root_path.resolve]]()).
    Set top_command to <"git", "rev-parse", "--show-toplevel">.
    Set top_result to None.
    Try:
        Set top_result to [[subprocess.run]](top_command, capture_output=True, cwd=work_dir).
    Catch OSError:
        Give back "unavailable".
    If top_result.returncode does not equal 0:
        Give back "".
    Set top_text to [[top_result.stdout.decode]]("utf-8", errors="replace").
    Set top_path to [[pathlib.Path]]([[top_text.strip]]()).
    Set top_resolved to [[str]]([[top_path.resolve]]()).
    If top_resolved does not equal work_dir:
        Give back "".
    Set head_text to [[git_output]](work_dir, <"rev-parse", "HEAD">).
    If head_text equals None:
        Give back "".
    Set head_hex to [[head_text.strip]]().
    If not [[valid_hex40]](head_hex):
        Give back "".
    Give back head_hex.

Define [[extract_committed]] taking archive_path, dest_root:
    Set extract_ok to True.
    Try:
        Set archive to [[tarfile.open]]([[str]](archive_path)).
        For each member in [[archive.getmembers]]():
            Set name_text to member.name.
            Set safe to True.
            If [[name_text.startswith]]("/"):
                Set safe to False.
            Set segs to [[name_text.split]]("/").
            Set has_dotdot to ".." is in segs.
            If has_dotdot:
                Set safe to False.
            If not safe:
                Set extract_ok to False.
            Otherwise:
                Set target to [[dest_root.joinpath]](name_text).
                Set is_dir to [[member.isdir]]().
                Set is_file to [[member.isfile]]().
                If is_dir:
                    Do [[target.mkdir]](parents=True, exist_ok=True).
                Otherwise if is_file:
                    Set parent_dir to target.parent.
                    Do [[parent_dir.mkdir]](parents=True, exist_ok=True).
                    Set stream to [[archive.extractfile]](member).
                    Set payload to [[stream.read]]().
                    Do [[target.write_bytes]](payload).
                Otherwise:
                    Set extract_ok to False.
        Do [[archive.close]]().
    Catch tarfile.TarError:
        Set extract_ok to False.
    Catch OSError:
        Set extract_ok to False.
    Give back extract_ok.

Define [[materialize_committed]] taking root_path, commit_hex:
    Set work_dir to [[str]]([[root_path.resolve]]()).
    Set scratch_text to [[tempfile.mkdtemp]]().
    Set scratch_dir to [[pathlib.Path]](scratch_text).
    Set archive_path to [[scratch_dir.joinpath]]("committed.tar").
    Set command to <"git", "archive", "--format=tar", "-o", [[str]](archive_path), commit_hex, "guidelines">.
    Set result to None.
    Set launched to True.
    Try:
        Set result to [[subprocess.run]](command, capture_output=True, cwd=work_dir).
    Catch OSError:
        Set launched to False.
    Set built to launched.
    If launched:
        If result.returncode does not equal 0:
            Set built to False.
    Set dest_root to [[scratch_dir.joinpath]]("corpus").
    If built:
        Do [[dest_root.mkdir]](parents=True, exist_ok=True).
        Set built to [[extract_committed]](archive_path, dest_root).
    If not built:
        Do [[shutil.rmtree]](scratch_text, ignore_errors=True).
        Give back <"", None>.
    Give back <scratch_text, dest_root>.

Define [[overlay_ledgers]] taking real_root, corpus_root:
    Set real_guidelines to [[real_root.joinpath]]("guidelines").
    Set corpus_guidelines to [[corpus_root.joinpath]]("guidelines").
    If not [[corpus_guidelines.is_dir]]():
        Give back True.
    For each entry in [[sorted]]([[corpus_guidelines.iterdir]]()):
        If [[entry.is_dir]]():
            Set committed_ledger to [[entry.joinpath]]("audit", "adjudication.tsv").
            Set live_ledger to [[real_guidelines.joinpath]](entry.name, "audit", "adjudication.tsv").
            Try:
                If [[live_ledger.is_file]]():
                    Set audit_dir to committed_ledger.parent.
                    Do [[audit_dir.mkdir]](parents=True, exist_ok=True).
                    Set payload to [[live_ledger.read_bytes]]().
                    Do [[committed_ledger.write_bytes]](payload).
                Otherwise if [[committed_ledger.is_file]]():
                    Do [[committed_ledger.unlink]]().
            Catch OSError:
                Give back False.
    Give back True.

Define [[worktree_corpus]] taking root_path:
    Set corpus to {}.
    Do [[corpus.update]]({"root": root_path}).
    Do [[corpus.update]]({"real_root": root_path}).
    Do [[corpus.update]]({"scratch": ""}).
    Do [[corpus.update]]({"commit": ""}).
    Give back corpus.

Define [[resolve_corpus]] taking root_path:
    Set corpus to [[worktree_corpus]](root_path).
    Set head_hex to [[corpus_head_hex]](root_path).
    If head_hex equals "unavailable":
        Give back [[err]]("ui: corpus: cannot read the committed guideline files").
    If head_hex equals "":
        Give back [[ok]](corpus).
    Set pair to [[materialize_committed]](root_path, head_hex).
    Set pair_copy to [[list]](pair).
    Set scratch_text to [[pair_copy.pop]](0).
    Set dest_root to [[pair_copy.pop]](0).
    If scratch_text equals "":
        Give back [[err]]("ui: corpus: cannot read the committed guideline files").
    Set overlay_ok to [[overlay_ledgers]](root_path, dest_root).
    If not overlay_ok:
        Do [[shutil.rmtree]](scratch_text, ignore_errors=True).
        Give back [[err]]("ui: corpus: cannot read the committed guideline files").
    Do [[corpus.update]]({"root": dest_root}).
    Do [[corpus.update]]({"scratch": scratch_text}).
    Do [[corpus.update]]({"commit": head_hex}).
    Give back [[ok]](corpus).

Define [[release_corpus]] taking corpus:
    Set scratch_text to [[corpus.get]]("scratch", "").
    If scratch_text:
        Do [[shutil.rmtree]](scratch_text, ignore_errors=True).

Define [[ace_commit_hex]] taking guideline_path, docid, corpus_commit:
    If not [[valid_hex40]](corpus_commit):
        Give back "".
    Set ace_path to [[guideline_path.joinpath]]("ace", docid plus ".ace").
    Set work_dir to [[str]]([[guideline_path.resolve]]()).
    Set ace_text to [[str]]([[ace_path.resolve]]()).
    Set log_command to <"git", "log", "-1", "--format=%H", corpus_commit, "--", ace_text>.
    Set log_result to None.
    Try:
        Set log_result to [[subprocess.run]](log_command, capture_output=True, cwd=work_dir).
    Catch OSError:
        Give back "".
    If log_result.returncode does not equal 0:
        Give back "".
    Set log_text to [[log_result.stdout.decode]]("utf-8", errors="replace").
    Set commit_text to [[log_text.strip]]().
    If not [[valid_hex40]](commit_text):
        Give back "".
    Give back commit_text.

Define [[build_doc_states]] taking guideline_path, gid, docids, review_by_docid, manifest_text:
    Set ledger_path to [[guideline_path.joinpath]]("audit", "adjudication.tsv").
    Set states to {}.
    For each docid in docids:
        Do [[states.update]]({docid: "unreviewed"}).
    Set ledger_by_docid to {}.
    Set ledger_order to <>.
    Set ledger_file_digest to "absent".
    If not [[ledger_path.is_file]]():
        Give back [[ok]](<states, ledger_by_docid, ledger_order, ledger_file_digest>).
    Try:
        Set ledger_bytes to [[ledger_path.read_bytes]]().
    Catch OSError:
        Give back [[err]]("ui: viewmodel: " plus gid plus " missing audit/adjudication.tsv").
    Set ledger_file_digest to [[sha256_hex]](ledger_bytes).
    Set goal_py to [[goal_py_path]]().
    Set scratch_text to [[tempfile.mkdtemp]]().
    Set scratch_dir to [[pathlib.Path]](scratch_text).
    Set ledger_copy to [[scratch_dir.joinpath]]("ledger.tsv").
    Set manifest_copy to [[scratch_dir.joinpath]]("manifest.tsv").
    Do [[ledger_copy.write_bytes]](ledger_bytes).
    Set manifest_bytes to [[manifest_text.encode]]("utf-8").
    Do [[manifest_copy.write_bytes]](manifest_bytes).
    Set command to <sys.executable, "-P", [[str]](goal_py), "ledger-validate", [[str]](ledger_copy), [[str]](manifest_copy), "ui">.
    Set tool_dir to goal_py.parent.
    Set repo_root to tool_dir.parent.
    Set result to [[subprocess.run]](command, capture_output=True, cwd=[[str]](repo_root)).
    Do [[shutil.rmtree]](scratch_text, ignore_errors=True).
    If result.returncode does not equal 0:
        Set relay to [[first_output_line]](result).
        Give back [[err]]("ui: adjudication ledger invalid: " plus relay).
    Set ledger_text to "".
    Try:
        Set ledger_text to [[ledger_bytes.decode]]("utf-8").
    Catch UnicodeDecodeError:
        Give back [[err]]("ui: viewmodel: " plus gid plus " file not UTF-8: audit/adjudication.tsv").
    Set rows_result to [[parse_tsv_rows]](ledger_text, 7, gid, "adjudication").
    If [[result_kind]](rows_result) equals "err":
        Give back rows_result.
    Set current_approved to {}.
    Set current_rejected to {}.
    For each row_pair in [[result_value]](rows_result):
        Set pair_copy to [[list]](row_pair).
        Set fields to [[pair_copy.pop]](0).
        Set docid to [[fields.pop]](0).
        Set row_digest to [[fields.pop]](0).
        Set commit_field to [[fields.pop]](0).
        Set verdict to [[fields.pop]](0).
        Set reviewer_field to [[fields.pop]](0).
        Set date_field to [[fields.pop]](0).
        Set comment_field to [[fields.pop]](0).
        Set current_digest to [[review_by_docid.get]](docid, "").
        Set current to row_digest equals current_digest.
        Set row to <row_digest, commit_field, verdict, reviewer_field, date_field, comment_field, current>.
        Set known to docid is in ledger_by_docid.
        If not known:
            Do [[ledger_by_docid.update]]({docid: <>}).
        Set doc_history to [[ledger_by_docid.get]](docid).
        Do [[doc_history.append]](row).
        Do [[ledger_order.append]](<docid, row_digest, commit_field, verdict, reviewer_field, date_field, comment_field, current>).
        If current:
            If verdict equals "approved":
                Do [[current_approved.update]]({docid: True}).
            Otherwise:
                Do [[current_rejected.update]]({docid: True}).
    For each row_docid in ledger_by_docid:
        Set has_approved to row_docid is in current_approved.
        Set has_rejected to row_docid is in current_rejected.
        Set row_state to "stale".
        If has_approved:
            Set row_state to "approved".
            If has_rejected:
                Set row_state to "contested".
        Otherwise if has_rejected:
            Set row_state to "rejected".
        Do [[states.update]]({row_docid: row_state}).
    Give back [[ok]](<states, ledger_by_docid, ledger_order, ledger_file_digest>).

Define [[build_guideline_model]] taking corpus, gid:
    Set root_path to [[corpus.get]]("root", None).
    Set real_root to [[corpus.get]]("real_root", None).
    Set corpus_commit to [[corpus.get]]("commit", "").
    Set guideline_path to [[root_path.joinpath]]("guidelines", gid).
    Set real_guideline_path to [[real_root.joinpath]]("guidelines", gid).
    If not [[valid_ui_id]](gid):
        Give back [[err]]("ui: viewmodel: " plus gid plus " invalid guideline id").
    Set coverage_path to [[guideline_path.joinpath]]("coverage.tsv").
    If not [[coverage_path.is_file]]():
        Give back [[err]]("ui: viewmodel: " plus gid plus " missing coverage.tsv").
    Set coverage_result to [[load_text]](coverage_path, gid, "coverage.tsv").
    If [[result_kind]](coverage_result) equals "err":
        Give back coverage_result.
    Set coverage_text to [[result_value]](coverage_result).
    Set rows_result to [[parse_tsv_rows]](coverage_text, 5, gid, "coverage").
    If [[result_kind]](rows_result) equals "err":
        Give back rows_result.
    Set coverage_rows to [[result_value]](rows_result).
    Set docids to <>.
    Set region_by_docid to {}.
    Set section_by_docid to {}.
    Set page_by_docid to {}.
    Set file_by_docid to {}.
    Set region_rows to <>.
    Set file_row_regions to {}.
    Set file_docid_ordinal to {}.
    Set duplicate_docids to <>.
    Set ace_counter to 0.
    Set restates_counter to 0.
    Set uncovered_counter to 0.
    Set pending_counter to 0.
    For each row_pair in coverage_rows:
        Set pair_copy to [[list]](row_pair).
        Set fields to [[pair_copy.pop]](0).
        Set region_id to [[fields.pop]](0).
        Set file_text to [[fields.pop]](0).
        Set page_text to [[fields.pop]](0).
        Set section_text to [[fields.pop]](0).
        Set status_text to [[fields.pop]](0).
        Set known_file to [[file_row_regions.get]](file_text, None).
        If known_file equals None:
            Set known_file to <>.
            Do [[file_row_regions.update]]({file_text: known_file}).
        Set ordinal to [[len]](known_file).
        Do [[known_file.append]](region_id).
        Set is_ace to [[status_text.startswith]]("ace(").
        If is_ace:
            Set closed_status to [[status_text.endswith]](")").
            If not closed_status:
                Give back [[err]]("ui: viewmodel: " plus gid plus " malformed coverage row: " plus region_id).
            Set docid to [[status_text.removeprefix]]("ace(").
            Set docid to [[docid.removesuffix]](")").
            If not [[valid_ui_id]](docid):
                Give back [[err]]("ui: viewmodel: " plus gid plus " invalid docid " plus docid).
            Set seen to [[region_by_docid.get]](docid, "").
            If seen:
                Do [[duplicate_docids.append]](docid).
            Otherwise:
                Do [[docids.append]](docid).
                Do [[region_by_docid.update]]({docid: region_id}).
                Do [[section_by_docid.update]]({docid: section_text}).
                Do [[page_by_docid.update]]({docid: page_text}).
                Do [[file_by_docid.update]]({docid: file_text}).
                Do [[file_docid_ordinal.update]]({docid: ordinal}).
            Set ace_counter to ace_counter plus 1.
        Otherwise:
            Set display_text to "".
            If [[status_text.startswith]]("restates("):
                Set inner to [[status_text.removeprefix]]("restates(").
                If not [[inner.endswith]](")"):
                    Give back [[err]]("ui: viewmodel: " plus gid plus " malformed coverage row: " plus region_id).
                Set inner to [[inner.removesuffix]](")").
                If not inner:
                    Give back [[err]]("ui: viewmodel: " plus gid plus " malformed coverage row: " plus region_id).
                Set display_text to "Restates " plus inner.
                Set restates_counter to restates_counter plus 1.
            Otherwise if [[status_text.startswith]]("uncovered("):
                Set inner to [[status_text.removeprefix]]("uncovered(").
                If not [[inner.endswith]](")"):
                    Give back [[err]]("ui: viewmodel: " plus gid plus " malformed coverage row: " plus region_id).
                Set inner to [[inner.removesuffix]](")").
                Set reason_parts to [[inner.split]](": ", 1).
                Set reason_text to [[reason_parts.pop]]().
                If [[len]](reason_parts) equals 0:
                    Give back [[err]]("ui: viewmodel: " plus gid plus " malformed coverage row: " plus region_id).
                If not reason_text:
                    Give back [[err]]("ui: viewmodel: " plus gid plus " malformed coverage row: " plus region_id).
                Set display_text to "Not covered — " plus reason_text.
                Set uncovered_counter to uncovered_counter plus 1.
            Otherwise if status_text equals "pending":
                Set display_text to "Pending".
                Set pending_counter to pending_counter plus 1.
            Otherwise:
                Give back [[err]]("ui: viewmodel: " plus gid plus " malformed coverage row: " plus region_id).
            Do [[region_rows.append]](<region_id, display_text, section_text>).
    If duplicate_docids:
        Give back [[err]]("ui: viewmodel: " plus gid plus " duplicate docid " plus [[min]](duplicate_docids)).
    Set sorted_docids to [[sorted]](docids).
    Set section_doc_counts to {}.
    For each docid in sorted_docids:
        Set section_text to [[section_by_docid.get]](docid, "").
        Set seen_count to [[section_doc_counts.get]](section_text, 0).
        Do [[section_doc_counts.update]]({section_text: seen_count plus 1}).
    Set title_by_docid to {}.
    For each docid in sorted_docids:
        Set section_text to [[section_by_docid.get]](docid, "").
        Set shared to False.
        If [[section_doc_counts.get]](section_text, 0) is greater than 1:
            Set shared to True.
        Set page_text to [[page_by_docid.get]](docid, "").
        Set region_id to [[region_by_docid.get]](docid, "").
        Do [[title_by_docid.update]]({docid: [[document_title]](docid, section_text, page_text, region_id, shared)}).
    Set ace_stems to [[list_stems]]([[guideline_path.joinpath]]("ace"), ".ace").
    For each docid in sorted_docids:
        Set present to docid is in ace_stems.
        If not present:
            Give back [[err]]("ui: viewmodel: " plus gid plus " doc " plus docid plus " missing ace file").
    For each stem in ace_stems:
        Set claimed to [[region_by_docid.get]](stem, "").
        If not claimed:
            Give back [[err]]("ui: viewmodel: " plus gid plus " orphan ace file " plus stem plus ".ace").
    Set manifest_path to [[guideline_path.joinpath]]("audit", "review-manifest.tsv").
    If not [[manifest_path.is_file]]():
        Give back [[err]]("ui: viewmodel: " plus gid plus " missing audit/review-manifest.tsv").
    Set manifest_result to [[load_text]](manifest_path, gid, "audit/review-manifest.tsv").
    If [[result_kind]](manifest_result) equals "err":
        Give back manifest_result.
    Set manifest_text to [[result_value]](manifest_result).
    Set manifest_rows_result to [[parse_tsv_rows]](manifest_text, 6, gid, "review-manifest").
    If [[result_kind]](manifest_rows_result) equals "err":
        Give back manifest_rows_result.
    Set ace_digest_by_docid to {}.
    Set payload_digest_by_docid to {}.
    Set review_by_docid to {}.
    Set manifest_docids to <>.
    For each row_pair in [[result_value]](manifest_rows_result):
        Set pair_copy to [[list]](row_pair).
        Set fields to [[pair_copy.pop]](0).
        Set docid to [[fields.pop]](0).
        Set ace_digest to [[fields.pop]](0).
        Set coverage_digest to [[fields.pop]](0).
        Set payload_digest to [[fields.pop]](0).
        Set dup_row to docid is in manifest_docids.
        If dup_row:
            Give back [[err]]("ui: viewmodel: " plus gid plus " duplicate review-manifest doc " plus docid).
        Do [[manifest_docids.append]](docid).
        Do [[ace_digest_by_docid.update]]({docid: ace_digest}).
        Do [[payload_digest_by_docid.update]]({docid: payload_digest}).
        Set clause_digest to [[fields.pop]](0).
        Set review_digest to [[fields.pop]](0).
        Do [[review_by_docid.update]]({docid: review_digest}).
    For each docid in sorted_docids:
        Set present to [[review_by_docid.get]](docid, "").
        If not present:
            Give back [[err]]("ui: viewmodel: " plus gid plus " doc " plus docid plus " missing review-manifest row").
    For each docid in [[sorted]](manifest_docids):
        Set claimed to [[region_by_docid.get]](docid, "").
        If not claimed:
            Give back [[err]]("ui: viewmodel: " plus gid plus " orphan review-manifest doc " plus docid).
    Set pl_stems to [[list_stems]]([[guideline_path.joinpath]]("pl"), ".pl").
    For each docid in sorted_docids:
        Set present to docid is in pl_stems.
        If not present:
            Give back [[err]]("ui: viewmodel: " plus gid plus " doc " plus docid plus " missing Prolog file").
    For each stem in pl_stems:
        Set claimed to [[region_by_docid.get]](stem, "").
        If not claimed:
            Give back [[err]]("ui: viewmodel: " plus gid plus " orphan Prolog file " plus stem plus ".pl").
    Set evidence_cache to {}.
    Set payload_by_docid to {}.
    For each docid in sorted_docids:
        Set file_text to [[file_by_docid.get]](docid, "").
        Set region_id to [[region_by_docid.get]](docid, "").
        Set file_hostile to False.
        If [[file_text.startswith]]("/"):
            Set file_hostile to True.
        Set has_backslash to "\\" is in file_text.
        If has_backslash:
            Set file_hostile to True.
        Set file_segs to [[file_text.split]]("/").
        Set has_dotdot to ".." is in file_segs.
        If has_dotdot:
            Set file_hostile to True.
        If file_hostile:
            Give back [[err]]("ui: viewmodel: " plus gid plus " doc " plus docid plus " region " plus region_id plus " unresolved in " plus file_text).
        Set parsed to [[evidence_cache.get]](file_text, None).
        If parsed equals None:
            Set evidence_path to [[guideline_path.joinpath]](file_text).
            Set evidence_result to [[load_text]](evidence_path, gid, file_text).
            If [[result_kind]](evidence_result) equals "err":
                Give back evidence_result.
            Set parsed to [[parse_evidence]]([[result_value]](evidence_result)).
            Do [[evidence_cache.update]]({file_text: parsed}).
        Set parsed_copy to [[list]](parsed).
        Set census_count to [[parsed_copy.pop]](0).
        Set locator_ids to [[parsed_copy.pop]](0).
        Set locator_lines to [[parsed_copy.pop]](0).
        Set locator_counts to [[parsed_copy.pop]](0).
        Set ordered_payloads to [[parsed_copy.pop]](0).
        Set payload_line to "".
        If locator_ids:
            Set seen_count to 0.
            For each locator_id in locator_ids:
                If locator_id equals region_id:
                    Set seen_count to seen_count plus 1.
            If seen_count equals 0:
                Give back [[err]]("ui: viewmodel: " plus gid plus " doc " plus docid plus " region " plus region_id plus " unresolved in " plus file_text).
            If seen_count is greater than 1:
                Give back [[err]]("ui: viewmodel: " plus gid plus " duplicate region locator " plus region_id plus " in " plus file_text).
            Set line_count to [[locator_counts.get]](region_id, 0).
            If line_count equals 0:
                Give back [[err]]("ui: viewmodel: " plus gid plus " doc " plus docid plus " region " plus region_id plus " has empty payload").
            If line_count does not equal 1:
                Give back [[err]]("ui: viewmodel: " plus gid plus " doc " plus docid plus " region " plus region_id plus " unresolved in " plus file_text).
            Set payload_line to [[locator_lines.get]](region_id, "").
        Otherwise:
            Set file_regions to [[file_row_regions.get]](file_text, <>).
            Set row_total to [[len]](file_regions).
            Set payload_total to [[len]](ordered_payloads).
            If census_count does not equal [[str]](payload_total):
                Give back [[err]]("ui: viewmodel: " plus gid plus " region census mismatch " plus file_text plus " coverage=" plus [[str]](row_total) plus " payloads=" plus [[str]](payload_total)).
            If row_total does not equal payload_total:
                Give back [[err]]("ui: viewmodel: " plus gid plus " region census mismatch " plus file_text plus " coverage=" plus [[str]](row_total) plus " payloads=" plus [[str]](payload_total)).
            Set ordinal to [[file_docid_ordinal.get]](docid, 0).
            Set scan_index to 0.
            For each candidate in ordered_payloads:
                If scan_index equals ordinal:
                    Set payload_line to candidate.
                Set scan_index to scan_index plus 1.
            If not payload_line:
                Give back [[err]]("ui: viewmodel: " plus gid plus " doc " plus docid plus " region " plus region_id plus " has empty payload").
        Do [[payload_by_docid.update]]({docid: payload_line}).
    Set states_result to [[build_doc_states]](guideline_path, gid, sorted_docids, review_by_docid, manifest_text).
    If [[result_kind]](states_result) equals "err":
        Give back states_result.
    Set states_pair to [[result_value]](states_result).
    Set states_copy to [[list]](states_pair).
    Set doc_states to [[states_copy.pop]](0).
    Set ledger_by_docid to [[states_copy.pop]](0).
    Set ledger_order to [[states_copy.pop]](0).
    Set ledger_file_digest to [[states_copy.pop]](0).
    Set model to {}.
    Do [[model.update]]({"gid": gid}).
    Do [[model.update]]({"path": guideline_path}).
    Do [[model.update]]({"real_path": real_guideline_path}).
    Do [[model.update]]({"corpus_commit": corpus_commit}).
    Set title_result to [[readme_title]](guideline_path, gid).
    If [[result_kind]](title_result) equals "err":
        Give back title_result.
    Do [[model.update]]({"title": [[result_value]](title_result)}).
    Do [[model.update]]({"docids": sorted_docids}).
    Do [[model.update]]({"region_by_docid": region_by_docid}).
    Do [[model.update]]({"section_by_docid": section_by_docid}).
    Do [[model.update]]({"title_by_docid": title_by_docid}).
    Do [[model.update]]({"page_by_docid": page_by_docid}).
    Do [[model.update]]({"file_by_docid": file_by_docid}).
    Set source_names to [[source_assets]](guideline_path).
    Set pdf_names to <>.
    For each name_text in source_names:
        If [[name_text.endswith]](".pdf"):
            Do [[pdf_names.append]](name_text).
    Set pdf_name to "".
    If [[len]](pdf_names) equals 1:
        Set pdf_name to [[pdf_names.pop]](0).
    Do [[model.update]]({"source_names": source_names}).
    Do [[model.update]]({"pdf_name": pdf_name}).
    Do [[model.update]]({"payload_by_docid": payload_by_docid}).
    Do [[model.update]]({"ace_digest_by_docid": ace_digest_by_docid}).
    Do [[model.update]]({"payload_digest_by_docid": payload_digest_by_docid}).
    Do [[model.update]]({"review_by_docid": review_by_docid}).
    Do [[model.update]]({"doc_states": doc_states}).
    Do [[model.update]]({"ledger_by_docid": ledger_by_docid}).
    Do [[model.update]]({"ledger_order": ledger_order}).
    Do [[model.update]]({"ledger_file_digest": ledger_file_digest}).
    Do [[model.update]]({"region_rows": region_rows}).
    Set counts to {}.
    Do [[counts.update]]({"regions": [[len]](coverage_rows)}).
    Do [[counts.update]]({"ace": ace_counter}).
    Do [[counts.update]]({"restates": restates_counter}).
    Do [[counts.update]]({"uncovered": uncovered_counter}).
    Do [[counts.update]]({"pending": pending_counter}).
    Set approved_count to 0.
    Set rejected_count to 0.
    Set contested_count to 0.
    Set stale_count to 0.
    Set unreviewed_count to 0.
    For each docid in sorted_docids:
        Set state to [[doc_states.get]](docid, "unreviewed").
        If state equals "approved":
            Set approved_count to approved_count plus 1.
        Otherwise if state equals "rejected":
            Set rejected_count to rejected_count plus 1.
        Otherwise if state equals "contested":
            Set contested_count to contested_count plus 1.
        Otherwise if state equals "stale":
            Set stale_count to stale_count plus 1.
        Otherwise:
            Set unreviewed_count to unreviewed_count plus 1.
    Do [[counts.update]]({"approved": approved_count}).
    Do [[counts.update]]({"rejected": rejected_count}).
    Do [[counts.update]]({"contested": contested_count}).
    Do [[counts.update]]({"stale": stale_count}).
    Do [[counts.update]]({"unreviewed": unreviewed_count}).
    Do [[counts.update]]({"decisions": [[len]](ledger_order)}).
    Do [[counts.update]]({"reviewed": [[len]](ledger_by_docid)}).
    Do [[model.update]]({"counts": counts}).
    Give back [[ok]](model).

Define [[build_viewmodel]] taking corpus:
    Set root_path to [[corpus.get]]("root", None).
    Set guidelines_root to [[root_path.joinpath]]("guidelines").
    Set root_missing to False.
    Set symlink to [[guidelines_root.is_symlink]]().
    If symlink:
        Set root_missing to True.
    If not [[guidelines_root.is_dir]]():
        Set root_missing to True.
    If root_missing:
        Give back [[err]]("ui: viewmodel: missing guidelines directory").
    Set gids to <>.
    For each entry in [[sorted]]([[guidelines_root.iterdir]]()):
        Set symlink to [[entry.is_symlink]]().
        If not symlink:
            If [[entry.is_dir]]():
                Do [[gids.append]](entry.name).
    Set models to <>.
    For each gid in gids:
        Set model_result to [[build_guideline_model]](corpus, gid).
        If [[result_kind]](model_result) equals "err":
            Give back model_result.
        Do [[models.append]]([[result_value]](model_result)).
    Give back [[ok]](models).

Set hl_stop_words to [[set]](<"a", "an", "the", "every", "each", "no", "all", "some", "any", "this", "that", "these", "those", "such", "is", "are", "was", "were", "be", "been", "being", "has", "have", "had", "does", "do", "did", "should", "must", "may", "can", "cannot", "might", "will", "would", "shall", "could", "if", "then", "and", "or", "nor", "but", "not", "it", "its", "itself", "they", "them", "their", "he", "she", "who", "whom", "whose", "which", "what", "where", "when", "there", "something", "somebody", "someone", "everything", "everybody", "everyone", "nothing", "nobody", "of", "for", "with", "without", "during", "to", "at", "in", "on", "by", "from", "as", "against", "about", "after", "before", "through", "under", "over", "above", "below", "into", "onto", "per", "within", "between", "among", "around", "near", "than", "least", "most", "more", "less", "fewer", "greater">).

Set hl_diacritic_classes to {"a": "[aàáâãäå]", "e": "[eèéêë]", "i": "[iìíîï]", "o": "[oòóôõö]", "u": "[uùúûü]", "n": "[nñ]", "c": "[cç]", "y": "[yýÿ]"}.
Set hl_token_rx to [[re.compile]]("([0-9A-Za-z]+(?:-[0-9A-Za-z]+)*)").
Set hl_word_sep to "[^\\w.!?,;:]+".
Set hl_hover_classes to 32.
Set hl_hue_count to 6.

Define [[hl_bases]] taking word:
    Set out to <word>.
    If [[word.endswith]]("ies"):
        If [[len]](word) is greater than 4:
            Do [[out.append]]([[word.removesuffix]]("ies") plus "y").
    If [[word.endswith]]("es"):
        If [[len]](word) is greater than 3:
            Do [[out.append]]([[word.removesuffix]]("es")).
    If [[word.endswith]]("s"):
        If not [[word.endswith]]("ss"):
            If [[len]](word) is greater than 3:
                Do [[out.append]]([[word.removesuffix]]("s")).
    Give back out.

Define [[hl_variants]] taking word:
    Set found to <>.
    For each base in [[hl_bases]](word):
        For each cand in <base, base plus "s", base plus "es", base plus "ed", base plus "ing">:
            Set known to cand is in found.
            If not known:
                Do [[found.append]](cand).
        If [[base.endswith]]("y"):
            If [[len]](base) is greater than 2:
                Set cand to [[base.removesuffix]]("y") plus "ies".
                Set known to cand is in found.
                If not known:
                    Do [[found.append]](cand).
        If [[base.endswith]]("e"):
            For each cand in <base plus "d", [[base.removesuffix]]("e") plus "ing">:
                Set known to cand is in found.
                If not known:
                    Do [[found.append]](cand).
    Give back found.

Define [[hl_char_pattern]] taking variant:
    Set parts to <>.
    For each ch in variant:
        Do [[parts.append]]([[hl_diacritic_classes.get]](ch, ch)).
    Set empty_text to "".
    Give back [[empty_text.join]](parts).

Define [[hl_word_pattern]] taking word:
    Set alts to <>.
    For each variant in [[hl_variants]](word):
        Do [[alts.append]]([[hl_char_pattern]](variant)).
    Set bar to "|".
    Give back "(?:" plus [[bar.join]](alts) plus ")".

Define [[hl_lemma_pattern]] taking lemma:
    Set word_patterns to <>.
    For each word in [[lemma.split]]("-"):
        If word:
            Do [[word_patterns.append]]([[hl_word_pattern]](word)).
    Set sep to hl_word_sep.
    Give back "\\b" plus [[sep.join]](word_patterns) plus "\\b".

Define [[hl_windows]] taking lemma:
    Set words to <>.
    For each word in [[lemma.split]]("-"):
        If word:
            Do [[words.append]](word).
    Set phrases to <lemma>.
    Set total to [[len]](words).
    Set start to 0.
    For each outer_ignored in words:
        Set width to 2.
        For each inner_ignored in words:
            If width is less than total:
                Set skip_remaining to start.
                Set window_words to <>.
                For each word in words:
                    If skip_remaining is greater than 0:
                        Set skip_remaining to skip_remaining minus 1.
                    Otherwise:
                        If [[len]](window_words) is less than width:
                            Do [[window_words.append]](word).
                If [[len]](window_words) equals width:
                    Set dash to "-".
                    Set phrase to [[dash.join]](window_words).
                    Set known to phrase is in phrases.
                    If not known:
                        Do [[phrases.append]](phrase).
            Set width to width plus 1.
        Set start to start plus 1.
    Give back phrases.

Define [[hl_content_lemmas]] taking ace_text:
    Set lemmas to <>.
    Set is_token to False.
    For each piece in [[hl_token_rx.split]](ace_text):
        If is_token:
            Set folded to [[piece.casefold]]().
            Set stopped to folded is in hl_stop_words.
            If not stopped:
                Set letter_hit to [[re.search]]("[a-z]", folded).
                If letter_hit:
                    Set known to folded is in lemmas.
                    If not known:
                        Do [[lemmas.append]](folded).
        Set is_token to not is_token.
    Give back lemmas.

Define [[hl_alternation_order]] taking lemmas:
    Set rows to <>.
    For each lemma in lemmas:
        Set word_count to [[len]]([[lemma.split]]("-")).
        Do [[rows.append]]([[tuple]](<0 minus word_count, 0 minus [[len]](lemma), lemma>)).
    Set ordered to <>.
    For each row in [[sorted]](rows):
        Set row_copy to [[list]](row).
        Do [[row_copy.pop]](0).
        Do [[row_copy.pop]](0).
        Do [[ordered.append]]([[row_copy.pop]](0)).
    Give back ordered.

Define [[hl_mark_html]] taking text, index:
    Set class_attr to "".
    If index is less than hl_hover_classes:
        Set class_attr to " class=\"t" plus [[str]](index) plus "\"".
    Give back "<mark" plus class_attr plus ">" plus [[esc_text]](text) plus "</mark>".

Define [[hl_ace_html]] taking ace_text, index_by_lemma:
    Set html_parts to <>.
    Set is_token to False.
    For each piece in [[hl_token_rx.split]](ace_text):
        If is_token:
            Set folded to [[piece.casefold]]().
            Set index to [[index_by_lemma.get]](folded, None).
            If index does not equal None:
                Do [[html_parts.append]]([[hl_mark_html]](piece, index)).
            Otherwise if folded is in hl_stop_words:
                Do [[html_parts.append]]("<span class=\"kw\">" plus [[esc_text]](piece) plus "</span>").
            Otherwise:
                Do [[html_parts.append]]([[esc_text]](piece)).
        Otherwise:
            Do [[html_parts.append]]([[esc_text]](piece)).
        Set is_token to not is_token.
    Set empty_text to "".
    Give back [[empty_text.join]](html_parts).

Define [[hl_link_data]] taking ace_text, payload_line:
    Set data to {}.
    Set lemmas to [[hl_content_lemmas]](ace_text).
    If not lemmas:
        Do [[data.update]]({"matched": 0}).
        Do [[data.update]]({"payload_html": [[esc_text]](payload_line)}).
        Do [[data.update]]({"ace_html": [[hl_ace_html]](ace_text, {})}).
        Give back data.
    Set ordered to [[hl_alternation_order]](lemmas).
    Set all_phrases to <>.
    Set single_rx_by_lemma to {}.
    Set window_rx_by_lemma to {}.
    Set bar to "|".
    For each lemma in ordered:
        Set lemma_pattern to [[hl_lemma_pattern]](lemma).
        Do [[single_rx_by_lemma.update]]({lemma: [[re.compile]](lemma_pattern plus "$", re.IGNORECASE)}).
        Set phrases to [[hl_windows]](lemma).
        Set phrase_patterns to <>.
        For each phrase in phrases:
            Do [[phrase_patterns.append]]("(?:" plus [[hl_lemma_pattern]](phrase) plus ")").
            Set known to phrase is in all_phrases.
            If not known:
                Do [[all_phrases.append]](phrase).
        If [[len]](phrases) is greater than 1:
            Do [[window_rx_by_lemma.update]]({lemma: [[re.compile]]("(?:" plus [[bar.join]](phrase_patterns) plus ")$", re.IGNORECASE)}).
    Set alternation_parts to <>.
    For each phrase in [[hl_alternation_order]](all_phrases):
        Do [[alternation_parts.append]]("(?:" plus [[hl_lemma_pattern]](phrase) plus ")").
    Set combined_rx to [[re.compile]]("(" plus [[bar.join]](alternation_parts) plus ")", re.IGNORECASE).
    Set pieces to [[combined_rx.split]](payload_line).
    Set hit_lemmas to <>.
    Set matched_lemmas to <>.
    Set is_hit to False.
    For each piece in pieces:
        If is_hit:
            Set piece_lemma to "".
            For each lemma in ordered:
                If not piece_lemma:
                    Set single_rx to [[single_rx_by_lemma.get]](lemma, None).
                    Set hit to [[single_rx.match]](piece).
                    If hit:
                        Set piece_lemma to lemma.
            If not piece_lemma:
                For each lemma in ordered:
                    If not piece_lemma:
                        Set window_rx to [[window_rx_by_lemma.get]](lemma, None).
                        If window_rx does not equal None:
                            Set hit to [[window_rx.match]](piece).
                            If hit:
                                Set piece_lemma to lemma.
            Do [[hit_lemmas.append]](piece_lemma).
            If piece_lemma:
                Set known to piece_lemma is in matched_lemmas.
                If not known:
                    Do [[matched_lemmas.append]](piece_lemma).
        Set is_hit to not is_hit.
    Set index_by_lemma to {}.
    For each lemma in lemmas:
        Set present to lemma is in matched_lemmas.
        If present:
            Do [[index_by_lemma.update]]({lemma: [[len]](index_by_lemma)}).
    Set html_parts to <>.
    Set hit_queue to [[list]](hit_lemmas).
    Set is_hit to False.
    For each piece in pieces:
        If is_hit:
            Set piece_lemma to [[hit_queue.pop]](0).
            If piece_lemma:
                Do [[html_parts.append]]([[hl_mark_html]](piece, [[index_by_lemma.get]](piece_lemma, 0))).
            Otherwise:
                Do [[html_parts.append]]([[esc_text]](piece)).
        Otherwise:
            Do [[html_parts.append]]([[esc_text]](piece)).
        Set is_hit to not is_hit.
    Set empty_text to "".
    Do [[data.update]]({"matched": [[len]](matched_lemmas)}).
    Do [[data.update]]({"payload_html": [[empty_text.join]](html_parts)}).
    Do [[data.update]]({"ace_html": [[hl_ace_html]](ace_text, index_by_lemma)}).
    Give back data.

Set palette to {"body": <"#111827", "#ffffff">, "link": <"#1d4ed8", "#ffffff">, "muted": <"#4b5563", "#ffffff">, "chip-approved": <"#14532d", "#dcfce7">, "chip-rejected": <"#7f1d1d", "#fee2e2">, "chip-contested": <"#4c1d95", "#ede9fe">, "chip-stale": <"#78350f", "#fef3c7">, "chip-unreviewed": <"#1f2937", "#e5e7eb">, "mark-0": <"#111827", "#dbeafe">, "mark-active-0": <"#111827", "#bfdbfe">, "mark-1": <"#111827", "#fef9c3">, "mark-active-1": <"#111827", "#fef08a">, "mark-2": <"#111827", "#f3e8ff">, "mark-active-2": <"#111827", "#e9d5ff">, "mark-3": <"#111827", "#ffedd5">, "mark-active-3": <"#111827", "#fed7aa">, "mark-4": <"#111827", "#ccfbf1">, "mark-active-4": <"#111827", "#99f6e4">, "mark-5": <"#111827", "#ffe4e6">, "mark-active-5": <"#111827", "#fecdd3">}.

Define [[pal_fg]] taking role:
    Set pair to [[palette.get]](role, <>).
    Set pair_copy to [[list]](pair).
    Give back [[pair_copy.pop]](0).

Define [[pal_bg]] taking role:
    Set pair to [[palette.get]](role, <>).
    Set pair_copy to [[list]](pair).
    Do [[pair_copy.pop]](0).
    Give back [[pair_copy.pop]](0).

Define [[build_css]] taking nothing:
    Set body_fg to [[pal_fg]]("body").
    Set body_bg to [[pal_bg]]("body").
    Set link_fg to [[pal_fg]]("link").
    Set line_color to [[pal_bg]]("chip-unreviewed").
    Set lines to <>.
    Do [[lines.append]]("body { margin: 0 auto; max-width: 72rem; padding: 0 1.5rem 4rem; font-family: system-ui, sans-serif; line-height: 1.55; color: " plus body_fg plus "; background: " plus body_bg plus "; }").
    Do [[lines.append]]("a { color: " plus link_fg plus "; }").
    Do [[lines.append]]("a:focus-visible, summary:focus-visible { outline: 3px solid " plus link_fg plus "; outline-offset: 2px; }").
    Do [[lines.append]](".skip { position: absolute; left: -999px; top: 0; padding: 0.5rem 1rem; background: " plus body_bg plus "; color: " plus link_fg plus "; }").
    Do [[lines.append]](".skip:focus { left: 0; z-index: 1; }").
    Do [[lines.append]]("nav.crumbs { padding: 1rem 0; border-bottom: 1px solid " plus line_color plus "; }").
    Do [[lines.append]]("h1 { font-size: 1.5rem; }").
    Do [[lines.append]]("h2 { font-size: 1.25rem; }").
    Do [[lines.append]]("h3 { font-size: 1.05rem; }").
    Do [[lines.append]]("h1 a.source { font-size: 1rem; font-weight: 400; margin-left: 0.5rem; }").
    Do [[lines.append]]("table { border-collapse: collapse; width: 100%; margin: 1rem 0; }").
    Do [[lines.append]]("th, td { text-align: left; padding: 0.4rem 0.6rem; border-bottom: 1px solid " plus line_color plus "; vertical-align: top; }").
    Do [[lines.append]]("th { border-bottom: 2px solid " plus body_fg plus "; }").
    Do [[lines.append]]("table.compact { width: auto; }").
    Do [[lines.append]]("table.compact th, table.compact td { padding-right: 2rem; }").
    Do [[lines.append]]("table.records { table-layout: fixed; }").
    Do [[lines.append]]("table.records th { box-sizing: border-box; }").
    Do [[lines.append]]("table.records th:nth-child(1) { width: 12%; }").
    Do [[lines.append]]("table.records th:nth-child(2) { width: 18%; }").
    Do [[lines.append]]("table.records th:nth-child(3) { width: 22%; }").
    Do [[lines.append]]("table.records th:nth-child(4) { width: 10%; }").
    Do [[lines.append]](".chip { display: inline-block; padding: 0.1rem 0.6rem; border-radius: 999px; font-size: 0.85rem; font-weight: 600; }").
    Do [[lines.append]](".chip-approved { color: " plus [[pal_fg]]("chip-approved") plus "; background: " plus [[pal_bg]]("chip-approved") plus "; }").
    Do [[lines.append]](".chip-rejected { color: " plus [[pal_fg]]("chip-rejected") plus "; background: " plus [[pal_bg]]("chip-rejected") plus "; }").
    Do [[lines.append]](".chip-contested { color: " plus [[pal_fg]]("chip-contested") plus "; background: " plus [[pal_bg]]("chip-contested") plus "; }").
    Do [[lines.append]](".chip-stale { color: " plus [[pal_fg]]("chip-stale") plus "; background: " plus [[pal_bg]]("chip-stale") plus "; }").
    Do [[lines.append]](".chip-unreviewed { color: " plus [[pal_fg]]("chip-unreviewed") plus "; background: " plus [[pal_bg]]("chip-unreviewed") plus "; }").
    Do [[lines.append]]("pre { padding: 0.75rem 1rem; border: 1px solid " plus line_color plus "; white-space: pre-wrap; overflow-x: auto; }").
    Do [[lines.append]]("pre, code { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 0.95rem; }").
    Do [[lines.append]]("pre.prose { font-family: Georgia, serif; font-size: 1.05rem; overflow-wrap: anywhere; }").
    Do [[lines.append]]("dt { font-weight: 600; margin-top: 0.6rem; }").
    Do [[lines.append]]("dd { margin-left: 0; }").
    Do [[lines.append]]("summary { cursor: pointer; }").
    Do [[lines.append]]("section { margin: 1.5rem 0; }").
    Do [[lines.append]]("nav.docnav { padding: 1rem 0; border-top: 1px solid " plus line_color plus "; }").
    Do [[lines.append]]("footer.scope { margin-top: 2rem; padding: 1rem 0; border-top: 1px solid " plus line_color plus "; font-size: 0.9rem; }").
    Do [[lines.append]]("form label { display: block; margin-top: 1rem; font-weight: 600; }").
    Do [[lines.append]]("fieldset { border: 0; margin: 1rem 0 0; padding: 0; max-width: 28rem; }").
    Do [[lines.append]]("legend { font-weight: 600; padding: 0; }").
    Do [[lines.append]]("fieldset label { margin-top: 0.5rem; font-weight: 400; }").
    Do [[lines.append]]("input[type=\"text\"], textarea { display: block; box-sizing: border-box; width: 100%; max-width: 28rem; margin-top: 0.3rem; padding: 0.45rem 0.6rem; border: 1px solid " plus line_color plus "; font-family: inherit; font-size: 1rem; color: " plus body_fg plus "; background: " plus body_bg plus "; }").
    Do [[lines.append]]("textarea { min-height: 6rem; }").
    Do [[lines.append]]("input[type=\"radio\"] { accent-color: " plus body_fg plus "; }").
    Do [[lines.append]]("input[type=\"text\"]:focus-visible, input[type=\"radio\"]:focus-visible, textarea:focus-visible, button:focus-visible { outline: 3px solid " plus link_fg plus "; outline-offset: 2px; }").
    Do [[lines.append]]("button { margin-top: 1.25rem; padding: 0.5rem 1.2rem; border: 1px solid " plus body_fg plus "; font-family: inherit; font-size: 1rem; font-weight: 600; color: " plus body_bg plus "; background: " plus body_fg plus "; }").
    Set muted_fg to [[pal_fg]]("muted").
    Set mark_bg to [[pal_bg]]("mark-0").
    Do [[lines.append]]("mark { background: " plus mark_bg plus "; color: inherit; text-decoration: underline dotted " plus muted_fg plus "; text-underline-offset: 0.15em; }").
    Do [[lines.append]](".kw { color: " plus muted_fg plus "; }").
    Do [[lines.append]](".hl-note { color: " plus muted_fg plus "; font-size: 0.9rem; }").
    Set hue to 0.
    For each hue_ignored in [[range]](hl_hue_count):
        If hue is greater than 0:
            Set selector_parts to <>.
            Set class_index to hue.
            For each step_ignored in [[range]](hl_hover_classes):
                If class_index is less than hl_hover_classes:
                    Do [[selector_parts.append]]("mark.t" plus [[str]](class_index)).
                Set class_index to class_index plus hl_hue_count.
            Set comma to ", ".
            Do [[lines.append]]([[comma.join]](selector_parts) plus " { background: " plus [[pal_bg]]("mark-" plus [[str]](hue)) plus "; }").
        Set hue to hue plus 1.
    Set hue to 0.
    For each hover_index in [[range]](hl_hover_classes):
        Set class_name to "t" plus [[str]](hover_index).
        Do [[lines.append]]("main:has(mark." plus class_name plus ":hover) mark." plus class_name plus " { background: " plus [[pal_bg]]("mark-active-" plus [[str]](hue)) plus "; text-decoration-style: solid; }").
        Set hue to hue plus 1.
        If hue equals hl_hue_count:
            Set hue to 0.
    Do [[lines.append]]("@media print {").
    Do [[lines.append]]("body { max-width: none; padding: 0; }").
    Do [[lines.append]]("nav.crumbs, nav.docnav, .skip, form, .verdict-entry, .hl-note { display: none; }").
    Do [[lines.append]]("mark, mark[class] { background: none; }").
    Do [[lines.append]]("details::details-content { content-visibility: visible; }").
    Do [[lines.append]]("pre { border: none; padding: 0; white-space: pre-wrap; overflow-x: visible; }").
    Do [[lines.append]]("a { color: inherit; text-decoration: none; }").
    Do [[lines.append]](".chip { border: 1px solid " plus body_fg plus "; background: none; color: inherit; }").
    Do [[lines.append]]("}").
    Set joiner to "\n".
    Give back [[joiner.join]](lines).

Set css_text to [[build_css]]().

Set scope_line_text to "This page reports what the loaded guideline documents state. It does not give clinical advice.".

Set hl_note_text to "Phrases that appear in both texts are highlighted. A phrase and its matches share one color. Point at a highlighted phrase to emphasize it and its matches.".

Set refusal_refused_text to "The request was refused. Open the document page again from this site and submit the decision again.".
Set refusal_invalid_form_text to "The submitted form was not valid. Go back to the document page, reload it, and submit the decision again.".
Set refusal_subject_text to "The document or its source changed after this page was loaded. The decision was not recorded. Open the document page again and check the current version.".
Set refusal_ledger_text to "Another decision was recorded for this guideline before this one. The decision was not recorded. Open the document page again and check the current state.".

Define [[comment_safe]] taking detail:
    Set safe_chars to <>.
    For each ch in detail:
        Set keep to False.
        If [[ch.isascii]]():
            If [[ch.isalnum]]():
                Set keep to True.
        If ch equals " ":
            Set keep to True.
        If ch equals ":":
            Set keep to True.
        If ch equals "_":
            Set keep to True.
        If ch equals ".":
            Set keep to True.
        If keep:
            Do [[safe_chars.append]](ch).
        Otherwise:
            Do [[safe_chars.append]]("_").
    Set empty_text to "".
    Give back [[empty_text.join]](safe_chars).

Define [[page_html]] taking title_text, crumb_html, body_html:
    Set parts to <>.
    Do [[parts.append]]("<!doctype html>").
    Do [[parts.append]]("<html lang=\"en\">").
    Do [[parts.append]]("<head>").
    Do [[parts.append]]("<meta charset=\"utf-8\">").
    Do [[parts.append]]("<title>" plus [[esc_text]](title_text) plus " — cnl-ckc reviewer</title>").
    Do [[parts.append]]("<style>").
    Do [[parts.append]](css_text).
    Do [[parts.append]]("</style>").
    Do [[parts.append]]("</head>").
    Do [[parts.append]]("<body>").
    Do [[parts.append]]("<a class=\"skip\" href=\"#main\">Skip to content</a>").
    Do [[parts.append]]("<nav class=\"crumbs\">" plus crumb_html plus "</nav>").
    Do [[parts.append]]("<main id=\"main\">").
    Do [[parts.append]](body_html).
    Do [[parts.append]]("</main>").
    Do [[parts.append]]("<footer class=\"scope\"><p>" plus [[esc_text]](scope_line_text) plus "</p></footer>").
    Do [[parts.append]]("</body>").
    Do [[parts.append]]("</html>").
    Set joiner to "\n".
    Give back [[joiner.join]](parts) plus "\n".

Define [[state_label]] taking state:
    If state equals "stale":
        Give back "Outdated".
    Give back [[state.capitalize]]().

Define [[chip_html]] taking state:
    Give back "<span class=\"chip chip-" plus state plus "\">" plus [[state_label]](state) plus "</span>".

Define [[reviewer_roster]] taking ledger_order:
    Set names to <>.
    Set latest_date to "".
    Set latest_name to "".
    For each row in ledger_order:
        Set fields_copy to [[list]](row).
        Do [[fields_copy.pop]](0).
        Do [[fields_copy.pop]](0).
        Do [[fields_copy.pop]](0).
        Do [[fields_copy.pop]](0).
        Set name_text to [[fields_copy.pop]](0).
        Set date_text to [[fields_copy.pop]](0).
        If name_text:
            Set known to name_text is in names.
            If not known:
                Do [[names.append]](name_text).
            Set older to date_text is less than latest_date.
            If not older:
                Set latest_date to date_text.
                Set latest_name to name_text.
    Give back <[[sorted]](names), latest_name>.

Define [[datalist_html]] taking names:
    Set option_parts to <>.
    For each name_text in names:
        Do [[option_parts.append]]("<option value=\"" plus [[esc_attr]](name_text) plus "\"></option>").
    Set option_joiner to "".
    Give back "<datalist id=\"reviewer-names\">" plus [[option_joiner.join]](option_parts) plus "</datalist>".

Define [[doc_tally]] taking ledger_by_docid, docid:
    Set approved_count to 0.
    Set rejected_count to 0.
    Set earlier_count to 0.
    For each row in [[ledger_by_docid.get]](docid, <>):
        Set row_copy to [[list]](row).
        Do [[row_copy.pop]](0).
        Do [[row_copy.pop]](0).
        Set verdict to [[row_copy.pop]](0).
        Do [[row_copy.pop]](0).
        Do [[row_copy.pop]](0).
        Do [[row_copy.pop]](0).
        Set current to [[row_copy.pop]](0).
        If current:
            If verdict equals "approved":
                Set approved_count to approved_count plus 1.
            Otherwise:
                Set rejected_count to rejected_count plus 1.
        Otherwise:
            Set earlier_count to earlier_count plus 1.
    Give back <approved_count, rejected_count, earlier_count>.

Define [[tally_text]] taking tally:
    Set tally_copy to [[list]](tally).
    Set approved_count to [[tally_copy.pop]](0).
    Set rejected_count to [[tally_copy.pop]](0).
    Set earlier_count to [[tally_copy.pop]](0).
    Set current_parts to <>.
    If approved_count is greater than 0:
        Do [[current_parts.append]]([[str]](approved_count) plus " approved").
    If rejected_count is greater than 0:
        Do [[current_parts.append]]([[str]](rejected_count) plus " rejected").
    Set sentences to <>.
    If current_parts:
        Set part_joiner to " and ".
        Do [[sentences.append]]("Decisions on this version: " plus [[part_joiner.join]](current_parts) plus ".").
    Otherwise if earlier_count is greater than 0:
        Do [[sentences.append]]("No decision is recorded on this version.").
    Otherwise:
        Do [[sentences.append]]("No decision is recorded.").
    If earlier_count is greater than 0:
        Do [[sentences.append]]("Decisions on earlier versions: " plus [[str]](earlier_count) plus ".").
    Set joiner to " ".
    Give back [[joiner.join]](sentences).

Define [[tally_cell]] taking tally:
    Set tally_copy to [[list]](tally).
    Set approved_count to [[tally_copy.pop]](0).
    Set rejected_count to [[tally_copy.pop]](0).
    Set earlier_count to [[tally_copy.pop]](0).
    Set parts to <>.
    If approved_count is greater than 0:
        Do [[parts.append]]([[str]](approved_count) plus " approved").
    If rejected_count is greater than 0:
        Do [[parts.append]]([[str]](rejected_count) plus " rejected").
    If earlier_count is greater than 0:
        Do [[parts.append]]([[str]](earlier_count) plus " earlier").
    If not parts:
        Give back "None".
    Set joiner to ", ".
    Give back [[joiner.join]](parts).

Define [[review_summary_text]] taking counts, doc_total:
    Set decision_count to [[counts.get]]("decisions", 0).
    If decision_count equals 0:
        Give back "No decisions are recorded for the " plus [[str]](doc_total) plus " documents in this guideline.".
    Set reviewed_count to [[counts.get]]("reviewed", 0).
    Give back "Reviewers recorded " plus [[str]](decision_count) plus " decisions on " plus [[str]](reviewed_count) plus " of " plus [[str]](doc_total) plus " documents.".

Define [[build_index_page]] taking models:
    Set rows to <>.
    For each model in models:
        Set gid to [[model.get]]("gid", "").
        Set counts to [[model.get]]("counts", {}).
        Set docids to [[model.get]]("docids", <>).
        Set cells to <>.
        Do [[cells.append]]("<td><a href=\"g/" plus [[url_seg]](gid) plus "/index.html\">" plus [[esc_text]]([[model.get]]("title", gid)) plus "</a></td>").
        Do [[cells.append]]("<td>" plus [[str]]([[len]](docids)) plus "</td>").
        Do [[cells.append]]("<td>" plus [[str]]([[counts.get]]("regions", 0)) plus "</td>").
        Do [[cells.append]]("<td>" plus [[str]]([[counts.get]]("approved", 0)) plus "</td>").
        Do [[cells.append]]("<td>" plus [[str]]([[counts.get]]("rejected", 0)) plus "</td>").
        Do [[cells.append]]("<td>" plus [[str]]([[counts.get]]("contested", 0)) plus "</td>").
        Do [[cells.append]]("<td>" plus [[str]]([[counts.get]]("stale", 0)) plus "</td>").
        Do [[cells.append]]("<td>" plus [[str]]([[counts.get]]("unreviewed", 0)) plus "</td>").
        Set empty_text to "".
        Do [[rows.append]]("<tr>" plus [[empty_text.join]](cells) plus "</tr>").
    Set parts to <>.
    Do [[parts.append]]("<h1>Guidelines</h1>").
    Do [[parts.append]]("<section>").
    Do [[parts.append]]("<table>").
    Do [[parts.append]]("<thead><tr><th>Guideline</th><th>Documents</th><th>Passages</th><th>Approved</th><th>Rejected</th><th>Contested</th><th>Outdated</th><th>Unreviewed</th></tr></thead>").
    Set joiner to "\n".
    Do [[parts.append]]("<tbody>" plus [[joiner.join]](rows) plus "</tbody>").
    Do [[parts.append]]("</table>").
    Do [[parts.append]]("</section>").
    Set body_html to [[joiner.join]](parts).
    Give back [[page_html]]("Guidelines", "cnl-ckc reviewer", body_html).

Define [[build_guideline_page]] taking model:
    Set gid to [[model.get]]("gid", "").
    Set counts to [[model.get]]("counts", {}).
    Set docids to [[model.get]]("docids", <>).
    Set doc_states to [[model.get]]("doc_states", {}).
    Set region_by_docid to [[model.get]]("region_by_docid", {}).
    Set title_by_docid to [[model.get]]("title_by_docid", {}).
    Set region_rows to [[model.get]]("region_rows", <>).
    Set joiner to "\n".
    Set empty_text to "".
    Set parts to <>.
    Set ledger_by_docid to [[model.get]]("ledger_by_docid", {}).
    Do [[parts.append]]("<h1>" plus [[esc_text]]([[model.get]]("title", gid)) plus "</h1>").
    Do [[parts.append]]("<p>" plus [[esc_text]]([[review_summary_text]](counts, [[len]](docids))) plus " <a href=\"records.html\">All decision records</a></p>").
    Do [[parts.append]]("<section>").
    Do [[parts.append]]("<h2>Status</h2>").
    Do [[parts.append]]("<table class=\"compact\">").
    Do [[parts.append]]("<thead><tr><th>Status</th><th>Count</th></tr></thead>").
    Set status_rows to <>.
    Set status_labels to <<"Passages", "regions">, <"With ACE", "ace">, <"Pending", "pending">, <"Approved", "approved">, <"Rejected", "rejected">, <"Contested", "contested">, <"Outdated", "stale">, <"Unreviewed", "unreviewed">>.
    For each label_pair in status_labels:
        Set pair_copy to [[list]](label_pair).
        Set label_text to [[pair_copy.pop]](0).
        Set count_key to [[pair_copy.pop]](0).
        Do [[status_rows.append]]("<tr><td>" plus label_text plus "</td><td>" plus [[str]]([[counts.get]](count_key, 0)) plus "</td></tr>").
    Do [[parts.append]]("<tbody>" plus [[joiner.join]](status_rows) plus "</tbody>").
    Do [[parts.append]]("</table>").
    Do [[parts.append]]("</section>").
    Do [[parts.append]]("<section>").
    Do [[parts.append]]("<h2>Documents</h2>").
    Do [[parts.append]]("<table class=\"compact\">").
    Do [[parts.append]]("<thead><tr><th>Document</th><th>Status</th><th>Decisions</th><th>Passage</th></tr></thead>").
    Set doc_rows to <>.
    For each docid in docids:
        Set state to [[doc_states.get]](docid, "unreviewed").
        Set cells to <>.
        Do [[cells.append]]("<td><a href=\"doc/" plus [[url_seg]](docid) plus ".html\">" plus [[esc_text]]([[title_by_docid.get]](docid, docid)) plus "</a></td>").
        Do [[cells.append]]("<td>" plus [[chip_html]](state) plus "</td>").
        Do [[cells.append]]("<td>" plus [[esc_text]]([[tally_cell]]([[doc_tally]](ledger_by_docid, docid))) plus "</td>").
        Do [[cells.append]]("<td>" plus [[esc_text]]([[region_by_docid.get]](docid, "")) plus "</td>").
        Do [[doc_rows.append]]("<tr>" plus [[empty_text.join]](cells) plus "</tr>").
    Do [[parts.append]]("<tbody>" plus [[joiner.join]](doc_rows) plus "</tbody>").
    Do [[parts.append]]("</table>").
    Do [[parts.append]]("</section>").
    Do [[parts.append]]("<section>").
    Do [[parts.append]]("<h2>Passages without ACE</h2>").
    Do [[parts.append]]("<table class=\"compact\">").
    Do [[parts.append]]("<thead><tr><th>Passage</th><th>Status</th><th>Section</th></tr></thead>").
    Set other_rows to <>.
    For each region_row in region_rows:
        Set row_copy to [[list]](region_row).
        Set region_id to [[row_copy.pop]](0).
        Set status_text to [[row_copy.pop]](0).
        Set section_text to [[row_copy.pop]](0).
        Set cells to <>.
        Do [[cells.append]]("<td>" plus [[esc_text]](region_id) plus "</td>").
        Do [[cells.append]]("<td>" plus [[esc_text]](status_text) plus "</td>").
        Do [[cells.append]]("<td>" plus [[esc_text]](section_text) plus "</td>").
        Do [[other_rows.append]]("<tr>" plus [[empty_text.join]](cells) plus "</tr>").
    Do [[parts.append]]("<tbody>" plus [[joiner.join]](other_rows) plus "</tbody>").
    Do [[parts.append]]("</table>").
    Do [[parts.append]]("</section>").
    Set body_html to [[joiner.join]](parts).
    Set title_text to [[model.get]]("title", gid).
    Set crumb_html to "<a href=\"../../index.html\">guidelines</a> / " plus [[esc_text]](title_text).
    Give back [[page_html]](title_text, crumb_html, body_html).

Define [[doc_render_data]] taking model, docid:
    Set gid to [[model.get]]("gid", "").
    Set guideline_path to [[model.get]]("path", None).
    Set ace_digest_by_docid to [[model.get]]("ace_digest_by_docid", {}).
    Set payload_digest_by_docid to [[model.get]]("payload_digest_by_docid", {}).
    Set payload_by_docid to [[model.get]]("payload_by_docid", {}).
    Set ace_path to [[guideline_path.joinpath]]("ace", docid plus ".ace").
    Try:
        Set ace_bytes to [[ace_path.read_bytes]]().
    Catch OSError:
        Give back [[err]]("ui: viewmodel: " plus gid plus " doc " plus docid plus " missing ace file").
    Set ace_text to "".
    Try:
        Set ace_text to [[ace_bytes.decode]]("utf-8").
    Catch UnicodeDecodeError:
        Give back [[err]]("ui: viewmodel: " plus gid plus " file not UTF-8: ace/" plus docid plus ".ace").
    Set control_detail to [[control_violation]](ace_text, gid, "ace/" plus docid plus ".ace").
    If control_detail:
        Give back [[err]](control_detail).
    Set ace_actual to [[sha256_hex]](ace_bytes).
    If ace_actual does not equal [[ace_digest_by_docid.get]](docid, ""):
        Give back [[err]]("ui: digest mismatch: " plus docid plus " ace").
    Set payload_line to [[payload_by_docid.get]](docid, "").
    Set payload_bytes to [[payload_line.encode]]("utf-8").
    Set payload_actual to [[sha256_hex]](payload_bytes).
    If payload_actual does not equal [[payload_digest_by_docid.get]](docid, ""):
        Give back [[err]]("ui: digest mismatch: " plus docid plus " payload").
    Set pl_path to [[guideline_path.joinpath]]("pl", docid plus ".pl").
    Set pl_result to [[load_text]](pl_path, gid, "pl/" plus docid plus ".pl").
    If [[result_kind]](pl_result) equals "err":
        Give back pl_result.
    Set pl_text to [[result_value]](pl_result).
    Set data to {}.
    Do [[data.update]]({"ace_text": ace_text}).
    Do [[data.update]]({"pl_text": pl_text}).
    Do [[data.update]]({"pl_lines": [[len]]([[pl_text.splitlines]]())}).
    Give back [[ok]](data).

Define [[build_doc_page]] taking model, docid, doc_data, prev_id, next_id:
    Set gid to [[model.get]]("gid", "").
    Set doc_states to [[model.get]]("doc_states", {}).
    Set state to [[doc_states.get]](docid, "unreviewed").
    Set region_by_docid to [[model.get]]("region_by_docid", {}).
    Set title_by_docid to [[model.get]]("title_by_docid", {}).
    Set file_by_docid to [[model.get]]("file_by_docid", {}).
    Set payload_by_docid to [[model.get]]("payload_by_docid", {}).
    Set source_names to [[model.get]]("source_names", <>).
    Set pdf_name to [[model.get]]("pdf_name", "").
    Set guideline_title to [[model.get]]("title", gid).
    Set doc_title to [[title_by_docid.get]](docid, docid).
    Set joiner to "\n".
    Set parts to <>.
    Set head_html to [[esc_text]](guideline_title).
    If pdf_name:
        Set head_html to head_html plus " <a class=\"source\" href=\"../source/" plus [[url_seg]](pdf_name) plus "\">PDF</a>".
    Do [[parts.append]]("<h1>" plus head_html plus "</h1>").
    Do [[parts.append]]("<h2>" plus [[esc_text]](doc_title) plus " " plus [[chip_html]](state) plus "</h2>").
    Set file_name to [[file_by_docid.get]](docid, "").
    Set base_name to [[file_name.removeprefix]]("source/").
    Set published to base_name is in source_names.
    Set region_text to [[region_by_docid.get]](docid, "").
    Set prov_parts to <>.
    If region_text:
        Do [[prov_parts.append]]([[esc_text]](region_text)).
    If published:
        Do [[prov_parts.append]]("<a href=\"../source/" plus [[url_seg]](base_name) plus "\">Source text</a>").
    If prov_parts:
        Set prov_joiner to " · ".
        Do [[parts.append]]("<p>" plus [[prov_joiner.join]](prov_parts) plus "</p>").
    Set ledger_by_docid to [[model.get]]("ledger_by_docid", {}).
    Set records_href to "../records.html".
    Set has_history to docid is in ledger_by_docid.
    If has_history:
        Set records_href to records_href plus "#" plus [[url_seg]](docid).
    Set tally to [[doc_tally]](ledger_by_docid, docid).
    Do [[parts.append]]("<p>" plus [[esc_text]]([[tally_text]](tally)) plus " <a href=\"" plus records_href plus "\">All decision records</a></p>").
    If state equals "stale":
        Do [[parts.append]]("<section class=\"stale\">").
        Do [[parts.append]]("<p>The document or its source changed after the last decision. No recorded decision applies to the version shown here.</p>").
        Do [[parts.append]]("</section>").
    Set link_data to [[hl_link_data]]([[doc_data.get]]("ace_text", ""), [[payload_by_docid.get]](docid, "")).
    If [[link_data.get]]("matched", 0) is greater than 0:
        Do [[parts.append]]("<p class=\"hl-note\">" plus [[esc_text]](hl_note_text) plus "</p>").
    Do [[parts.append]]("<section>").
    Do [[parts.append]]("<h3>Original passage</h3>").
    Do [[parts.append]]("<pre class=\"prose\">" plus [[link_data.get]]("payload_html", "") plus "</pre>").
    Do [[parts.append]]("</section>").
    Do [[parts.append]]("<section>").
    Do [[parts.append]]("<h3>Attempto Controlled English (ACE)</h3>").
    Do [[parts.append]]("<pre class=\"prose\">" plus [[link_data.get]]("ace_html", "") plus "</pre>").
    Do [[parts.append]]("</section>").
    Set review_by_docid to [[model.get]]("review_by_docid", {}).
    Set current_digest to [[review_by_docid.get]](docid, "").
    Set ledger_file_digest to [[model.get]]("ledger_file_digest", "absent").
    Set token_text to [[serve_config.get]]("token", "").
    Set roster to [[reviewer_roster]]([[model.get]]("ledger_order", <>)).
    Set roster_copy to [[list]](roster).
    Set reviewer_names to [[roster_copy.pop]](0).
    Set default_reviewer to [[roster_copy.pop]](0).
    Do [[parts.append]]("<section class=\"verdict-entry\">").
    Do [[parts.append]]("<h3>Record a decision</h3>").
    Do [[parts.append]]("<p>Does the ACE representation appropriately reflect the original passage?</p>").
    Do [[parts.append]]("<form method=\"post\">").
    Do [[parts.append]]("<fieldset>").
    Do [[parts.append]]("<legend>Decision</legend>").
    Do [[parts.append]]("<label><input type=\"radio\" name=\"verdict\" value=\"approved\" required> Approved</label>").
    Do [[parts.append]]("<label><input type=\"radio\" name=\"verdict\" value=\"rejected\" required> Rejected</label>").
    Do [[parts.append]]("</fieldset>").
    Do [[parts.append]]("<label for=\"reviewer\">Reviewer name</label>").
    Do [[parts.append]]("<input type=\"text\" id=\"reviewer\" name=\"reviewer\" list=\"reviewer-names\" value=\"" plus [[esc_attr]](default_reviewer) plus "\" required>").
    Do [[parts.append]]([[datalist_html]](reviewer_names)).
    Do [[parts.append]]("<label for=\"comment\">Comment (optional)</label>").
    Do [[parts.append]]("<textarea id=\"comment\" name=\"comment\"></textarea>").
    Do [[parts.append]]("<input type=\"hidden\" name=\"review_sha256\" value=\"" plus [[esc_attr]](current_digest) plus "\">").
    Do [[parts.append]]("<input type=\"hidden\" name=\"ledger_sha256\" value=\"" plus [[esc_attr]](ledger_file_digest) plus "\">").
    Do [[parts.append]]("<input type=\"hidden\" name=\"csrf\" value=\"" plus [[esc_attr]](token_text) plus "\">").
    Do [[parts.append]]("<button>Record decision</button>").
    Do [[parts.append]]("</form>").
    Do [[parts.append]]("</section>").
    Do [[parts.append]]("<section>").
    Do [[parts.append]]("<details>").
    Do [[parts.append]]("<summary>Compiled Prolog (" plus [[str]]([[doc_data.get]]("pl_lines", 0)) plus " lines)</summary>").
    Do [[parts.append]]("<pre>" plus [[esc_text]]([[doc_data.get]]("pl_text", "")) plus "</pre>").
    Do [[parts.append]]("</details>").
    Do [[parts.append]]("</section>").
    Set nav_parts to <>.
    If prev_id:
        Do [[nav_parts.append]]("<a href=\"" plus [[url_seg]](prev_id) plus ".html\">Previous document</a>").
    Do [[nav_parts.append]]("<a href=\"../index.html\">Guideline index</a>").
    If next_id:
        Do [[nav_parts.append]]("<a href=\"" plus [[url_seg]](next_id) plus ".html\">Next document</a>").
    Set nav_joiner to " · ".
    Do [[parts.append]]("<nav class=\"docnav\">" plus [[nav_joiner.join]](nav_parts) plus "</nav>").
    Set body_html to [[joiner.join]](parts).
    Set crumb_html to "<a href=\"../../../index.html\">guidelines</a> / <a href=\"../index.html\">" plus [[esc_text]](guideline_title) plus "</a> / " plus [[esc_text]]([[region_by_docid.get]](docid, docid)).
    Give back [[page_html]](doc_title, crumb_html, body_html).

Define [[build_records_page]] taking model:
    Set gid to [[model.get]]("gid", "").
    Set docids to [[model.get]]("docids", <>).
    Set counts to [[model.get]]("counts", {}).
    Set title_by_docid to [[model.get]]("title_by_docid", {}).
    Set ledger_by_docid to [[model.get]]("ledger_by_docid", {}).
    Set joiner to "\n".
    Set empty_text to "".
    Set parts to <>.
    Do [[parts.append]]("<h1>Decision records</h1>").
    Set summary_text to [[review_summary_text]](counts, [[len]](docids)).
    If [[counts.get]]("decisions", 0) is greater than 0:
        Set summary_text to summary_text plus " The newest decision for each document is first.".
    Do [[parts.append]]("<p>" plus [[esc_text]](summary_text) plus "</p>").
    Set section_count to 0.
    Set link_count to 0.
    For each docid in docids:
        Set history to [[ledger_by_docid.get]](docid, <>).
        If history:
            Set section_count to section_count plus 1.
            Set newest_first to [[list]](history).
            Do [[newest_first.reverse]]().
            Do [[parts.append]]("<section id=\"" plus [[esc_attr]](docid) plus "\">").
            Do [[parts.append]]("<h2><a href=\"doc/" plus [[url_seg]](docid) plus ".html\">" plus [[esc_text]]([[title_by_docid.get]](docid, docid)) plus "</a></h2>").
            Do [[parts.append]]("<table class=\"records\">").
            Do [[parts.append]]("<thead><tr><th>Decision</th><th>Reviewer</th><th>Date</th><th>Version</th><th>Comment</th></tr></thead>").
            Set row_parts to <>.
            For each row in newest_first:
                Set row_copy to [[list]](row).
                Do [[row_copy.pop]](0).
                Set commit_text to [[row_copy.pop]](0).
                Set verdict to [[row_copy.pop]](0).
                Set reviewer_text to [[row_copy.pop]](0).
                Set date_text to [[row_copy.pop]](0).
                Set comment_text to [[row_copy.pop]](0).
                Set current to [[row_copy.pop]](0).
                Set version_text to "Earlier".
                If current:
                    Set version_text to "Current".
                If commit_text:
                    Set link_count to link_count plus 1.
                    Set version_text to "<a href=\"" plus commit_url_base plus [[esc_attr]](commit_text) plus "\">" plus [[esc_text]](version_text) plus "</a>".
                Set shown_comment to comment_text.
                If not shown_comment:
                    Set shown_comment to "Not given".
                Set cells to <>.
                Do [[cells.append]]("<td>" plus [[esc_text]]([[state_label]](verdict)) plus "</td>").
                Do [[cells.append]]("<td>" plus [[esc_text]](reviewer_text) plus "</td>").
                Do [[cells.append]]("<td>" plus [[esc_text]]([[human_date]](date_text)) plus "</td>").
                Do [[cells.append]]("<td>" plus version_text plus "</td>").
                Do [[cells.append]]("<td>" plus [[esc_text]](shown_comment) plus "</td>").
                Do [[row_parts.append]]("<tr>" plus [[empty_text.join]](cells) plus "</tr>").
            Do [[parts.append]]("<tbody>" plus [[joiner.join]](row_parts) plus "</tbody>").
            Do [[parts.append]]("</table>").
            Do [[parts.append]]("</section>").
    If section_count equals 0:
        Do [[parts.append]]("<p>Open a document and record a decision to start this list.</p>").
    Otherwise:
        Do [[parts.append]]("<p>Each reviewer name is recorded as entered and is not verified.</p>").
        If link_count is greater than 0:
            Do [[parts.append]]("<p>Each version links to the stored version of the text that the reviewer read.</p>").
    Do [[parts.append]]("<nav class=\"docnav\"><a href=\"index.html\">Guideline index</a></nav>").
    Set body_html to [[joiner.join]](parts).
    Set crumb_html to "<a href=\"../../index.html\">guidelines</a> / <a href=\"index.html\">" plus [[esc_text]]([[model.get]]("title", gid)) plus "</a> / records".
    Give back [[page_html]]("Decision records", crumb_html, body_html).

Define [[build_error_page]] taking title_text, heading_text, body_html:
    Set parts to <>.
    Do [[parts.append]]("<h1>" plus [[esc_text]](heading_text) plus "</h1>").
    Do [[parts.append]](body_html).
    Set joiner to "\n".
    Give back [[page_html]](title_text, "cnl-ckc reviewer", [[joiner.join]](parts)).

Define [[extract_hrefs]] taking page_text:
    Set found to <>.
    Set parts to [[page_text.split]]("<a ").
    Do [[parts.pop]](0).
    For each part in parts:
        Set tag_parts to [[part.split]](">", 1).
        Set tag_text to [[tag_parts.pop]](0).
        Set attr_parts to [[tag_text.split]]("href=\"", 1).
        If [[len]](attr_parts) equals 2:
            Do [[attr_parts.pop]](0).
            Set attr_tail to [[attr_parts.pop]](0).
            Set value_parts to [[attr_tail.split]]("\"", 1).
            Set href_value to [[value_parts.pop]](0).
            Do [[found.append]](href_value).
    Give back found.

Define [[resolve_href]] taking page_path, href_value:
    If [[href_value.startswith]]("#"):
        Give back "#".
    If [[href_value.startswith]]("https://"):
        Give back "#".
    Set fragment_parts to [[href_value.split]]("#", 1).
    Set href_value to [[fragment_parts.pop]](0).
    Set base_segs to [[page_path.split]]("/").
    Do [[base_segs.pop]]().
    Set target_segs to [[href_value.split]]("/").
    Set failed to False.
    For each seg in target_segs:
        If seg equals "..":
            If base_segs:
                Do [[base_segs.pop]]().
            Otherwise:
                Set failed to True.
        Otherwise if seg does not equal ".":
            Do [[base_segs.append]](seg).
    If failed:
        Give back "".
    Set joiner to "/".
    Give back [[joiner.join]](base_segs).

Define [[render_pages]] taking models:
    Set page_order to <>.
    Set pages to {}.
    Set asset_paths to {}.
    Do [[page_order.append]]("index.html").
    Do [[pages.update]]({"index.html": [[build_index_page]](models)}).
    Set meter_lines to <>.
    For each model in models:
        Set gid to [[model.get]]("gid", "").
        Set docids to [[model.get]]("docids", <>).
        Set counts to [[model.get]]("counts", {}).
        Set guideline_path to [[model.get]]("path", None).
        For each name_text in [[model.get]]("source_names", <>):
            Set asset_rel to "g/" plus [[url_seg]](gid) plus "/source/" plus [[url_seg]](name_text).
            Do [[asset_paths.update]]({asset_rel: [[guideline_path.joinpath]]("source", name_text)}).
        Set gid_page to "g/" plus [[url_seg]](gid) plus "/index.html".
        Do [[page_order.append]](gid_page).
        Do [[pages.update]]({gid_page: [[build_guideline_page]](model)}).
        Set prev_map to {}.
        Set next_map to {}.
        Set prev_id to "".
        For each docid in docids:
            If prev_id:
                Do [[prev_map.update]]({docid: prev_id}).
                Do [[next_map.update]]({prev_id: docid}).
            Set prev_id to docid.
        For each docid in docids:
            Set data_result to [[doc_render_data]](model, docid).
            If [[result_kind]](data_result) equals "err":
                Give back data_result.
            Set doc_data to [[result_value]](data_result).
            Set doc_page to "g/" plus [[url_seg]](gid) plus "/doc/" plus [[url_seg]](docid) plus ".html".
            Do [[page_order.append]](doc_page).
            Do [[pages.update]]({doc_page: [[build_doc_page]](model, docid, doc_data, [[prev_map.get]](docid, ""), [[next_map.get]](docid, ""))}).
        Set records_page to "g/" plus [[url_seg]](gid) plus "/records.html".
        Do [[page_order.append]](records_page).
        Do [[pages.update]]({records_page: [[build_records_page]](model)}).
        Set page_count to 2 plus [[len]](docids).
        Do [[meter_lines.append]]("ui: " plus gid plus " docs=" plus [[str]]([[len]](docids)) plus " regions=" plus [[str]]([[counts.get]]("regions", 0)) plus " pages=" plus [[str]](page_count)).
    For each page_path in page_order:
        Set page_text to [[pages.get]](page_path, "").
        For each href_value in [[extract_hrefs]](page_text):
            Set resolved to [[resolve_href]](page_path, href_value).
            If resolved does not equal "#":
                Set known to resolved is in pages.
                If not known:
                    Set known to resolved is in asset_paths.
                If not known:
                    Give back [[err]]("ui: viewmodel: dangling href " plus page_path plus " " plus href_value).
    Set bundle to {}.
    Do [[bundle.update]]({"page_order": page_order}).
    Do [[bundle.update]]({"pages": pages}).
    Do [[bundle.update]]({"asset_paths": asset_paths}).
    Do [[bundle.update]]({"meter_lines": meter_lines}).
    Give back [[ok]](bundle).

Define [[render_tree]] taking corpus, out_path:
    Set model_result to [[build_viewmodel]](corpus).
    If [[result_kind]](model_result) equals "err":
        Give back model_result.
    Set models to [[result_value]](model_result).
    Set bundle_result to [[render_pages]](models).
    If [[result_kind]](bundle_result) equals "err":
        Give back bundle_result.
    Set bundle to [[result_value]](bundle_result).
    Set page_order to [[bundle.get]]("page_order", <>).
    Set pages to [[bundle.get]]("pages", {}).
    For each page_path in page_order:
        Set full_path to [[out_path.joinpath]](page_path).
        Set parent_dir to full_path.parent.
        Do [[parent_dir.mkdir]](parents=True, exist_ok=True).
        Set page_text to [[pages.get]](page_path, "").
        Set page_bytes to [[page_text.encode]]("utf-8").
        Do [[full_path.write_bytes]](page_bytes).
    Set asset_paths to [[bundle.get]]("asset_paths", {}).
    Set asset_rels to [[sorted]](asset_paths).
    For each asset_rel in asset_rels:
        Set full_path to [[out_path.joinpath]](asset_rel).
        Set parent_dir to full_path.parent.
        Do [[parent_dir.mkdir]](parents=True, exist_ok=True).
        Do [[shutil.copyfile]]([[asset_paths.get]](asset_rel), full_path).
    Set result to {}.
    Do [[result.update]]({"guidelines": [[len]](models)}).
    Do [[result.update]]({"pages_total": [[len]](page_order)}).
    Do [[result.update]]({"asset_rels": asset_rels}).
    Do [[result.update]]({"meter_lines": [[bundle.get]]("meter_lines", <>)}).
    Give back [[ok]](result).

Define [[walk_files]] taking base_path:
    Set found to <>.
    Set pending to <base_path>.
    While pending:
        Set current to [[pending.pop]](0).
        For each entry in [[sorted]]([[current.iterdir]]()):
            If [[entry.is_dir]]():
                Do [[pending.append]](entry).
            Otherwise:
                Set rel_path to [[entry.relative_to]](base_path).
                Do [[found.append]]([[str]](rel_path)).
    Give back [[sorted]](found).

Define [[strip_between]] taking source_text, open_mark, close_mark:
    Set pieces to [[source_text.split]](open_mark).
    Set kept to <>.
    Set first to True.
    For each piece in pieces:
        If first:
            Do [[kept.append]](piece).
            Set first to False.
        Otherwise:
            Set tail_parts to [[piece.split]](close_mark).
            If [[len]](tail_parts) is greater than 1:
                Do [[tail_parts.pop]](0).
                Set close_joiner to close_mark.
                Do [[kept.append]]([[close_joiner.join]](tail_parts)).
    Set empty_text to "".
    Give back [[empty_text.join]](kept).

Define [[visible_text]] taking page_text:
    Set no_style to [[strip_between]](page_text, "<style>", "</style>").
    Set no_pre to [[strip_between]](no_style, "<pre", "</pre>").
    Set no_comments to [[strip_between]](no_pre, "<!--", "-->").
    Set fragments to [[no_comments.split]]("<").
    Set texts to <>.
    Set first to True.
    For each fragment in fragments:
        If first:
            Do [[texts.append]](fragment).
            Set first to False.
        Otherwise:
            Set tag_parts to [[fragment.split]](">").
            If [[len]](tag_parts) is greater than 1:
                Do [[tag_parts.pop]](0).
                Set gt_joiner to ">".
                Do [[texts.append]]([[gt_joiner.join]](tag_parts)).
    Set space_joiner to " ".
    Give back [[html.unescape]]([[space_joiner.join]](texts)).

Define [[page_invariant_name]] taking page_text:
    If [[page_text.count]]("<!doctype html>") does not equal 1:
        Give back "doctype".
    If [[page_text.count]]("<html lang=\"en\">") does not equal 1:
        Give back "html-lang".
    If [[page_text.count]]("<h1") does not equal 1:
        Give back "h1".
    If [[page_text.count]]("<main id=\"main\">") does not equal 1:
        Give back "main".
    If [[page_text.count]]("<nav") is less than 1:
        Give back "nav".
    If [[page_text.count]]("<a class=\"skip\" href=\"#main\">Skip to content</a>") does not equal 1:
        Give back "skip".
    If [[page_text.count]]("<style>") does not equal 1:
        Give back "style".
    If [[page_text.count]]("<script") does not equal 0:
        Give back "script".
    If [[page_text.count]]("tabindex") does not equal 0:
        Give back "tabindex".
    If [[page_text.count]]("style=") does not equal 0:
        Give back "inline-style".
    Set external_total to [[page_text.count]]("href=\"http").
    Set commit_links to [[page_text.count]]("href=\"" plus commit_url_base).
    If external_total does not equal commit_links:
        Give back "external-href".
    Set scope_html to "<footer class=\"scope\"><p>" plus [[esc_text]](scope_line_text) plus "</p></footer>".
    If [[page_text.count]](scope_html) does not equal 1:
        Give back "scope-line".
    Set page_visible to [[visible_text]](page_text).
    Set visible_lower to [[page_visible.lower]]().
    If "sha256" is in visible_lower:
        Give back "copy-sha256".
    If "bundle differs" is in visible_lower:
        Give back "copy-bundle-differs".
    Set hex_runs to [[re.findall]]("[0-9a-fA-F]{16,}", page_visible).
    For each hex_run in hex_runs:
        If [[re.search]]("[0-9]", hex_run):
            Give back "copy-hex".
    If [[re.search]]("\\b(ace|restates|uncovered)\\(", page_visible):
        Give back "copy-functor".
    Set short_runs to [[re.findall]]("\\b[0-9a-f]{7,15}\\b", page_visible).
    For each short_run in short_runs:
        If [[re.search]]("[0-9]", short_run):
            If [[re.search]]("[a-f]", short_run):
                Give back "copy-short-hex".
    Give back "".

Define [[selftest_violation]] taking nothing:
    If [[url_seg]]("a b/%") does not equal "a%20b%2F%25":
        Give back "ui: selftest failed: url_seg".
    If [[url_seg]]("/") does not equal "%2F":
        Give back "ui: selftest failed: url_seg".
    If [[url_seg]]("漢") does not equal "%E6%BC%A2":
        Give back "ui: selftest failed: url_seg".
    If [[esc_text]]("<&>\"'") does not equal "&lt;&amp;&gt;\"'":
        Give back "ui: selftest failed: esc_text".
    If [[esc_text]]("plain") does not equal "plain":
        Give back "ui: selftest failed: esc_text".
    If [[esc_attr]]("<&>\"'") does not equal "&lt;&amp;&gt;&quot;&#x27;":
        Give back "ui: selftest failed: esc_attr".
    If [[esc_attr]]("plain") does not equal "plain":
        Give back "ui: selftest failed: esc_attr".
    If "therapies" is not in [[hl_variants]]("therapy"):
        Give back "ui: selftest failed: hl variants plural".
    If "prescribing" is not in [[hl_variants]]("prescribes"):
        Give back "ui: selftest failed: hl variants gerund".
    If "applying" is not in [[hl_variants]]("applies"):
        Give back "ui: selftest failed: hl variants y-stem".
    Set hl_case to [[hl_link_data]]("Every clinician should offer-naloxone.\n", "Clinicians should consider offering naloxone.").
    If [[hl_case.get]]("matched", 0) does not equal 2:
        Give back "ui: selftest failed: hl match count".
    If [[hl_case.get]]("payload_html", "") does not equal "<mark class=\"t0\">Clinicians</mark> should consider <mark class=\"t1\">offering naloxone</mark>.":
        Give back "ui: selftest failed: hl payload html".
    If [[hl_case.get]]("ace_html", "") does not equal "<span class=\"kw\">Every</span> <mark class=\"t0\">clinician</mark> <span class=\"kw\">should</span> <mark class=\"t1\">offer-naloxone</mark>.\n":
        Give back "ui: selftest failed: hl ace html".
    Set hl_case to [[hl_link_data]]("A clinician should check a risk.\n", "risk < benefit").
    If [[hl_case.get]]("payload_html", "") does not equal "<mark class=\"t0\">risk</mark> &lt; benefit":
        Give back "ui: selftest failed: hl escape".
    Set hl_case to [[hl_link_data]]("A clinician should assess a risk.\n", "Brisk walking is risky.").
    If [[hl_case.get]]("matched", 0) does not equal 0:
        Give back "ui: selftest failed: hl boundary".
    If [[hl_case.get]]("payload_html", "") does not equal "Brisk walking is risky.":
        Give back "ui: selftest failed: hl boundary bytes".
    Set hl_case to [[hl_link_data]]("Every clinician should assess an opioid-naive-patient.\n", "Care for opioid-naïve patients.").
    If [[hl_case.get]]("payload_html", "") does not equal "Care for <mark class=\"t0\">opioid-naïve patients</mark>.":
        Give back "ui: selftest failed: hl diacritic".
    Set hl_case to [[hl_link_data]]("A clinician should treat an acute-pain.\n", "It was acute. Pain remained.").
    If [[hl_case.get]]("matched", 0) does not equal 0:
        Give back "ui: selftest failed: hl sentence guard".
    Set hl_case to [[hl_link_data]]("Every clinician should review an opioid-therapy and a therapy.\n", "An opioid therapy and a therapy.").
    If [[hl_case.get]]("payload_html", "") does not equal "An <mark class=\"t0\">opioid therapy</mark> and a <mark class=\"t1\">therapy</mark>.":
        Give back "ui: selftest failed: hl longest first".
    Set hl_case to [[hl_link_data]]("Every clinician should maximize a nonopioid-pharmacologic-therapy.\n", "Discuss nonopioid pharmacologic options.").
    If [[hl_case.get]]("matched", 0) does not equal 1:
        Give back "ui: selftest failed: hl window prefix count".
    If [[hl_case.get]]("payload_html", "") does not equal "Discuss <mark class=\"t0\">nonopioid pharmacologic</mark> options.":
        Give back "ui: selftest failed: hl window prefix".
    If "<mark class=\"t0\">nonopioid-pharmacologic-therapy</mark>" is not in [[hl_case.get]]("ace_html", ""):
        Give back "ui: selftest failed: hl window ace".
    Set hl_case to [[hl_link_data]]("Every clinician should maximize a nonopioid-pharmacologic-therapy.\n", "Try pharmacologic therapy.").
    If [[hl_case.get]]("payload_html", "") does not equal "Try <mark class=\"t0\">pharmacologic therapy</mark>.":
        Give back "ui: selftest failed: hl window suffix".
    Set hl_case to [[hl_link_data]]("Every clinician should maximize a nonopioid-pharmacologic-therapy.\n", "The therapy failed.").
    If [[hl_case.get]]("matched", 0) does not equal 0:
        Give back "ui: selftest failed: hl window single word".
    Set hl_case to [[hl_link_data]]("Every clinician should maximize a nonopioid-pharmacologic-therapy.\n", "Use nonopioid pharmacologic therapies today.").
    If [[hl_case.get]]("payload_html", "") does not equal "Use <mark class=\"t0\">nonopioid pharmacologic therapies</mark> today.":
        Give back "ui: selftest failed: hl window full span".
    Set hl_case to [[hl_link_data]]("A clinician should compare an opioid-use-disorder and a use-disorder.\n", "A use disorder emerged.").
    If [[hl_case.get]]("payload_html", "") does not equal "A <mark class=\"t0\">use disorder</mark> emerged.":
        Give back "ui: selftest failed: hl window precedence".
    If [[hl_case.get]]("ace_html", "") does not equal "<span class=\"kw\">A</span> clinician <span class=\"kw\">should</span> compare <span class=\"kw\">an</span> opioid-use-disorder <span class=\"kw\">and</span> <span class=\"kw\">a</span> <mark class=\"t0\">use-disorder</mark>.\n":
        Give back "ui: selftest failed: hl window precedence ace".
    If "mark.t1, mark.t7, mark.t13, mark.t19, mark.t25, mark.t31 { background: #fef9c3; }" is not in css_text:
        Give back "ui: selftest failed: hue group css".
    If "main:has(mark.t7:hover) mark.t7 { background: #fef08a; text-decoration-style: solid; }" is not in css_text:
        Give back "ui: selftest failed: hue hover cycle css".
    If "main:has(mark.t0:hover) mark.t0 { background: #bfdbfe; text-decoration-style: solid; }" is not in css_text:
        Give back "ui: selftest failed: hue hover base css".
    If "mark, mark[class] { background: none; }" is not in css_text:
        Give back "ui: selftest failed: print mark strip".
    Set unique_values to <>.
    For each role in [[sorted]](palette):
        Set pair to [[palette.get]](role, <>).
        Set pair_copy to [[list]](pair).
        Set fg_value to [[pair_copy.pop]](0).
        Set bg_value to [[pair_copy.pop]](0).
        Set fg_known to fg_value is in unique_values.
        If not fg_known:
            Do [[unique_values.append]](fg_value).
        Set bg_known to bg_value is in unique_values.
        If not bg_known:
            Do [[unique_values.append]](bg_value).
    Set allowed_total to 0.
    For each color_value in unique_values:
        Set allowed_total to allowed_total plus [[css_text.count]](color_value).
    If [[css_text.count]]("#") does not equal allowed_total:
        Give back "ui: selftest failed: palette".
    Set case_head to "<h1>Selftest</h1>".
    Set clean_page to [[page_html]]("Selftest", "selftest", case_head plus "<p>Clean page.</p>").
    If [[page_invariant_name]](clean_page) does not equal "":
        Give back "ui: selftest failed: invariant clean".
    Set scope_html to "<footer class=\"scope\"><p>" plus [[esc_text]](scope_line_text) plus "</p></footer>".
    Set scope_missing to [[clean_page.replace]](scope_html, "").
    If [[page_invariant_name]](scope_missing) does not equal "scope-line":
        Give back "ui: selftest failed: invariant scope-missing".
    Set scope_doubled to [[clean_page.replace]](scope_html, scope_html plus scope_html).
    If [[page_invariant_name]](scope_doubled) does not equal "scope-line":
        Give back "ui: selftest failed: invariant scope-duplicate".
    Set invariant_cases to <>.
    Set case_row to <"<p><code>SHA256</code></p>", "copy-sha256", "hex-label-case">.
    Do [[invariant_cases.append]](case_row).
    Set case_row to <"<p>sha&#50;56</p>", "copy-sha256", "character-reference">.
    Do [[invariant_cases.append]](case_row).
    Set case_row to <"<p>The bundle differs from the recorded one.</p>", "copy-bundle-differs", "bundle-phrase">.
    Do [[invariant_cases.append]](case_row).
    Set case_row to <"<p><code>0123456789abcdef</code></p>", "copy-hex", "hex-run-16">.
    Do [[invariant_cases.append]](case_row).
    Set case_row to <"<p><code>0123456789abcde</code></p>", "copy-short-hex", "hex-run-15">.
    Do [[invariant_cases.append]](case_row).
    Set case_row to <"<p>abcdefabcdefabcdef</p>", "", "letters-only-run">.
    Do [[invariant_cases.append]](case_row).
    Set case_row to <"<!-- ui: verdict: a > b sha256 bundle differs 0123456789abcdef --><p>Clean page.</p>", "", "comment-exempt">.
    Do [[invariant_cases.append]](case_row).
    Set case_row to <"<input type=\"hidden\" name=\"review_sha256\" value=\"0123456789abcdef0123456789abcdef\">", "", "attribute-exempt">.
    Do [[invariant_cases.append]](case_row).
    Set case_row to <"<pre>sha256 0123456789abcdef</pre>", "", "quoted-artifact-exempt">.
    Do [[invariant_cases.append]](case_row).
    Set case_row to <"<p>sha<span>256</span></p>", "", "split-across-tags">.
    Do [[invariant_cases.append]](case_row).
    Set case_row to <"<p>ace(a-2)</p>", "copy-functor", "functor-ace">.
    Do [[invariant_cases.append]](case_row).
    Set case_row to <"<p>restates(b3-01)</p>", "copy-functor", "functor-restates">.
    Do [[invariant_cases.append]](case_row).
    Set case_row to <"<p>uncovered(heading: x)</p>", "copy-functor", "functor-uncovered">.
    Do [[invariant_cases.append]](case_row).
    Set case_row to <"<p>space(1) Restates b3-01</p>", "", "functor-embedded-word-exempt">.
    Do [[invariant_cases.append]](case_row).
    Set case_row to <"<pre>restates(b3-01) 0123456789ab</pre>", "", "functor-pre-exempt">.
    Do [[invariant_cases.append]](case_row).
    Set case_row to <"<p><code>0abcdef</code></p>", "copy-short-hex", "short-hex-7">.
    Do [[invariant_cases.append]](case_row).
    Set case_row to <"<p>202211041022</p>", "", "short-hex-digits-only">.
    Do [[invariant_cases.append]](case_row).
    Set case_row to <"<p>abcdefabcdef</p>", "", "short-hex-letters-only">.
    Do [[invariant_cases.append]](case_row).
    For each invariant_case in invariant_cases:
        Set case_copy to [[list]](invariant_case).
        Set case_body to [[case_copy.pop]](0).
        Set case_want to [[case_copy.pop]](0).
        Set case_label to [[case_copy.pop]](0).
        Set case_page to [[page_html]]("Selftest", "selftest", case_head plus case_body).
        If [[page_invariant_name]](case_page) does not equal case_want:
            Give back "ui: selftest failed: invariant " plus case_label.
    Give back "".

Set h5_content_type to [[tuple]](<"Content-Type", "text/html; charset=utf-8">).
Set h5_csp to [[tuple]](<"Content-Security-Policy", "default-src 'none'; style-src 'unsafe-inline'">).
Set h5_nosniff to [[tuple]](<"X-Content-Type-Options", "nosniff">).
Set h5_referrer to [[tuple]](<"Referrer-Policy", "no-referrer">).
Set h5_cache to [[tuple]](<"Cache-Control", "no-store">).

Define [[base_headers]] taking nothing:
    Give back <h5_content_type, h5_csp, h5_nosniff, h5_referrer, h5_cache>.

Define [[asset_headers]] taking media_type:
    Set content_type to [[tuple]](<"Content-Type", media_type>).
    Give back <content_type, h5_csp, h5_nosniff, h5_referrer, h5_cache>.

Define [[not_found_response]] taking nothing:
    Set body_html to "<p>The requested page does not exist.</p>".
    Set page_text to [[build_error_page]]("Not found", "Not found", body_html).
    Set body_bytes to [[page_text.encode]]("utf-8").
    Give back <"404 Not Found", [[base_headers]](), body_bytes>.

Define [[doc_shaped]] taking path_text:
    If not [[path_text.startswith]]("/g/"):
        Give back False.
    Set rest_text to [[path_text.removeprefix]]("/g/").
    Set segs to [[rest_text.split]]("/").
    If [[len]](segs) does not equal 3:
        Give back False.
    Set gid_seg to [[segs.pop]](0).
    Set mid_seg to [[segs.pop]](0).
    Set leaf_seg to [[segs.pop]](0).
    If gid_seg equals "":
        Give back False.
    If mid_seg does not equal "doc":
        Give back False.
    If not [[leaf_seg.endswith]](".html"):
        Give back False.
    Set stem_text to [[leaf_seg.removesuffix]](".html").
    If stem_text equals "":
        Give back False.
    Give back True.

Define [[method_response]] taking shaped:
    Set allow_value to "GET".
    Set body_html to "<p>Only GET is supported on this page.</p>".
    If shaped:
        Set allow_value to "GET, POST".
        Set body_html to "<p>Only GET and POST are supported on this page.</p>".
    Set page_text to [[build_error_page]]("Method not allowed", "Method not allowed", body_html).
    Set body_bytes to [[page_text.encode]]("utf-8").
    Set headers to [[base_headers]]().
    Do [[headers.append]]([[tuple]](<"Allow", allow_value>)).
    Give back <"405 Method Not Allowed", headers, body_bytes>.

Define [[verdict_refusal]] taking status_text, heading_text, detail, plain_text:
    Set body_html to "<p>" plus [[esc_text]](plain_text) plus "</p>\n<!-- " plus [[comment_safe]](detail) plus " -->".
    Set page_text to [[build_error_page]](heading_text, heading_text, body_html).
    Set body_bytes to [[page_text.encode]]("utf-8").
    Give back <status_text, [[base_headers]](), body_bytes>.

Define [[redirect_response]] taking gid, docid:
    Set location_value to "/g/" plus [[url_seg]](gid) plus "/doc/" plus [[url_seg]](docid) plus ".html".
    Set body_html to "<p>The decision was recorded.</p>".
    Set page_text to [[build_error_page]]("Decision recorded", "Decision recorded", body_html).
    Set body_bytes to [[page_text.encode]]("utf-8").
    Set headers to [[base_headers]]().
    Do [[headers.append]]([[tuple]](<"Location", location_value>)).
    Give back <"303 See Other", headers, body_bytes>.

Define [[error_response]] taking detail:
    Set body_html to "<p>The server could not complete the request. Reload the page and try again.</p>\n<!-- " plus [[comment_safe]](detail) plus " -->".
    Set page_text to [[build_error_page]]("Server error", "Server error", body_html).
    Set body_bytes to [[page_text.encode]]("utf-8").
    Give back <"500 Internal Server Error", [[base_headers]](), body_bytes>.

Define [[page_response]] taking page_text:
    Set body_bytes to [[page_text.encode]]("utf-8").
    Give back <"200 OK", [[base_headers]](), body_bytes>.

Define [[parse_form_fields]] taking body_bytes:
    Set body_text to "".
    Try:
        Set body_text to [[body_bytes.decode]]("utf-8").
    Catch UnicodeDecodeError:
        Give back [[err]]("ui: verdict: body not decodable").
    Set parsed to {}.
    Try:
        Set parsed to [[urllib.parse.parse_qs]](body_text, keep_blank_values=True, strict_parsing=True, errors="strict", max_num_fields=32).
    Catch ValueError:
        Give back [[err]]("ui: verdict: body not parseable").
    Catch UnicodeDecodeError:
        Give back [[err]]("ui: verdict: body not parseable").
    For each name in verdict_field_names:
        Set present to name is in parsed.
        If not present:
            Give back [[err]]("ui: verdict: missing field " plus name).
    For each name in verdict_field_names:
        Set value_list to [[parsed.get]](name).
        If [[len]](value_list) is greater than 1:
            Give back [[err]]("ui: verdict: duplicate field " plus name).
    For each key_name in parsed:
        Set known to key_name is in verdict_field_names.
        If not known:
            Give back [[err]]("ui: verdict: unknown field " plus key_name).
    Set fields to {}.
    For each name in verdict_field_names:
        Set value_list to [[list]]([[parsed.get]](name)).
        Do [[fields.update]]({name: [[value_list.pop]](0)}).
    Set verdict_value to [[fields.get]]("verdict").
    Set verdict_ok to False.
    If verdict_value equals "approved":
        Set verdict_ok to True.
    If verdict_value equals "rejected":
        Set verdict_ok to True.
    If not verdict_ok:
        Give back [[err]]("ui: verdict: invalid verdict").
    Set reviewer_value to [[fields.get]]("reviewer").
    If not reviewer_value:
        Give back [[err]]("ui: verdict: invalid reviewer").
    If not [[field_text_ok]](reviewer_value):
        Give back [[err]]("ui: verdict: invalid reviewer").
    If not [[field_text_ok]]([[fields.get]]("comment")):
        Give back [[err]]("ui: verdict: invalid comment").
    If not [[valid_hex64]]([[fields.get]]("review_sha256")):
        Give back [[err]]("ui: verdict: invalid review_sha256").
    Set ledger_value to [[fields.get]]("ledger_sha256").
    Set ledger_ok to [[valid_hex64]](ledger_value).
    If ledger_value equals "absent":
        Set ledger_ok to True.
    If not ledger_ok:
        Give back [[err]]("ui: verdict: invalid ledger_sha256").
    Give back [[ok]](fields).

Define [[discard_tmp]] taking tmp_text:
    Try:
        Do [[os.unlink]](tmp_text).
    Catch OSError:
        Set discard_failed to True.

Define [[release_ledger_lock]] taking lock_fd, audit_dir:
    Try:
        Do [[os.unlink]]([[str]]([[audit_dir.joinpath]](".adjudication.lock"))).
    Catch OSError:
        Set unlink_failed to True.
    Try:
        Do [[os.close]](lock_fd).
    Catch OSError:
        Set close_failed to True.

Define [[handle_verdict_post]] taking model, gid, docid, meta:
    Set port_value to [[serve_config.get]]("port", 8377).
    Set expected_host to "127.0.0.1:" plus [[str]](port_value).
    Set origin_value to [[meta.get]]("origin", None).
    Set expected_origin to "http://" plus expected_host.
    If origin_value does not equal None:
        If origin_value does not equal expected_origin:
            Give back [[verdict_refusal]]("403 Forbidden", "Forbidden", "ui: verdict: origin not allowed", refusal_refused_text).
    If [[meta.get]]("content_type", "") does not equal "application/x-www-form-urlencoded":
        Give back [[verdict_refusal]]("400 Bad Request", "Bad request", "ui: verdict: unsupported content type", refusal_invalid_form_text).
    Set body_bytes to [[meta.get]]("body", None).
    If body_bytes equals None:
        Set stream to [[meta.get]]("stream", None).
        Set length_text to [[meta.get]]("length_text", "").
        Set length_ok to True.
        Set length_num to 0.
        Try:
            Set length_num to [[int]](length_text).
        Catch ValueError:
            Set length_ok to False.
        If length_num is less than 0:
            Set length_ok to False.
        If length_ok:
            If stream does not equal None:
                Set read_ok to True.
                Set read_bytes to [[bytes]]().
                Try:
                    Set read_bytes to [[stream.read]](length_num).
                Catch OSError:
                    Set read_ok to False.
                If read_ok:
                    If [[len]](read_bytes) equals length_num:
                        Set body_bytes to read_bytes.
    If body_bytes equals None:
        Give back [[verdict_refusal]]("400 Bad Request", "Bad request", "ui: verdict: missing body", refusal_invalid_form_text).
    Set fields_result to [[parse_form_fields]](body_bytes).
    If [[result_kind]](fields_result) equals "err":
        Give back [[verdict_refusal]]("400 Bad Request", "Bad request", [[result_value]](fields_result), refusal_invalid_form_text).
    Set fields to [[result_value]](fields_result).
    Set token_value to [[serve_config.get]]("token", "").
    Set token_ok to True.
    If token_value equals "":
        Set token_ok to False.
    If [[fields.get]]("csrf") does not equal token_value:
        Set token_ok to False.
    If not token_ok:
        Give back [[verdict_refusal]]("403 Forbidden", "Forbidden", "ui: verdict: invalid csrf token", refusal_refused_text).
    Set data_result to [[doc_render_data]](model, docid).
    If [[result_kind]](data_result) equals "err":
        Give back [[error_response]]([[result_value]](data_result)).
    Set goal_py to [[goal_py_path]]().
    Set tool_dir to goal_py.parent.
    Set repo_root to tool_dir.parent.
    Set guideline_path to [[model.get]]("path", None).
    Set derive_command to <sys.executable, "-P", [[str]](goal_py), "derive-review-manifest", [[str]]([[guideline_path.resolve]]())>.
    Set derive_ok to True.
    Set derive_result to None.
    Try:
        Set derive_result to [[subprocess.run]](derive_command, capture_output=True, cwd=[[str]](repo_root)).
    Catch OSError:
        Set derive_ok to False.
    If not derive_ok:
        Give back [[error_response]]("ui: verdict: manifest derivation failed: validator launch failed").
    If derive_result.returncode does not equal 0:
        Set relay to [[first_output_line]](derive_result).
        Give back [[error_response]]("ui: verdict: manifest derivation failed: " plus relay).
    Set manifest_bytes to derive_result.stdout.
    Set manifest_text to "".
    Try:
        Set manifest_text to [[manifest_bytes.decode]]("utf-8").
    Catch UnicodeDecodeError:
        Give back [[error_response]]("ui: verdict: manifest derivation failed: undecodable output").
    Set fresh_digest to "".
    For each line_text in [[manifest_text.split]]("\n"):
        Set line_fields to [[line_text.split]]("\t").
        If [[len]](line_fields) equals 6:
            Set row_docid to [[line_fields.pop]](0).
            If row_docid equals docid:
                Set fresh_digest to [[line_fields.pop]]().
    If fresh_digest equals "":
        Give back [[error_response]]("ui: verdict: manifest derivation failed: docid row missing").
    If [[fields.get]]("review_sha256") does not equal fresh_digest:
        Give back [[verdict_refusal]]("409 Conflict", "Conflict", "ui: verdict: subject changed", refusal_subject_text).
    If [[fields.get]]("ledger_sha256") does not equal [[model.get]]("ledger_file_digest", "absent"):
        Give back [[verdict_refusal]]("409 Conflict", "Conflict", "ui: verdict: ledger changed", refusal_ledger_text).
    Set real_guideline_path to [[model.get]]("real_path", None).
    Set audit_dir to [[real_guideline_path.joinpath]]("audit").
    Set ledger_path to [[audit_dir.joinpath]]("adjudication.tsv").
    If [[ledger_path.is_symlink]]():
        Give back [[error_response]]("ui: verdict: ledger not a regular file").
    If [[ledger_path.exists]]():
        If not [[ledger_path.is_file]]():
            Give back [[error_response]]("ui: verdict: ledger not a regular file").
    Set now_text to [[serve_config.get]]("now", "").
    If now_text equals "":
        Set now_value to [[datetime.datetime.now]](datetime.timezone.utc).
        Set now_text to [[now_value.strftime]]("%Y-%m-%dT%H:%M:%SZ").
    Set commit_text to [[serve_config.get]]("commit_pin", None).
    If commit_text equals None:
        Set commit_text to [[ace_commit_hex]](real_guideline_path, docid, [[model.get]]("corpus_commit", "")).
    Set tab_text to "\t".
    Set new_line to docid plus tab_text plus [[fields.get]]("review_sha256") plus tab_text plus commit_text plus tab_text plus [[fields.get]]("verdict") plus tab_text plus [[fields.get]]("reviewer") plus tab_text plus now_text plus tab_text plus [[fields.get]]("comment").
    Set new_key to docid plus tab_text plus now_text.
    Set kept_lines to <>.
    Set insert_at to 0.
    Set scan_index to 0.
    For each row in [[model.get]]("ledger_order", <>):
        Set row_copy to [[list]](row).
        Set row_docid to [[row_copy.pop]](0).
        Set row_digest to [[row_copy.pop]](0).
        Set row_commit to [[row_copy.pop]](0).
        Set row_verdict to [[row_copy.pop]](0).
        Set row_reviewer to [[row_copy.pop]](0).
        Set row_date to [[row_copy.pop]](0).
        Set row_comment to [[row_copy.pop]](0).
        Do [[kept_lines.append]](row_docid plus tab_text plus row_digest plus tab_text plus row_commit plus tab_text plus row_verdict plus tab_text plus row_reviewer plus tab_text plus row_date plus tab_text plus row_comment).
        Set scan_index to scan_index plus 1.
        Set row_key to row_docid plus tab_text plus row_date.
        Set later to new_key is less than row_key.
        If not later:
            Set insert_at to scan_index.
    Set out_lines to <>.
    Do [[out_lines.append]](ledger_header_text).
    Set emit_index to 0.
    For each kept_line in kept_lines:
        If emit_index equals insert_at:
            Do [[out_lines.append]](new_line).
        Do [[out_lines.append]](kept_line).
        Set emit_index to emit_index plus 1.
    If insert_at equals emit_index:
        Do [[out_lines.append]](new_line).
    Set joiner to "\n".
    Set candidate_text to [[joiner.join]](out_lines) plus "\n".
    Set candidate_bytes to [[candidate_text.encode]]("utf-8").
    Set tmp_ok to True.
    Set tmp_pair to None.
    Try:
        Set tmp_pair to [[tempfile.mkstemp]](dir=[[str]](audit_dir), prefix=".adjudication.tsv.").
    Catch OSError:
        Set tmp_ok to False.
    If not tmp_ok:
        Give back [[error_response]]("ui: verdict: ledger write failed").
    Set pair_list to [[list]](tmp_pair).
    Set tmp_fd to [[pair_list.pop]](0).
    Set tmp_text to [[pair_list.pop]](0).
    Set chmod_mode to 420.
    Set write_ok to True.
    Set written_count to 0.
    Try:
        Set written_count to [[os.write]](tmp_fd, candidate_bytes).
        Do [[os.fsync]](tmp_fd).
        Do [[os.close]](tmp_fd).
        Do [[os.chmod]](tmp_text, chmod_mode).
    Catch OSError:
        Set write_ok to False.
    If written_count does not equal [[len]](candidate_bytes):
        Set write_ok to False.
    If not write_ok:
        Try:
            Do [[os.close]](tmp_fd).
        Catch OSError:
            Set write_ok to False.
        Do [[discard_tmp]](tmp_text).
        Give back [[error_response]]("ui: verdict: ledger write failed").
    Set snapshot_ok to True.
    Set snap_text to "".
    Set manifest_copy to None.
    Try:
        Set snap_text to [[tempfile.mkdtemp]]().
        Set snap_dir to [[pathlib.Path]](snap_text).
        Set manifest_copy to [[snap_dir.joinpath]]("manifest.tsv").
        Do [[manifest_copy.write_bytes]](manifest_bytes).
    Catch OSError:
        Set snapshot_ok to False.
    If not snapshot_ok:
        If snap_text:
            Do [[shutil.rmtree]](snap_text, ignore_errors=True).
        Do [[discard_tmp]](tmp_text).
        Give back [[error_response]]("ui: adjudication ledger invalid: validator launch failed").
    Set validate_command to <sys.executable, "-P", [[str]](goal_py), "ledger-validate", tmp_text, [[str]](manifest_copy), "ui">.
    Set validate_ok to True.
    Set validate_result to None.
    Try:
        Set validate_result to [[subprocess.run]](validate_command, capture_output=True, cwd=[[str]](repo_root)).
    Catch OSError:
        Set validate_ok to False.
    Do [[shutil.rmtree]](snap_text, ignore_errors=True).
    If not validate_ok:
        Do [[discard_tmp]](tmp_text).
        Give back [[error_response]]("ui: adjudication ledger invalid: validator launch failed").
    If validate_result.returncode does not equal 0:
        Set relay to [[first_output_line]](validate_result).
        Do [[discard_tmp]](tmp_text).
        Give back [[error_response]]("ui: adjudication ledger invalid: " plus relay).
    If [[serve_config.get]]("fault", "") equals "after-tmp-write":
        Exit with 3.
    Set lock_fd to -1.
    Try:
        Set lock_fd to [[os.open]]([[str]]([[audit_dir.joinpath]](".adjudication.lock")), 66, 384).
        Do [[fcntl.flock]](lock_fd, fcntl.LOCK_EX).
    Catch OSError:
        If lock_fd is greater than -1:
            Try:
                Do [[os.close]](lock_fd).
            Catch OSError:
                Set close_failed to True.
        Set lock_fd to -1.
    If lock_fd equals -1:
        Do [[discard_tmp]](tmp_text).
        Give back [[error_response]]("ui: verdict: ledger write failed").
    Set current_digest to "absent".
    Set dest_ok to True.
    If [[ledger_path.exists]]():
        Set dest_bytes to [[bytes]]().
        Try:
            Set dest_bytes to [[ledger_path.read_bytes]]().
        Catch OSError:
            Set dest_ok to False.
        If dest_ok:
            Set current_digest to [[sha256_hex]](dest_bytes).
    Set race_hit to False.
    If not dest_ok:
        Set race_hit to True.
    If current_digest does not equal [[model.get]]("ledger_file_digest", "absent"):
        Set race_hit to True.
    If race_hit:
        Do [[release_ledger_lock]](lock_fd, audit_dir).
        Do [[discard_tmp]](tmp_text).
        Give back [[verdict_refusal]]("409 Conflict", "Conflict", "ui: verdict: ledger changed", refusal_ledger_text).
    Set replace_ok to True.
    Try:
        Do [[os.replace]](tmp_text, [[str]](ledger_path)).
    Catch OSError:
        Set replace_ok to False.
    Do [[release_ledger_lock]](lock_fd, audit_dir).
    If not replace_ok:
        Do [[discard_tmp]](tmp_text).
        Give back [[error_response]]("ui: verdict: ledger write failed").
    Give back [[redirect_response]](gid, docid).

Define [[respond]] taking corpus, method_text, path_text, meta:
    Set port_value to [[serve_config.get]]("port", 8377).
    Set expected_host to "127.0.0.1:" plus [[str]](port_value).
    If [[meta.get]]("host", "") does not equal expected_host:
        Give back [[verdict_refusal]]("403 Forbidden", "Forbidden", "ui: request: host not allowed", refusal_refused_text).
    Set shaped to [[doc_shaped]](path_text).
    If method_text does not equal "GET":
        If method_text does not equal "POST":
            Give back [[method_response]](shaped).
        If not shaped:
            Give back [[method_response]](shaped).
    Set model_result to [[build_viewmodel]](corpus).
    If [[result_kind]](model_result) equals "err":
        Give back [[error_response]]([[result_value]](model_result)).
    Set models to [[result_value]](model_result).
    If path_text equals "/":
        Give back [[page_response]]([[build_index_page]](models)).
    If path_text equals "/index.html":
        Give back [[page_response]]([[build_index_page]](models)).
    If not [[path_text.startswith]]("/g/"):
        Give back [[not_found_response]]().
    Set model_by_gid to {}.
    For each model in models:
        Set gid to [[model.get]]("gid", "").
        Do [[model_by_gid.update]]({gid: model}).
    Set rest_text to [[path_text.removeprefix]]("/g/").
    Set segs to [[rest_text.split]]("/").
    Set seg_count to [[len]](segs).
    If seg_count equals 2:
        Set gid_seg to [[segs.pop]](0).
        Set tail_seg to [[segs.pop]](0).
        Set model to [[model_by_gid.get]](gid_seg, None).
        If model equals None:
            Give back [[not_found_response]]().
        If tail_seg equals "":
            Give back [[page_response]]([[build_guideline_page]](model)).
        If tail_seg equals "index.html":
            Give back [[page_response]]([[build_guideline_page]](model)).
        If tail_seg equals "records.html":
            Give back [[page_response]]([[build_records_page]](model)).
        Give back [[not_found_response]]().
    If seg_count equals 3:
        Set gid_seg to [[segs.pop]](0).
        Set mid_seg to [[segs.pop]](0).
        Set leaf_seg to [[segs.pop]](0).
        If mid_seg equals "source":
            Set model to [[model_by_gid.get]](gid_seg, None).
            If model equals None:
                Give back [[not_found_response]]().
            Set source_names to [[model.get]]("source_names", <>).
            Set published to leaf_seg is in source_names.
            If not published:
                Give back [[not_found_response]]().
            Set asset_path to [[model.get]]("path", None).
            Set asset_path to [[asset_path.joinpath]]("source", leaf_seg).
            Set asset_bytes to [[bytes]]().
            Try:
                Set asset_bytes to [[asset_path.read_bytes]]().
            Catch OSError:
                Give back [[not_found_response]]().
            Give back <"200 OK", [[asset_headers]]([[asset_media_type]](leaf_seg)), asset_bytes>.
        If mid_seg does not equal "doc":
            Give back [[not_found_response]]().
        If not [[leaf_seg.endswith]](".html"):
            Give back [[not_found_response]]().
        Set model to [[model_by_gid.get]](gid_seg, None).
        If model equals None:
            Give back [[not_found_response]]().
        Set docid to [[leaf_seg.removesuffix]](".html").
        Set docids to [[model.get]]("docids", <>).
        Set known to docid is in docids.
        If not known:
            Give back [[not_found_response]]().
        If method_text equals "POST":
            Give back [[handle_verdict_post]](model, gid_seg, docid, meta).
        Set data_result to [[doc_render_data]](model, docid).
        If [[result_kind]](data_result) equals "err":
            Give back [[error_response]]([[result_value]](data_result)).
        Set doc_data to [[result_value]](data_result).
        Set prev_id to "".
        Set next_id to "".
        Set seen to False.
        Set walker to "".
        For each candidate in docids:
            If candidate equals docid:
                Set prev_id to walker.
                Set seen to True.
            Otherwise if seen:
                If next_id equals "":
                    Set next_id to candidate.
            Set walker to candidate.
        Give back [[page_response]]([[build_doc_page]](model, docid, doc_data, prev_id, next_id)).
    Give back [[not_found_response]]().

Define [[wsgi_app]] taking environ, start_response:
    Set root_text to [[serve_config.get]]("root", ".").
    Set root_path to [[pathlib.Path]](root_text).
    Set method_text to [[environ.get]]("REQUEST_METHOD", "").
    Set path_text to [[environ.get]]("PATH_INFO", "").
    Set meta to {}.
    Do [[meta.update]]({"host": [[environ.get]]("HTTP_HOST", "")}).
    Do [[meta.update]]({"origin": [[environ.get]]("HTTP_ORIGIN", None)}).
    Do [[meta.update]]({"content_type": [[environ.get]]("CONTENT_TYPE", "")}).
    Do [[meta.update]]({"length_text": [[environ.get]]("CONTENT_LENGTH", "")}).
    Do [[meta.update]]({"stream": [[environ.get]]("wsgi.input", None)}).
    Set corpus_result to [[resolve_corpus]](root_path).
    Set triple to None.
    If [[result_kind]](corpus_result) equals "err":
        Set triple to [[error_response]]([[result_value]](corpus_result)).
    Otherwise:
        Set corpus to [[result_value]](corpus_result).
        Set triple to [[respond]](corpus, method_text, path_text, meta).
        Do [[release_corpus]](corpus).
    Set triple_copy to [[list]](triple).
    Set status_text to [[triple_copy.pop]](0).
    Set headers to [[triple_copy.pop]](0).
    Set body_bytes to [[triple_copy.pop]](0).
    Do [[start_response]](status_text, headers).
    Give back <body_bytes>.

Define [[serve_command]] taking args:
    Set port_num to 8377.
    Set root_text to ".".
    If [[len]](args) is greater than 2:
        Do [[usage_fail]]().
    If args:
        Set port_text to [[args.pop]](0).
        Try:
            Set port_num to [[int]](port_text).
        Catch ValueError:
            Do [[usage_fail]]().
        If port_num is less than 1024:
            Do [[usage_fail]]().
        If port_num is greater than 65535:
            Do [[usage_fail]]().
    If args:
        Set root_text to [[args.pop]](0).
    Do [[serve_config.update]]({"root": root_text}).
    Do [[serve_config.update]]({"port": port_num}).
    Set token_bytes to [[os.urandom]](32).
    Do [[serve_config.update]]({"token": [[token_bytes.hex]]()}).
    Do [[serve_config.update]]({"now": ""}).
    Do [[serve_config.update]]({"fault": ""}).
    Set server to [[wsgiref.simple_server.make_server]]("127.0.0.1", port_num, wsgi_app).
    Do [[out_line]]("ui: serving http://127.0.0.1:" plus [[str]](port_num) plus "/").
    Do [[server.serve_forever]]().

Define [[render_command]] taking args:
    If not args:
        Do [[usage_fail]]().
    If [[len]](args) is greater than 2:
        Do [[usage_fail]]().
    Set outdir_text to [[args.pop]](0).
    Set root_text to ".".
    If args:
        Set root_text to [[args.pop]](0).
    Set out_path to [[pathlib.Path]](outdir_text).
    Set blocked to False.
    If [[out_path.is_symlink]]():
        Set blocked to True.
    Otherwise if [[out_path.is_dir]]():
        Set entries to [[list]]([[out_path.iterdir]]()).
        If entries:
            Set blocked to True.
    Otherwise if [[out_path.exists]]():
        Set blocked to True.
    If blocked:
        Do [[err_line]]("ui: render: destination not empty: " plus outdir_text).
        Exit with 2.
    Set root_path to [[pathlib.Path]](root_text).
    Set corpus_result to [[resolve_corpus]](root_path).
    If [[result_kind]](corpus_result) equals "err":
        Do [[err_line]]([[result_value]](corpus_result)).
        Exit with 1.
    Set corpus to [[result_value]](corpus_result).
    Set result to [[render_tree]](corpus, out_path).
    Do [[release_corpus]](corpus).
    If [[result_kind]](result) equals "err":
        Do [[err_line]]([[result_value]](result)).
        Exit with 1.
    Set summary to [[result_value]](result).
    For each meter_line in [[summary.get]]("meter_lines", <>):
        Do [[out_line]](meter_line).
    Do [[out_line]]("ui: ok " plus [[str]]([[summary.get]]("guidelines", 0)) plus " guidelines " plus [[str]]([[summary.get]]("pages_total", 0)) plus " pages").

Define [[check_ui_command]] taking args:
    If [[len]](args) is greater than 1:
        Do [[usage_fail]]().
    Set root_text to ".".
    If args:
        Set root_text to [[args.pop]](0).
    Set selftest_detail to [[selftest_violation]]().
    If selftest_detail:
        Do [[err_line]](selftest_detail).
        Exit with 1.
    Set root_path to [[pathlib.Path]](root_text).
    Set dir_one to [[tempfile.mkdtemp]]().
    Set dir_two to [[tempfile.mkdtemp]]().
    Set path_one to [[pathlib.Path]](dir_one).
    Set path_two to [[pathlib.Path]](dir_two).
    Set detail to "".
    Set summary to {}.
    Set asset_rels to <>.
    Set corpus to [[worktree_corpus]](root_path).
    Set result_one to [[render_tree]](corpus, path_one).
    If [[result_kind]](result_one) equals "err":
        Set detail to [[result_value]](result_one).
    Otherwise:
        Set summary to [[result_value]](result_one).
        Set asset_rels to [[summary.get]]("asset_rels", <>).
        Set result_two to [[render_tree]](corpus, path_two).
        If [[result_kind]](result_two) equals "err":
            Set detail to [[result_value]](result_two).
    If detail equals "":
        Set rel_one to [[walk_files]](path_one).
        Set rel_two to [[walk_files]](path_two).
        If rel_one does not equal rel_two:
            Set detail to "ui: render not byte-stable: tree".
    If detail equals "":
        For each rel_text in rel_one:
            If detail equals "":
                Set file_one to [[path_one.joinpath]](rel_text).
                Set file_two to [[path_two.joinpath]](rel_text).
                Set bytes_one to [[file_one.read_bytes]]().
                Set bytes_two to [[file_two.read_bytes]]().
                If bytes_one does not equal bytes_two:
                    Set detail to "ui: render not byte-stable: " plus rel_text.
                Otherwise:
                    Set copied to rel_text is in asset_rels.
                    If not copied:
                        Set page_text to [[bytes_one.decode]]("utf-8").
                        Set invariant_name to [[page_invariant_name]](page_text).
                        If invariant_name:
                            Set detail to "ui: page invariant failed: " plus rel_text plus " " plus invariant_name.
    Do [[shutil.rmtree]](dir_one, ignore_errors=True).
    Do [[shutil.rmtree]](dir_two, ignore_errors=True).
    If detail:
        Do [[err_line]](detail).
        Exit with 1.
    For each meter_line in [[summary.get]]("meter_lines", <>):
        Do [[out_line]](meter_line).
    Do [[out_line]]("ui: ok " plus [[str]]([[summary.get]]("guidelines", 0)) plus " guidelines " plus [[str]]([[summary.get]]("pages_total", 0)) plus " pages").
    Do [[out_line]]("ui: check ok").

Define [[request_command]] taking args:
    If [[len]](args) is less than 2:
        Do [[usage_fail]]().
    Set method_text to [[args.pop]](0).
    Set path_raw to [[args.pop]](0).
    Set root_text to ".".
    Set root_seen to False.
    Set headers_map to {}.
    Set body_value to None.
    Set body_seen to False.
    Set token_seen to False.
    Set now_seen to False.
    Set commit_seen to False.
    Set fault_seen to False.
    Set token_text to "".
    Set now_text to "".
    Set commit_text to "".
    Set fault_text to "".
    Set flag_names to <"--header", "--body", "--body-hex", "--token", "--now", "--commit", "--fault">.
    Set pending to "".
    Set flags_started to False.
    For each arg_text in args:
        If pending does not equal "":
            If pending equals "--header":
                Set colon_found to ":" is in arg_text.
                If not colon_found:
                    Do [[usage_fail]]().
                Set header_parts to [[arg_text.split]](":", 1).
                Set header_name to [[header_parts.pop]](0).
                Set header_value to [[header_parts.pop]](0).
                If header_name equals "":
                    Do [[usage_fail]]().
                Do [[headers_map.update]]({[[header_name.lower]](): header_value}).
            Otherwise if pending equals "--body":
                If body_seen:
                    Do [[usage_fail]]().
                Set body_value to [[arg_text.encode]]("utf-8").
                Set body_seen to True.
            Otherwise if pending equals "--body-hex":
                If body_seen:
                    Do [[usage_fail]]().
                Try:
                    Set body_value to [[bytes.fromhex]](arg_text).
                Catch ValueError:
                    Do [[usage_fail]]().
                Set body_seen to True.
            Otherwise if pending equals "--token":
                If token_seen:
                    Do [[usage_fail]]().
                Set token_text to arg_text.
                Set token_seen to True.
            Otherwise if pending equals "--now":
                If now_seen:
                    Do [[usage_fail]]().
                If not [[valid_post_date]](arg_text):
                    Do [[usage_fail]]().
                Set now_text to arg_text.
                Set now_seen to True.
            Otherwise if pending equals "--commit":
                If commit_seen:
                    Do [[usage_fail]]().
                If not [[commit_field_ok]](arg_text):
                    Do [[usage_fail]]().
                Set commit_text to arg_text.
                Set commit_seen to True.
            Otherwise:
                If fault_seen:
                    Do [[usage_fail]]().
                If arg_text does not equal "after-tmp-write":
                    Do [[usage_fail]]().
                Set fault_text to arg_text.
                Set fault_seen to True.
            Set pending to "".
        Otherwise:
            Set is_flag to arg_text is in flag_names.
            If is_flag:
                Set pending to arg_text.
                Set flags_started to True.
            Otherwise if [[arg_text.startswith]]("--"):
                Do [[usage_fail]]().
            Otherwise:
                If root_seen:
                    Do [[usage_fail]]().
                If flags_started:
                    Do [[usage_fail]]().
                Set root_text to arg_text.
                Set root_seen to True.
    If pending does not equal "":
        Do [[usage_fail]]().
    Set host_text to [[headers_map.get]]("host", "127.0.0.1:8377").
    Set origin_value to [[headers_map.get]]("origin", None).
    Set ct_fallback to "".
    If body_seen:
        Set ct_fallback to "application/x-www-form-urlencoded".
    Set ct_text to [[headers_map.get]]("content-type", ct_fallback).
    Do [[serve_config.update]]({"port": 8377}).
    Do [[serve_config.update]]({"token": token_text}).
    Do [[serve_config.update]]({"now": now_text}).
    If commit_seen:
        Do [[serve_config.update]]({"commit_pin": commit_text}).
    Do [[serve_config.update]]({"fault": fault_text}).
    Set meta to {}.
    Do [[meta.update]]({"host": host_text}).
    Do [[meta.update]]({"origin": origin_value}).
    Do [[meta.update]]({"content_type": ct_text}).
    Do [[meta.update]]({"body": body_value}).
    Set query_parts to [[path_raw.split]]("?", 1).
    Set no_query to [[query_parts.pop]](0).
    Set path_text to [[urllib.parse.unquote]](no_query).
    Set root_path to [[pathlib.Path]](root_text).
    Set corpus_result to [[resolve_corpus]](root_path).
    Set triple to None.
    If [[result_kind]](corpus_result) equals "err":
        Set triple to [[error_response]]([[result_value]](corpus_result)).
    Otherwise:
        Set corpus to [[result_value]](corpus_result).
        Set triple to [[respond]](corpus, method_text, path_text, meta).
        Do [[release_corpus]](corpus).
    Set triple_copy to [[list]](triple).
    Set status_text to [[triple_copy.pop]](0).
    Set headers to [[triple_copy.pop]](0).
    Set body_bytes to [[triple_copy.pop]](0).
    Set status_parts to [[status_text.split]](" ", 1).
    Set status_code to [[status_parts.pop]](0).
    Do [[out_line]]("HTTP " plus status_code).
    For each header_pair in headers:
        Set pair_copy to [[list]](header_pair).
        Set header_name to [[pair_copy.pop]](0).
        Set header_value to [[pair_copy.pop]](0).
        Do [[out_line]](header_name plus ": " plus header_value).
    Do [[out_line]]("").
    Do [[sys.stdout.buffer.write]](body_bytes).
    Do [[sys.stdout.buffer.flush]]().

Set argv_list to [[list]](sys.argv).
Do [[argv_list.pop]](0).
If not argv_list:
    Do [[usage_fail]]().
Set command_name to [[argv_list.pop]](0).
If command_name equals "serve":
    Do [[serve_command]](argv_list).
Otherwise if command_name equals "render":
    Do [[render_command]](argv_list).
Otherwise if command_name equals "check":
    Do [[check_ui_command]](argv_list).
Otherwise if command_name equals "request":
    Do [[request_command]](argv_list).
Otherwise:
    Do [[usage_fail]]().
