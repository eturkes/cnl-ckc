Use os.
Use pathlib.
Use re.
Use shutil.
Use subprocess.
Use sys.

Define [[fail]] taking category, detail:
    Set safe_detail to [[detail.replace]]("\n", "\\n").
    Set safe_detail to [[safe_detail.replace]]("\r", "\\r").
    Do [[print]]("goal: " plus category plus ": " plus safe_detail, file=sys.stderr).
    Exit with 2.

Define [[violation]] taking category, detail:
    Set safe_detail to [[detail.replace]]("\n", "\\n").
    Set safe_detail to [[safe_detail.replace]]("\r", "\\r").
    Do [[print]]("goal: " plus category plus ": " plus safe_detail).
    Exit with 1.

Define [[cleanup_and_fail]] taking scratch_path, category, detail:
    Do [[shutil.rmtree]](scratch_path).
    Do [[fail]](category, detail).

Define [[cleanup_violation]] taking scratch_path, category, detail:
    Do [[shutil.rmtree]](scratch_path).
    Do [[violation]](category, detail).

Define [[relay_failure]] taking scratch_path, result:
    Do [[shutil.rmtree]](scratch_path).
    Do [[sys.stderr.buffer.write]](result.stderr).
    Exit with result.returncode.

Define [[valid_docid]] taking docid:
    Set allowed to [[set]]("abcdefghijklmnopqrstuvwxyz0123456789-").
    Set chars to [[set]](docid).
    Set subset to [[chars.issubset]](allowed).
    Set leading_dash to [[docid.startswith]]("-").
    If not docid:
        Give back False.
    If leading_dash:
        Give back False.
    Give back subset.

Define [[resolve_swipl]] taking nothing:
    Set swipl to [[os.environ.get]]("SWIPL", "swipl").
    Set swipl_executable to [[shutil.which]](swipl).
    If swipl_executable equals None:
        Do [[fail]]("swipl-exec", "not executable: " plus swipl).
    Give back swipl_executable.

Define [[make_scratch]] taking nothing:
    Set pid_text to [[str]]([[os.getpid]]()).
    Set scratch_path to [[pathlib.Path]](".goal.tmp." plus pid_text).
    If [[scratch_path.exists]]():
        Do [[fail]]("scratch", "already exists: " plus [[str]](scratch_path)).
    Do [[scratch_path.mkdir]]().
    Give back scratch_path.

Define [[stage_ape]] taking scratch_path, swipl_executable:
    Set stage_path to [[scratch_path.joinpath]]("ape-stage").
    Do [[shutil.copytree]]("vendor/ape", stage_path).
    Set parser_dir to [[stage_path.joinpath]]("prolog", "parser").
    Set build_goal to "working_directory(_, '" plus [[parser_dir.as_posix]]() plus "'), [fit_to_plp], halt.".
    Set command to <swipl_executable, "-O", "-f", "none", "-F", "none", "-g", build_goal, "-t", "halt">.
    Set result to [[subprocess.run]](command, capture_output=True).
    If result.returncode does not equal 0:
        Do [[relay_failure]](scratch_path, result).
    Set grammar_path to [[parser_dir.joinpath]]("grammar.plp").
    If not [[grammar_path.is_file]]():
        Do [[cleanup_and_fail]](scratch_path, "ape-stage", "missing grammar.plp after build").
    Give back stage_path.

Define [[compiler_command]] taking swipl_executable, stage_path, tail_args:
    Set compiler_path to [[stage_path.joinpath]]("prolog", "ace_to_pl.pl").
    Set command to <swipl_executable, "-q", "-f", "none", "-F", "none", "-s", [[str]](compiler_path), "-g", "main", "-t", "halt(9)", "--">.
    For each tail_arg in tail_args:
        Do [[command.append]](tail_arg).
    Give back command.

Define [[compile_doc]] taking scratch_path, swipl_executable, stage_path, docid, ace_path, lexicon_path, extra_args:
    Set ace_bytes to [[ace_path.read_bytes]]().
    Set tail_args to <[[str]](stage_path), docid>.
    If lexicon_path does not equal None:
        Do [[tail_args.append]]([[str]](lexicon_path)).
    For each extra_arg in extra_args:
        Do [[tail_args.append]](extra_arg).
    Set command to [[compiler_command]](swipl_executable, stage_path, tail_args).
    Set result to [[subprocess.run]](command, input=ace_bytes, capture_output=True).
    If result.returncode does not equal 0:
        Do [[relay_failure]](scratch_path, result).
    If result.stderr:
        Do [[cleanup_and_fail]](scratch_path, "compiler-stderr", "non-empty stderr for document: " plus docid).
    If not result.stdout:
        Do [[cleanup_and_fail]](scratch_path, "compiler-stdout", "empty stdout for document: " plus docid).
    Set newline_bytes to [[bytes]](<10>).
    Set final_newline to [[result.stdout.endswith]](newline_bytes).
    If not final_newline:
        Do [[cleanup_and_fail]](scratch_path, "compiler-stdout", "missing final newline for document: " plus docid).
    Give back result.stdout.

Define [[check_doc_load]] taking scratch_path, swipl_executable, stage_path, pl_path:
    Set tail_args to <"check", [[str]](pl_path)>.
    Set command to [[compiler_command]](swipl_executable, stage_path, tail_args).
    Set result to [[subprocess.run]](command, capture_output=True).
    If result.returncode does not equal 0:
        Do [[relay_failure]](scratch_path, result).
    If result.stdout:
        Do [[cleanup_and_fail]](scratch_path, "check-stdout", "non-empty stdout for: " plus [[str]](pl_path)).
    If result.stderr:
        Do [[cleanup_and_fail]](scratch_path, "check-stderr", "non-empty stderr for: " plus [[str]](pl_path)).

Define [[collect_guideline]] taking guideline_path:
    Set ace_dir to [[guideline_path.joinpath]]("ace").
    Set ace_symlink to [[ace_dir.is_symlink]]().
    If ace_symlink:
        Do [[fail]]("guideline", "ace directory is a symlink: " plus [[str]](ace_dir)).
    If not [[ace_dir.is_dir]]():
        Do [[fail]]("guideline", "missing ace directory: " plus [[str]](ace_dir)).
    Set ace_paths to {}.
    Set docids to <>.
    For each entry in [[sorted]]([[ace_dir.iterdir]]()):
        Set entry_name to entry.name.
        Set regular to [[entry.is_file]]().
        Set symlink to [[entry.is_symlink]]().
        If not regular:
            Do [[fail]]("guideline", "entry is not a regular file: " plus entry_name).
        If symlink:
            Do [[fail]]("guideline", "entry is not a regular file: " plus entry_name).
        If not [[entry_name.endswith]](".ace"):
            Do [[fail]]("guideline", "unsupported ace entry: " plus entry_name).
        Set docid to [[entry_name.removesuffix]](".ace").
        If not [[valid_docid]](docid):
            Do [[fail]]("docid", "invalid document id: " plus docid).
        Do [[ace_paths.update]]({docid: entry}).
        Do [[docids.append]](docid).
    If not docids:
        Do [[fail]]("guideline", "no .ace documents in: " plus [[str]](ace_dir)).
    Set lexicon_path to [[guideline_path.joinpath]]("lexicon.ulex").
    Set lexicon_symlink to [[lexicon_path.is_symlink]]().
    If lexicon_symlink:
        Do [[fail]]("guideline", "lexicon is a symlink: " plus [[str]](lexicon_path)).
    Set lexicon_present to [[lexicon_path.is_file]]().
    If not lexicon_present:
        Set lexicon_path to None.
    Give back <ace_paths, [[sorted]](docids), lexicon_path>.

Define [[check_source_record]] taking guideline_path:
    Set readme_path to [[guideline_path.joinpath]]("README.md").
    Set readme_symlink to [[readme_path.is_symlink]]().
    If readme_symlink:
        Do [[violation]]("source-record", "README.md is a symlink under: " plus [[str]](guideline_path)).
    If not [[readme_path.is_file]]():
        Do [[violation]]("source-record", "missing README.md under: " plus [[str]](guideline_path)).
    Set source_dir to [[guideline_path.joinpath]]("source").
    Set source_symlink to [[source_dir.is_symlink]]().
    If source_symlink:
        Do [[violation]]("source-record", "source is a symlink under: " plus [[str]](guideline_path)).
    If not [[source_dir.is_dir]]():
        Do [[violation]]("source-record", "missing source directory under: " plus [[str]](guideline_path)).
    Set record_count to 0.
    For each entry in [[sorted]]([[source_dir.iterdir]]()):
        Set symlink to [[entry.is_symlink]]().
        If symlink:
            Do [[violation]]("source-record", "symlink under source: " plus entry.name).
        Set regular to [[entry.is_file]]().
        If regular:
            Set record_count to record_count plus 1.
    If record_count equals 0:
        Do [[violation]]("source-record", "no source files under: " plus [[str]](guideline_path)).

Define [[check_pl_inventory]] taking guideline_path, docids:
    Set pl_dir to [[guideline_path.joinpath]]("pl").
    Set pl_symlink to [[pl_dir.is_symlink]]().
    If pl_symlink:
        Do [[violation]]("pl-dir", "is a symlink: " plus [[str]](pl_dir)).
    If not [[pl_dir.is_dir]]():
        Do [[violation]]("missing-pl", [[str]](pl_dir)).
    Set expected_names to <>.
    For each docid in docids:
        Do [[expected_names.append]](docid plus ".pl").
    Set actual_names to <>.
    For each entry in [[sorted]]([[pl_dir.iterdir]]()):
        Set entry_name to entry.name.
        Set regular to [[entry.is_file]]().
        Set symlink to [[entry.is_symlink]]().
        If not regular:
            Do [[violation]]("pl-entry", "not a regular file: " plus entry_name).
        If symlink:
            Do [[violation]]("pl-entry", "not a regular file: " plus entry_name).
        Do [[actual_names.append]](entry_name).
    If [[sorted]](expected_names) does not equal actual_names:
        Do [[violation]]("pl-inventory", "committed pl/ does not match ace/ document set").

Define [[compiled_pl_path]] taking tracked:
    Set parts to [[tracked.split]]("/").
    If [[len]](parts) does not equal 4:
        Give back False.
    Set root_part to [[parts.pop]](0).
    Set id_part to [[parts.pop]](0).
    Set dir_part to [[parts.pop]](0).
    Set file_part to [[parts.pop]](0).
    If root_part does not equal "guidelines":
        Give back False.
    If not [[valid_docid]](id_part):
        Give back False.
    If dir_part does not equal "pl":
        Give back False.
    If not [[file_part.endswith]](".pl"):
        Give back False.
    Set stem to [[file_part.removesuffix]](".pl").
    Give back [[valid_docid]](stem).

Define [[check_prolog_inventory]] taking nothing:
    Set git_res to [[subprocess.run]](<"git", "ls-files", "--", "*.pl">, capture_output=True, check=True).
    Set tracked_text to [[git_res.stdout.decode]]("utf-8").
    For each tracked in [[sorted]]([[tracked_text.splitlines]]()):
        Set vendored to [[tracked.startswith]]("vendor/ape/").
        Set compiled to [[compiled_pl_path]](tracked).
        If not vendored:
            If not compiled:
                Do [[violation]]("prolog-inventory", "unauthorized tracked prolog: " plus tracked).

Define [[provenance_field]] taking prov_lines, key:
    Set prefix to key plus ": ".
    Set value to "".
    For each prov_line in prov_lines:
        Set starts to [[prov_line.startswith]](prefix).
        If starts:
            Set rest to [[prov_line.removeprefix]](prefix).
            Set value to [[rest.strip]]().
    Give back value.

Define [[provenance_list_field]] taking prov_lines, key:
    Set value to [[provenance_field]](prov_lines, key).
    Set items to <>.
    For each part in [[value.split]](","):
        Set item to [[part.strip]]().
        If item does not equal "":
            Do [[items.append]](item).
    Give back items.

Define [[license_requires_date]] taking tree_prefix, license_id:
    Set gpl to [[license_id.startswith]]("GPL-").
    Set lgpl to [[license_id.startswith]]("LGPL-").
    Set agpl to [[license_id.startswith]]("AGPL-").
    If gpl:
        Give back True.
    If lgpl:
        Give back True.
    If agpl:
        Give back True.
    If license_id equals "Apache-2.0":
        Give back False.
    Do [[violation]]("fork-notice", "unrecognized license in " plus tree_prefix plus ": " plus license_id).
    Give back False.

Define [[fork_notice_scan]] taking file_path:
    Set raw to [[file_path.read_bytes]]().
    Set text to [[raw.decode]]("utf-8", "replace").
    Set prominent to "".
    Set buried to "".
    Set seen to 0.
    For each line in [[text.splitlines]]():
        Set seen to seen plus 1.
        Set marks to [[line.count]]("Modified").
        Set forks to [[line.count]]("fork").
        Set hit to 0.
        If marks is greater than 0:
            If forks is greater than 0:
                Set hit to 1.
        If seen is greater than 40:
            If hit is greater than 0:
                If buried equals "":
                    Set buried to line.
        Otherwise:
            If hit is greater than 0:
                If prominent equals "":
                    Set prominent to line.
    Give back <prominent, buried>.

Define [[notice_has_date]] taking notice:
    Set hits to [[re.findall]]("[0-9]{4}-[0-9]{2}-[0-9]{2}", notice).
    Set count to [[len]](hits).
    If count is greater than 0:
        Give back True.
    Give back False.

Define [[tracked_under]] taking prefix:
    Set git_res to [[subprocess.run]](<"git", "ls-files", "--", prefix>, capture_output=True, check=True).
    Set tracked_text to [[git_res.stdout.decode]]("utf-8").
    Set items to [[tracked_text.splitlines]]().
    Give back [[sorted]](items).

Define [[touched_since]] taking import_commit, prefix:
    Set spec to import_commit plus "..HEAD".
    Set log_res to [[subprocess.run]](<"git", "log", "--name-only", "--pretty=format:", spec, "--", prefix>, capture_output=True, check=True).
    Set log_text to [[log_res.stdout.decode]]("utf-8").
    Set diff_res to [[subprocess.run]](<"git", "diff", "--name-only", "HEAD", "--", prefix>, capture_output=True, check=True).
    Set diff_text to [[diff_res.stdout.decode]]("utf-8").
    Set combined to log_text plus "\n" plus diff_text.
    Set touched to <>.
    For each log_line in [[combined.splitlines]]():
        Set item to [[log_line.strip]]().
        If item does not equal "":
            Set present to item is in touched.
            If not present:
                Do [[touched.append]](item).
    Give back touched.

Define [[check_vendor_tree]] taking tree_path:
    Set tree_prefix to [[tree_path.as_posix]]().
    Set prov_path to [[tree_path.joinpath]]("PROVENANCE").
    If not [[prov_path.is_file]]():
        Do [[violation]]("fork-notice", "missing PROVENANCE: " plus tree_prefix).
    Set prov_bytes to [[prov_path.read_bytes]]().
    Set prov_text to [[prov_bytes.decode]]("utf-8").
    Set prov_lines to [[prov_text.splitlines]]().
    Set license_id to [[provenance_field]](prov_lines, "License").
    If license_id equals "":
        Do [[violation]]("fork-notice", "PROVENANCE states no License: " plus tree_prefix).
    Set import_commit to [[provenance_field]](prov_lines, "Import commit").
    If import_commit equals "":
        Do [[violation]]("fork-notice", "PROVENANCE states no Import commit: " plus tree_prefix).
    Set needs_date to [[license_requires_date]](tree_prefix, license_id).
    Set tracked to [[tracked_under]](tree_prefix).
    Set touched to [[touched_since]](import_commit, tree_prefix).
    Set declared to [[provenance_list_field]](prov_lines, "First-party files").
    Set first_party to <>.
    For each relative in declared:
        Set declared_path to tree_prefix plus "/" plus relative.
        Set declared_tracked to declared_path is in tracked.
        If not declared_tracked:
            Do [[violation]]("fork-notice", "declared first-party file is untracked: " plus declared_path).
        Do [[first_party.append]](declared_path).
    Set modified_count to 0.
    For each tracked_path in tracked:
        Set exempt to tracked_path is in first_party.
        If not exempt:
            Set modified to tracked_path is in touched.
            If modified:
                Set modified_count to modified_count plus 1.
            Set file_path to [[pathlib.Path]](tracked_path).
            Set scan to [[fork_notice_scan]](file_path).
            Set prominent to [[scan.pop]](0).
            Set buried to [[scan.pop]](0).
            If modified:
                If prominent equals "":
                    If buried equals "":
                        Do [[violation]]("fork-notice", "modified vendored file carries no change notice: " plus tracked_path).
                    Otherwise:
                        Do [[violation]]("fork-notice", "change notice is not prominent: " plus tracked_path).
                If needs_date:
                    Set dated to [[notice_has_date]](prominent).
                    If not dated:
                        Do [[violation]]("fork-notice", "change notice states no date: " plus tracked_path).
            Otherwise:
                If prominent does not equal "":
                    Do [[violation]]("fork-notice", "unmodified vendored file carries a change notice: " plus tracked_path).
    Give back modified_count.

Define [[check_fork_notices]] taking nothing:
    Set vendor_root to [[pathlib.Path]]("vendor").
    If not [[vendor_root.is_dir]]():
        Do [[violation]]("fork-notice", "missing vendor directory").
    Set tree_count to 0.
    Set modified_total to 0.
    For each entry in [[sorted]]([[vendor_root.iterdir]]()):
        Set entry_name to [[entry.as_posix]]().
        If [[entry.is_symlink]]():
            Do [[violation]]("fork-notice", "vendor entry is a symlink: " plus entry_name).
        If not [[entry.is_dir]]():
            Do [[violation]]("fork-notice", "vendor entry is not a directory: " plus entry_name).
        Set tree_modified to [[check_vendor_tree]](entry).
        Set tree_count to tree_count plus 1.
        Set modified_total to modified_total plus tree_modified.
    If tree_count equals 0:
        Do [[violation]]("fork-notice", "no vendor trees found").
    If modified_total equals 0:
        Do [[violation]]("fork-notice", "no modified vendored files found").
    Do [[print]]("goal: fork notices ok " plus [[str]](tree_count) plus " trees " plus [[str]](modified_total) plus " modified files").

Define [[check_documents]] taking scratch_path, swipl_executable, stage_path, guideline_path, ace_paths, docids, lexicon_path:
    Set pl_dir to [[guideline_path.joinpath]]("pl").
    Set payload_dir to [[scratch_path.joinpath]]("payloads").
    If not [[payload_dir.is_dir]]():
        Do [[payload_dir.mkdir]]().
    Set manifest_pairs to <>.
    For each docid in docids:
        Set ace_path to [[ace_paths.get]](docid).
        Set extra_args to <>.
        Set first_bytes to [[compile_doc]](scratch_path, swipl_executable, stage_path, docid, ace_path, lexicon_path, extra_args).
        Set second_bytes to [[compile_doc]](scratch_path, swipl_executable, stage_path, docid, ace_path, lexicon_path, extra_args).
        If first_bytes does not equal second_bytes:
            Do [[cleanup_violation]](scratch_path, "determinism", "two compiles differ for document: " plus docid).
        Set committed_path to [[pl_dir.joinpath]](docid plus ".pl").
        Set committed_bytes to [[committed_path.read_bytes]]().
        If first_bytes does not equal committed_bytes:
            Do [[cleanup_violation]](scratch_path, "stale", "committed pl differs from fresh compile: " plus [[str]](committed_path)).
        Set proof_args to <"proof">.
        Set first_payload to [[compile_doc]](scratch_path, swipl_executable, stage_path, docid, ace_path, lexicon_path, proof_args).
        Set second_payload to [[compile_doc]](scratch_path, swipl_executable, stage_path, docid, ace_path, lexicon_path, proof_args).
        If first_payload does not equal second_payload:
            Do [[cleanup_violation]](scratch_path, "determinism", "two proof runs differ for document: " plus docid).
        Set payload_path to [[payload_dir.joinpath]](docid plus ".proof").
        Do [[payload_path.write_bytes]](first_payload).
        Do [[manifest_pairs.append]](<committed_path, payload_path>).
        Do [[check_doc_load]](scratch_path, swipl_executable, stage_path, committed_path).
    Set manifest_ids to [[manifest_document_ids]](manifest_pairs).
    If manifest_ids does not equal docids:
        Do [[cleanup_violation]](scratch_path, "aggregate-totality", "manifest documents differ from corpus documents: " plus [[str]](guideline_path)).
    Do [[check_aggregate]](scratch_path, swipl_executable, stage_path, manifest_pairs).

Define [[manifest_document_ids]] taking manifest_pairs:
    Set docid_list to <>.
    For each manifest_pair in manifest_pairs:
        Set pair_copy to [[list]](manifest_pair).
        Set pl_path to [[pair_copy.pop]](0).
        Set pl_name to pl_path.name.
        Do [[docid_list.append]]([[pl_name.removesuffix]](".pl")).
    Give back docid_list.

Define [[write_manifest]] taking manifest_path, manifest_pairs:
    Set manifest_text to "".
    For each manifest_pair in manifest_pairs:
        Set pair_copy to [[list]](manifest_pair).
        Set pl_path to [[pair_copy.pop]](0).
        Set payload_path to [[pair_copy.pop]](0).
        Set manifest_text to manifest_text plus [[str]](pl_path) plus "\t" plus [[str]](payload_path) plus "\n".
    Do [[manifest_path.write_text]](manifest_text, encoding="utf-8").

Define [[run_aggregate]] taking scratch_path, swipl_executable, stage_path, manifest_path, doc_count:
    Set tail_args to <"aggregate-check", [[str]](manifest_path)>.
    Set command to [[compiler_command]](swipl_executable, stage_path, tail_args).
    Set result to [[subprocess.run]](command, capture_output=True).
    If result.returncode does not equal 0:
        Do [[relay_failure]](scratch_path, result).
    If result.stderr:
        Do [[cleanup_and_fail]](scratch_path, "aggregate-stderr", "non-empty stderr for manifest: " plus [[str]](manifest_path)).
    Set stdout_text to [[result.stdout.decode]]("utf-8", errors="replace").
    Set expected_prefix to "ace_to_pl aggregate ok " plus [[str]](doc_count) plus " documents ".
    If not [[stdout_text.startswith]](expected_prefix):
        Do [[cleanup_violation]](scratch_path, "aggregate-report", "unexpected report: " plus [[stdout_text.strip]]()).
    If not [[stdout_text.endswith]](" obligations\n"):
        Do [[cleanup_violation]](scratch_path, "aggregate-report", "unexpected report: " plus [[stdout_text.strip]]()).
    Give back stdout_text.

Define [[run_recursion]] taking scratch_path, swipl_executable, stage_path, manifest_path, doc_count:
    Set tail_args to <"recursion-check", [[str]](manifest_path)>.
    Set command to [[compiler_command]](swipl_executable, stage_path, tail_args).
    Set result to [[subprocess.run]](command, capture_output=True).
    If result.returncode does not equal 0:
        Do [[relay_failure]](scratch_path, result).
    If result.stderr:
        Do [[cleanup_and_fail]](scratch_path, "recursion-stderr", "non-empty stderr for manifest: " plus [[str]](manifest_path)).
    Set stdout_text to [[result.stdout.decode]]("utf-8", errors="replace").
    Set expected_prefix to "ace_to_pl recursion ok " plus [[str]](doc_count) plus " documents ".
    If not [[stdout_text.startswith]](expected_prefix):
        Do [[cleanup_violation]](scratch_path, "recursion-report", "unexpected report: " plus [[stdout_text.strip]]()).
    If not [[stdout_text.endswith]](" rule clauses\n"):
        Do [[cleanup_violation]](scratch_path, "recursion-report", "unexpected report: " plus [[stdout_text.strip]]()).
    Give back stdout_text.

Define [[check_aggregate]] taking scratch_path, swipl_executable, stage_path, manifest_pairs:
    Set doc_count to [[len]](manifest_pairs).
    Set forward_path to [[scratch_path.joinpath]]("manifest-forward").
    Do [[write_manifest]](forward_path, manifest_pairs).
    Set forward_report to [[run_aggregate]](scratch_path, swipl_executable, stage_path, forward_path, doc_count).
    Set reverse_pairs to [[list]](manifest_pairs).
    Do [[reverse_pairs.reverse]]().
    Set reverse_path to [[scratch_path.joinpath]]("manifest-reverse").
    Do [[write_manifest]](reverse_path, reverse_pairs).
    Set reverse_report to [[run_aggregate]](scratch_path, swipl_executable, stage_path, reverse_path, doc_count).
    If forward_report does not equal reverse_report:
        Do [[cleanup_violation]](scratch_path, "aggregate-order", "forward and reverse manifests disagree").
    Set recursion_report to [[run_recursion]](scratch_path, swipl_executable, stage_path, forward_path, doc_count).
    Do [[print]]("goal: " plus [[recursion_report.strip]]()).

Define [[compile_command]] taking guideline_id:
    If not [[valid_docid]](guideline_id):
        Do [[fail]]("guideline", "invalid guideline id: " plus guideline_id).
    Set guidelines_root to [[pathlib.Path]]("guidelines").
    Set guideline_path to [[guidelines_root.joinpath]](guideline_id).
    Set guideline_symlink to [[guideline_path.is_symlink]]().
    If guideline_symlink:
        Do [[fail]]("guideline", "is a symlink: " plus [[str]](guideline_path)).
    If not [[guideline_path.is_dir]]():
        Do [[fail]]("guideline", "not a directory: " plus [[str]](guideline_path)).
    Set collected to [[collect_guideline]](guideline_path).
    Set ace_paths to [[collected.pop]](0).
    Set docids to [[collected.pop]](0).
    Set lexicon_path to [[collected.pop]](0).
    Set pl_dir to [[guideline_path.joinpath]]("pl").
    Set pl_symlink to [[pl_dir.is_symlink]]().
    If pl_symlink:
        Do [[fail]]("pl-dir", "is a symlink: " plus [[str]](pl_dir)).
    Set pl_exists to [[pl_dir.exists]]().
    If pl_exists:
        If not [[pl_dir.is_dir]]():
            Do [[fail]]("pl-dir", "not a directory: " plus [[str]](pl_dir)).
    Set swipl_executable to [[resolve_swipl]]().
    Set scratch_path to [[make_scratch]]().
    Set stage_path to [[stage_ape]](scratch_path, swipl_executable).
    Set outputs to {}.
    For each docid in docids:
        Set ace_path to [[ace_paths.get]](docid).
        Set extra_args to <>.
        Set pl_bytes to [[compile_doc]](scratch_path, swipl_executable, stage_path, docid, ace_path, lexicon_path, extra_args).
        Do [[outputs.update]]({docid: pl_bytes}).
    Set new_dir to [[scratch_path.joinpath]]("pl-new").
    Do [[new_dir.mkdir]]().
    For each docid in [[sorted]](outputs):
        Set payload to [[outputs.get]](docid).
        Set target to [[new_dir.joinpath]](docid plus ".pl").
        Do [[target.write_bytes]](payload).
    If pl_exists:
        Set backup_dir to [[scratch_path.joinpath]]("pl-old").
        Do [[os.rename]](pl_dir, backup_dir).
    Do [[os.rename]](new_dir, pl_dir).
    Do [[shutil.rmtree]](scratch_path).
    For each docid in [[sorted]](outputs):
        Do [[print]]("goal: wrote " plus [[str]]([[pl_dir.joinpath]](docid plus ".pl"))).
    Do [[print]]("goal: compile ok " plus [[str]]([[len]](outputs)) plus " documents").

Define [[red_probe_class]] taking probe_name:
    Set stem to [[probe_name.removesuffix]](".ace").
    Set parts to [[stem.split]]("--").
    If [[len]](parts) is greater than 1:
        Set class_name to [[parts.pop]](0).
        If class_name:
            Give back class_name.
    Do [[violation]]("red-probe", "probe name lacks <class>-- prefix: " plus probe_name).

Define [[red_expected_exit]] taking class_name:
    Set exit_one to <"input_utf8", "ape_messages", "empty_drs", "sentence_lines", "unsupported", "safety", "proof">.
    Set exit_two to <"usage", "ape_load", "ulex_load", "check_load", "uncaught">.
    Set is_one to class_name is in exit_one.
    Set is_two to class_name is in exit_two.
    If is_one:
        Give back 1.
    If is_two:
        Give back 2.
    Do [[violation]]("red-class", "unknown error class: " plus class_name).

Define [[collect_red_probes]] taking nothing:
    Set red_dir to [[pathlib.Path]]("tests/red").
    Set red_symlink to [[red_dir.is_symlink]]().
    If red_symlink:
        Do [[violation]]("red-dir", "is a symlink: " plus [[str]](red_dir)).
    If not [[red_dir.is_dir]]():
        Do [[violation]]("red-dir", "missing: " plus [[str]](red_dir)).
    Set probes to <>.
    Set ace_stems to <>.
    Set ulex_stems to <>.
    Set expect_stems to <>.
    For each entry in [[sorted]]([[red_dir.iterdir]]()):
        Set entry_name to entry.name.
        Set regular to [[entry.is_file]]().
        Set symlink to [[entry.is_symlink]]().
        If not regular:
            Do [[violation]]("red-entry", "not a regular file: " plus entry_name).
        If symlink:
            Do [[violation]]("red-entry", "not a regular file: " plus entry_name).
        Set is_ace to [[entry_name.endswith]](".ace").
        Set is_ulex to [[entry_name.endswith]](".ulex").
        Set is_expect to [[entry_name.endswith]](".expect").
        If is_ace:
            Set class_name to [[red_probe_class]](entry_name).
            Set expected_exit to [[red_expected_exit]](class_name).
            Set probe_record to <entry, class_name, expected_exit>.
            Do [[probes.append]](probe_record).
            Do [[ace_stems.append]]([[entry_name.removesuffix]](".ace")).
        Otherwise:
            If is_ulex:
                Do [[ulex_stems.append]]([[entry_name.removesuffix]](".ulex")).
            Otherwise:
                If is_expect:
                    Do [[expect_stems.append]]([[entry_name.removesuffix]](".expect")).
                Otherwise:
                    Do [[violation]]("red-entry", "unsupported entry: " plus entry_name).
    For each ulex_stem in ulex_stems:
        Set paired to ulex_stem is in ace_stems.
        If not paired:
            Do [[violation]]("red-entry", "orphan ulex without ace probe: " plus ulex_stem).
    For each expect_stem in expect_stems:
        Set expect_paired to expect_stem is in ace_stems.
        If not expect_paired:
            Do [[violation]]("red-entry", "orphan expect without ace probe: " plus expect_stem).
    For each ace_stem in ace_stems:
        Set pinned to ace_stem is in expect_stems.
        If not pinned:
            Do [[violation]]("red-entry", "probe lacks expect pin: " plus ace_stem).
    If not probes:
        Do [[violation]]("red-dir", "no red probes found").
    Give back probes.

Define [[run_red_probe]] taking scratch_path, swipl_executable, stage_path, probe_path, class_name, expected_exit:
    Set probe_name to probe_path.name.
    Set probe_bytes to [[probe_path.read_bytes]]().
    Set lexicon_path to [[probe_path.with_suffix]](".ulex").
    Set lexicon_present to [[lexicon_path.is_file]]().
    Set tail_args to <[[str]](stage_path), "red-probe">.
    If lexicon_present:
        Do [[tail_args.append]]([[str]](lexicon_path)).
    Set command to [[compiler_command]](swipl_executable, stage_path, tail_args).
    Set result to [[subprocess.run]](command, input=probe_bytes, capture_output=True).
    If result.returncode does not equal expected_exit:
        Do [[cleanup_violation]](scratch_path, "red-exit", "status " plus [[str]](result.returncode) plus " for probe: " plus probe_name).
    If result.stdout:
        Do [[cleanup_violation]](scratch_path, "red-stdout", "non-empty stdout for probe: " plus probe_name).
    Set newline_bytes to [[bytes]](<10>).
    Set newline_count to [[result.stderr.count]](newline_bytes).
    Set final_newline to [[result.stderr.endswith]](newline_bytes).
    If newline_count does not equal 1:
        Do [[cleanup_violation]](scratch_path, "red-stderr", "stderr is not one LF line for probe: " plus probe_name).
    If not final_newline:
        Do [[cleanup_violation]](scratch_path, "red-stderr", "stderr is not one LF line for probe: " plus probe_name).
    Set expect_path to [[probe_path.with_suffix]](".expect").
    Set expect_present to [[expect_path.is_file]]().
    If not expect_present:
        Do [[cleanup_violation]](scratch_path, "red-expect", "missing expect pin for probe: " plus probe_name).
    Set expect_bytes to [[expect_path.read_bytes]]().
    If result.stderr does not equal expect_bytes:
        Do [[cleanup_violation]](scratch_path, "red-expect", "stderr differs from expect pin for probe: " plus probe_name).
    Set stderr_text to [[result.stderr.decode]]("utf-8", errors="replace").
    Set expected_prefix to "ace_to_pl_error(" plus class_name plus ",".
    If not [[stderr_text.startswith]](expected_prefix):
        Do [[cleanup_violation]](scratch_path, "red-class", "stderr class mismatch for probe: " plus probe_name).
    If not [[stderr_text.endswith]](").\n"):
        Do [[cleanup_violation]](scratch_path, "red-stderr", "stderr lacks canonical term suffix for probe: " plus probe_name).

Set bal_pattern to "(?:[^()]|\\([^()]*\\))*".
Set access_rx to [[re.compile]]("^(open|unverified|paywalled\\([^)]+\\)|login\\([^)]+\\))$").
Set status_rx to [[re.compile]]("^(unqueued|provisional\\(" plus bal_pattern plus "\\)|queued|in-progress|done|blocked\\(" plus bal_pattern plus "\\)|excluded\\(" plus bal_pattern plus "\\))$").
Set swept_rx to [[re.compile]]("^(pending|-|\\d{4}-\\d{2}-\\d{2} .+|blocked\\(" plus bal_pattern plus "\\))$").
Set year_rx to [[re.compile]]("\\((\\d{4})(;\\s*pub\\s*(\\d{4}))?\\)\\s*$").
Set token_rx to [[re.compile]]("guestAccessKey|accessKey=|token=").
Set org_header to <"org", "abbrev", "class", "CPGs", "index URL", "enum sources", "swept">.
Set row_header to "org\ttitle (year)\tURL\taccess\tstatus\tnotes".
Set class_names to <"federal", "society", "other">.
Set cpgs_names to <"yes", "unverified", "no">.

Define [[read_compendium_file]] taking path_text:
    Set file_path to [[pathlib.Path]](path_text).
    If [[file_path.is_symlink]]():
        Do [[fail]]("compendium", "is a symlink: " plus path_text).
    If not [[file_path.is_file]]():
        Do [[fail]]("compendium", "missing: " plus path_text).
    Give back [[file_path.read_text]](encoding="utf-8").

Define [[org_section_text]] taking comp_text:
    Set head_parts to [[comp_text.split]]("\n## Organizations\n", 1).
    If [[len]](head_parts) does not equal 2:
        Do [[violation]]("compendium-org-table", "missing `## Organizations` section in .agent/compendium.md").
    Do [[head_parts.pop]](0).
    Set tail_text to [[head_parts.pop]](0).
    Set tail_parts to [[tail_text.split]]("\n## Guidelines\n", 1).
    Set section_text to [[tail_parts.pop]](0).
    Give back section_text.

Define [[org_table_rows]] taking section_text:
    Set rows to <>.
    Set seen_header to False.
    Set separator_chars to [[set]]("- ").
    For each raw_line in [[section_text.split]]("\n"):
        Set line_text to [[raw_line.strip]]().
        Set starts_pipe to [[line_text.startswith]]("|").
        Set ends_pipe to [[line_text.endswith]]("|").
        If starts_pipe:
            If ends_pipe:
                Set inner_text to [[line_text.removeprefix]]("|").
                Set inner_text to [[inner_text.removesuffix]]("|").
                Set cell_list to <>.
                For each cell_text in [[inner_text.split]]("|"):
                    Do [[cell_list.append]]([[cell_text.strip]]()).
                If not seen_header:
                    If cell_list does not equal org_header:
                        Do [[violation]]("compendium-org-table", "organization table header mismatch").
                    Set seen_header to True.
                Otherwise:
                    Set joined_text to "".
                    For each cell_text in cell_list:
                        Set joined_text to joined_text plus cell_text.
                    Set joined_chars to [[set]](joined_text).
                    Set is_separator to [[joined_chars.issubset]](separator_chars).
                    If not is_separator:
                        If [[len]](cell_list) does not equal 7:
                            Do [[violation]]("compendium-org-table", "organization row without 7 cells: " plus line_text).
                        Do [[rows.append]](cell_list).
    If not seen_header:
        Do [[violation]]("compendium-org-table", "organization table absent - no header row found").
    If not rows:
        Do [[violation]]("compendium-org-table", "organization table holds no rows").
    Give back rows.

Define [[check_compendium_orgs]] taking orows:
    Set org_class to {}.
    Set seen_names to {}.
    Set remaining to 0.
    Set order_keys to <>.
    For each row_cells in orows:
        Set cells_copy to [[list]](row_cells).
        Set org_name to [[cells_copy.pop]](0).
        Set abbrev_cell to [[cells_copy.pop]](0).
        Set class_cell to [[cells_copy.pop]](0).
        Set cpgs_cell to [[cells_copy.pop]](0).
        Set index_cell to [[cells_copy.pop]](0).
        Set sources_cell to [[cells_copy.pop]](0).
        Set swept_cell to [[cells_copy.pop]](0).
        If not org_name:
            Do [[violation]]("compendium-org", "empty org cell in organization row").
        If not class_cell:
            Do [[violation]]("compendium-org", "empty class cell for: " plus org_name).
        If not cpgs_cell:
            Do [[violation]]("compendium-org", "empty CPGs cell for: " plus org_name).
        Set class_known to class_cell is in class_names.
        If not class_known:
            Do [[violation]]("compendium-org", "bad class `" plus class_cell plus "` for: " plus org_name).
        Set cpgs_known to cpgs_cell is in cpgs_names.
        If not cpgs_known:
            Do [[violation]]("compendium-org", "bad CPGs `" plus cpgs_cell plus "` for: " plus org_name).
        Set dup_org to org_name is in seen_names.
        If dup_org:
            Do [[violation]]("compendium-org", "duplicate organization row: " plus org_name).
        Do [[seen_names.update]]({org_name: True}).
        If not [[swept_rx.match]](swept_cell):
            Do [[violation]]("compendium-org", "bad swept `" plus swept_cell plus "` for: " plus org_name).
        Do [[org_class.update]]({org_name: class_cell}).
        Set class_rank to [[class_names.index]](class_cell).
        Set cpgs_rank to [[cpgs_names.index]](cpgs_cell).
        Set folded_name to [[org_name.casefold]]().
        Set order_key to <class_rank, cpgs_rank, folded_name>.
        Do [[order_keys.append]](<order_key, org_name>).
        Set is_blocked to [[swept_cell.startswith]]("blocked(").
        Set is_dated to True.
        If swept_cell equals "pending":
            Set is_dated to False.
        If swept_cell equals "-":
            Set is_dated to False.
        If is_blocked:
            Set is_dated to False.
        Set terminal to False.
        If cpgs_cell equals "no":
            Set terminal to True.
        If is_blocked:
            Set terminal to True.
        If is_dated:
            Set terminal to True.
        If not terminal:
            Set remaining to remaining plus 1.
    Set prev_key to None.
    Set prev_bound to False.
    For each key_record in order_keys:
        Set record_copy to [[list]](key_record).
        Set current_key to [[record_copy.pop]](0).
        Set current_name to [[record_copy.pop]](0).
        If prev_bound:
            Set out_of_order to current_key is less than prev_key.
            If out_of_order:
                Do [[violation]]("compendium-org-order", "organization order violates class -> CPGs -> alpha at: " plus current_name).
        Set prev_key to current_key.
        Set prev_bound to True.
    Give back <org_class, remaining>.

Define [[load_compendium_rows]] taking tsv_text:
    Set line_list to [[tsv_text.split]]("\n").
    Set header_line to [[line_list.pop]](0).
    If header_line does not equal row_header:
        Do [[violation]]("compendium-tsv", "first line of .agent/compendium.tsv is not the 6-column header").
    Set rows to <>.
    For each line_text in line_list:
        If line_text:
            Set cell_list to [[line_text.split]]("\t").
            If [[len]](cell_list) does not equal 6:
                Set first_cell to [[cell_list.pop]](0).
                Do [[violation]]("compendium-tsv", "row without 6 cells starting: " plus first_cell).
            Do [[rows.append]](cell_list).
    Give back rows.

Define [[check_compendium_rows]] taking grows, org_class:
    Set active_count to 0.
    Set remaining to 0.
    Set provisional_count to 0.
    Set seen_rows to {}.
    Set url_titles to {}.
    Set order_keys to <>.
    For each row_cells in grows:
        Set cells_copy to [[list]](row_cells).
        Set org_cell to [[cells_copy.pop]](0).
        Set title_cell to [[cells_copy.pop]](0).
        Set url_cell to [[cells_copy.pop]](0).
        Set access_cell to [[cells_copy.pop]](0).
        Set status_cell to [[cells_copy.pop]](0).
        Set notes_cell to [[cells_copy.pop]](0).
        If not [[access_rx.match]](access_cell):
            Do [[violation]]("compendium-row", "bad access `" plus access_cell plus "` for: " plus title_cell).
        If not [[status_rx.match]](status_cell):
            Do [[violation]]("compendium-row", "bad status `" plus status_cell plus "` for: " plus title_cell).
        Set year_match to [[year_rx.search]](title_cell).
        If not year_match:
            Do [[violation]]("compendium-row", "title lacks terminal (year): " plus title_cell).
        If not org_cell:
            Do [[violation]]("compendium-row", "empty org cell for: " plus title_cell).
        If not title_cell:
            Do [[violation]]("compendium-row", "empty title cell").
        If not url_cell:
            Do [[violation]]("compendium-row", "empty URL cell for: " plus title_cell).
        Set is_http to [[url_cell.startswith]]("http://").
        Set is_https to [[url_cell.startswith]]("https://").
        If not (is_http or is_https):
            Do [[violation]]("compendium-row", "URL lacks http(s) scheme: " plus url_cell).
        If [[token_rx.search]](url_cell):
            Do [[violation]]("compendium-row", "capability-token URL: " plus url_cell).
        Set is_queued to status_cell equals "queued".
        Set is_progress to status_cell equals "in-progress".
        If is_queued or is_progress:
            Set active_count to active_count plus 1.
        Set is_provisional to [[status_cell.startswith]]("provisional(").
        Set is_excluded to [[status_cell.startswith]]("excluded(").
        If access_cell equals "unverified":
            If not (is_provisional or is_excluded):
                Do [[violation]]("compendium-row", "unverified access must be provisional(...) or excluded(...): " plus title_cell).
        If status_cell equals "unqueued":
            Set has_unresolved to "unresolved" is in notes_cell.
            If has_unresolved:
                Do [[violation]]("compendium-row", "unresolved row must not be unqueued: " plus title_cell).
        Set is_done to status_cell equals "done".
        Set is_blocked_row to [[status_cell.startswith]]("blocked(").
        Set row_terminal to False.
        If is_done:
            Set row_terminal to True.
        If is_blocked_row:
            Set row_terminal to True.
        If is_excluded:
            Set row_terminal to True.
        If not row_terminal:
            Set remaining to remaining plus 1.
        If is_provisional:
            Set provisional_count to provisional_count plus 1.
        Set folded_title to [[title_cell.casefold]]().
        Set row_key to folded_title plus "\t" plus url_cell.
        Set dup_row to row_key is in seen_rows.
        If dup_row:
            Do [[violation]]("compendium-dup", "duplicate guideline row: " plus title_cell).
        Do [[seen_rows.update]]({row_key: True}).
        Set url_seen to url_cell is in url_titles.
        If url_seen:
            Set prior_title to [[url_titles.get]](url_cell).
            If prior_title does not equal folded_title:
                Do [[violation]]("compendium-dup", "URL shared by two rows: " plus url_cell).
        Do [[url_titles.update]]({url_cell: folded_title}).
        Set band to 1.
        If access_cell equals "open":
            Set band to 0.
        Set org_parts to [[org_cell.split]]("+").
        Set first_part to [[org_parts.pop]](0).
        Set first_org to [[first_part.strip]]().
        Set first_class to [[org_class.get]](first_org, "other").
        Set class_rank to [[class_names.index]](first_class).
        Set year_text to [[year_match.group]](1).
        Set year_value to [[int]](year_text).
        Set year_key to 0 minus year_value.
        Set folded_org to [[org_cell.casefold]]().
        Set order_key to <band, class_rank, folded_org, year_key, folded_title>.
        Do [[order_keys.append]](<order_key, title_cell>).
    If active_count is greater than 1:
        Do [[violation]]("compendium-active", [[str]](active_count) plus " rows queued|in-progress (max 1)").
    Set prev_key to None.
    Set prev_bound to False.
    For each key_record in order_keys:
        Set record_copy to [[list]](key_record).
        Set current_key to [[record_copy.pop]](0).
        Set current_title to [[record_copy.pop]](0).
        If prev_bound:
            Set out_of_order to current_key is less than prev_key.
            If out_of_order:
                Do [[violation]]("compendium-row-order", "guideline order violates access -> class -> org -> year desc -> title at: " plus current_title).
        Set prev_key to current_key.
        Set prev_bound to True.
    Give back <remaining, provisional_count>.

Define [[check_compendium]] taking nothing:
    Set comp_text to [[read_compendium_file]](".agent/compendium.md").
    Set tsv_text to [[read_compendium_file]](".agent/compendium.tsv").
    Set section_text to [[org_section_text]](comp_text).
    Set orows to [[org_table_rows]](section_text).
    Set org_count to [[len]](orows).
    Set org_result to [[check_compendium_orgs]](orows).
    Set org_class to [[org_result.pop]](0).
    Set orgs_remaining to [[org_result.pop]](0).
    Set grows to [[load_compendium_rows]](tsv_text).
    Set row_count to [[len]](grows).
    Set row_result to [[check_compendium_rows]](grows, org_class).
    Set rows_remaining to [[row_result.pop]](0).
    Set provisional_count to [[row_result.pop]](0).
    Set summary to "goal: compendium ok " plus [[str]](org_count) plus " organizations " plus [[str]](row_count) plus " rows; terminal remaining: orgs=" plus [[str]](orgs_remaining) plus " rows=" plus [[str]](rows_remaining) plus " provisional=" plus [[str]](provisional_count).
    Do [[print]](summary).

Set projection_header_text to "# format: docid<TAB>region<TAB>kept<TAB>dropped\n# per-document projection loss record: what each minimal rule keeps from its verbatim source\n# region and what it drops or interprets. Header bytes, row shape and per-document row\n# coverage are validated by goal.py check; kept/dropped prose stays document-owned.".
Set coverage_header_text to "# format: id<TAB>file<TAB>page<TAB>section<TAB>status\n# status: ace(<docid>) | restates(<id>) | uncovered(<class>: <one-clause reason>) | pending\n# uncovered classes: heading | process | external | aim | descriptive | notice".
Set uncovered_class_names to <"heading", "process", "external", "aim", "descriptive", "notice">.
Set census_rx to [[re.compile]]("identify the ([0-9]+) payloads below").
Set v1_functors to <"guideline_schema_version", "guideline_document", "guideline_entity", "guideline_cardinality", "guideline_event", "guideline_arg", "guideline_pp", "guideline_property", "guideline_operator">.
Set v1_directives to <"guideline_schema_version/1", "guideline_document/3", "guideline_entity/4", "guideline_cardinality/5", "guideline_event/3", "guideline_arg/4", "guideline_pp/4", "guideline_property/4", "guideline_operator/3">.
Set v1_decl_kinds to <"multifile", "discontiguous">.
Set token_strip_chars to ".,;:?!\"()".
Set clex_path_text to "vendor/ape/prolog/lexicon/clex_lexicon.pl".

Define [[read_corpus_file]] taking file_path, category:
    If [[file_path.is_symlink]]():
        Do [[violation]](category, "is a symlink: " plus [[str]](file_path)).
    If not [[file_path.is_file]]():
        Do [[violation]](category, "missing: " plus [[str]](file_path)).
    Give back [[file_path.read_bytes]]().

Define [[check_projection_ledger]] taking guideline_path:
    Set ledger_path to [[guideline_path.joinpath]]("audit", "projection-notes.tsv").
    Set data to [[read_corpus_file]](ledger_path, "projection-ledger").
    Set text to [[data.decode]]("utf-8").
    If "\r" is in text:
        Do [[violation]]("projection-ledger", "carriage return byte in ledger").
    If not [[text.endswith]]("\n"):
        Do [[violation]]("projection-ledger", "ledger lacks final newline").
    Set expected_header to projection_header_text plus "\n".
    If not [[text.startswith]](expected_header):
        Do [[violation]]("projection-ledger", "header bytes drift").
    Set body to [[text.removeprefix]](expected_header).
    Set row_lines to [[body.split]]("\n").
    Do [[row_lines.pop]]().
    If not row_lines:
        Do [[violation]]("projection-ledger", "ledger holds no rows").
    Set seen_docids to {}.
    Set row_docids to <>.
    For each row_line in row_lines:
        Set fields to [[row_line.split]]("\t").
        If [[len]](fields) does not equal 4:
            Do [[violation]]("projection-ledger", "row without 4 columns: " plus row_line).
        Set docid to [[fields.pop]](0).
        Set region to [[fields.pop]](0).
        Set kept to [[fields.pop]](0).
        Set dropped to [[fields.pop]](0).
        If not [[valid_docid]](docid):
            Do [[violation]]("projection-ledger", "invalid docid: " plus docid).
        If not region:
            Do [[violation]]("projection-ledger", "empty region for: " plus docid).
        If not kept:
            Do [[violation]]("projection-ledger", "empty kept column for: " plus docid).
        If not dropped:
            Do [[violation]]("projection-ledger", "empty dropped column for: " plus docid).
        Set duplicate to docid is in seen_docids.
        If duplicate:
            Do [[violation]]("projection-ledger", "duplicate row docid: " plus docid).
        Do [[seen_docids.update]]({docid: True}).
        Do [[row_docids.append]](docid).
    Give back row_docids.

Define [[coverage_status_kind]] taking row_id, status_text:
    If status_text equals "pending":
        Give back <"pending", "">.
    If [[status_text.startswith]]("ace("):
        Set closed to [[status_text.endswith]](")").
        If not closed:
            Do [[violation]]("coverage", "malformed status for " plus row_id plus ": " plus status_text).
        Set inner to [[status_text.removeprefix]]("ace(").
        Set inner to [[inner.removesuffix]](")").
        If not [[valid_docid]](inner):
            Do [[violation]]("coverage", "ace names invalid docid for " plus row_id plus ": " plus inner).
        Give back <"ace", inner>.
    If [[status_text.startswith]]("restates("):
        Set closed to [[status_text.endswith]](")").
        If not closed:
            Do [[violation]]("coverage", "malformed status for " plus row_id plus ": " plus status_text).
        Set inner to [[status_text.removeprefix]]("restates(").
        Set inner to [[inner.removesuffix]](")").
        If not inner:
            Do [[violation]]("coverage", "empty restates target for " plus row_id).
        Give back <"restates", inner>.
    If [[status_text.startswith]]("uncovered("):
        Set closed to [[status_text.endswith]](")").
        If not closed:
            Do [[violation]]("coverage", "malformed status for " plus row_id plus ": " plus status_text).
        Set inner to [[status_text.removeprefix]]("uncovered(").
        Set inner to [[inner.removesuffix]](")").
        Set parts to [[inner.split]](": ", 1).
        If [[len]](parts) does not equal 2:
            Do [[violation]]("coverage", "uncovered without class and reason for " plus row_id plus ": " plus status_text).
        Set class_name to [[parts.pop]](0).
        Set reason_text to [[parts.pop]](0).
        Set known_class to class_name is in uncovered_class_names.
        If not known_class:
            Do [[violation]]("coverage", "unknown uncovered class for " plus row_id plus ": " plus class_name).
        If not reason_text:
            Do [[violation]]("coverage", "empty uncovered reason for " plus row_id).
        Give back <"uncovered", class_name>.
    Do [[violation]]("coverage", "unknown status for " plus row_id plus ": " plus status_text).

Define [[evidence_regions]] taking evidence_path:
    Set data to [[read_corpus_file]](evidence_path, "coverage").
    Set text to [[data.decode]]("utf-8").
    Set census_hit to [[census_rx.search]](text).
    If census_hit equals None:
        Do [[violation]]("coverage", "evidence lacks region-authority census: " plus [[str]](evidence_path)).
    Set census_text to [[census_hit.group]](1).
    Set census_count to [[int]](census_text).
    Set locator_ids to <>.
    For each raw_line in [[text.split]]("\n"):
        Set bracketed to [[raw_line.startswith]]("[").
        If bracketed:
            Set closed to [[raw_line.endswith]]("]").
            Set delimited to " | " is in raw_line.
            If closed:
                If delimited:
                    Set body_text to [[raw_line.removeprefix]]("[").
                    Set parts to [[body_text.split]](" | ").
                    Set region_id to [[parts.pop]](0).
                    Set spaced to " " is in region_id.
                    If region_id:
                        If not spaced:
                            Do [[locator_ids.append]](region_id).
    Give back <census_count, locator_ids>.

Define [[check_coverage]] taking guideline_path, docids:
    Set coverage_path to [[guideline_path.joinpath]]("coverage.tsv").
    Set data to [[read_corpus_file]](coverage_path, "coverage").
    Set text to [[data.decode]]("utf-8").
    If "\r" is in text:
        Do [[violation]]("coverage", "carriage return byte in ledger").
    If not [[text.endswith]]("\n"):
        Do [[violation]]("coverage", "ledger lacks final newline").
    Set expected_header to coverage_header_text plus "\n".
    If not [[text.startswith]](expected_header):
        Do [[violation]]("coverage", "header bytes drift").
    Set body to [[text.removeprefix]](expected_header).
    Set row_lines to [[body.split]]("\n").
    Do [[row_lines.pop]]().
    Set docid_known to {}.
    For each docid in docids:
        Do [[docid_known.update]]({docid: True}).
    Set comment_zone to True.
    Set row_count to 0.
    Set ace_count to 0.
    Set restates_count to 0.
    Set uncovered_count to 0.
    Set pending_count to 0.
    Set status_by_id to {}.
    Set ace_claims to {}.
    Set restates_rows to <>.
    Set restates_targets to <>.
    Set file_order to <>.
    Set file_ids to {}.
    For each row_line in row_lines:
        Set is_comment to [[row_line.startswith]]("#").
        If is_comment:
            If not comment_zone:
                Do [[violation]]("coverage", "comment line after rows: " plus row_line).
        Otherwise:
            Set comment_zone to False.
            Set fields to [[row_line.split]]("\t").
            If [[len]](fields) does not equal 5:
                Do [[violation]]("coverage", "row without 5 columns: " plus row_line).
            Set row_id to [[fields.pop]](0).
            Set file_field to [[fields.pop]](0).
            Set page_field to [[fields.pop]](0).
            Set section_field to [[fields.pop]](0).
            Set status_field to [[fields.pop]](0).
            If not row_id:
                Do [[violation]]("coverage", "empty region id: " plus row_line).
            Set spaced_id to " " is in row_id.
            If spaced_id:
                Do [[violation]]("coverage", "region id holds a space: " plus row_id).
            Set under_source to [[file_field.startswith]]("source/").
            If not under_source:
                Do [[violation]]("coverage", "file outside source/ for " plus row_id plus ": " plus file_field).
            Set dotted to ".." is in file_field.
            If dotted:
                Do [[violation]]("coverage", "file path traversal for " plus row_id plus ": " plus file_field).
            If not page_field:
                Do [[violation]]("coverage", "empty page for: " plus row_id).
            If not section_field:
                Do [[violation]]("coverage", "empty section for: " plus row_id).
            Set duplicate to row_id is in status_by_id.
            If duplicate:
                Do [[violation]]("coverage", "duplicate region id: " plus row_id).
            Do [[status_by_id.update]]({row_id: status_field}).
            Set known_file to file_field is in file_ids.
            If not known_file:
                Do [[file_order.append]](file_field).
                Set empty_ids to <>.
                Do [[file_ids.update]]({file_field: empty_ids}).
            Set claimed_ids to [[file_ids.get]](file_field).
            Do [[claimed_ids.append]](row_id).
            Set parsed to [[coverage_status_kind]](row_id, status_field).
            Set kind to [[parsed.pop]](0).
            Set payload to [[parsed.pop]](0).
            Set row_count to row_count plus 1.
            If kind equals "pending":
                Set pending_count to pending_count plus 1.
            If kind equals "ace":
                Set ace_count to ace_count plus 1.
                Set claimed_before to payload is in ace_claims.
                If claimed_before:
                    Do [[violation]]("coverage", "docid claimed by two rows: " plus payload).
                Set known_docid to payload is in docid_known.
                If not known_docid:
                    Do [[violation]]("coverage", "ace names unknown docid for " plus row_id plus ": " plus payload).
                Do [[ace_claims.update]]({payload: True}).
            If kind equals "restates":
                Set restates_count to restates_count plus 1.
                Do [[restates_rows.append]](row_id).
                Do [[restates_targets.append]](payload).
            If kind equals "uncovered":
                Set uncovered_count to uncovered_count plus 1.
    If row_count equals 0:
        Do [[violation]]("coverage", "ledger holds no rows").
    For each target_id in restates_targets:
        Set row_id to [[restates_rows.pop]](0).
        If target_id equals row_id:
            Do [[violation]]("coverage", "restates itself: " plus row_id).
        Set target_status to [[status_by_id.get]](target_id, "").
        If not target_status:
            Do [[violation]]("coverage", "restates unknown region for " plus row_id plus ": " plus target_id).
        Set chained to [[target_status.startswith]]("restates(").
        If chained:
            Do [[violation]]("coverage", "restates a restatement for " plus row_id plus ": " plus target_id).
    For each docid in docids:
        Set claimed to docid is in ace_claims.
        If not claimed:
            Do [[violation]]("coverage", "docid without a coverage row: " plus docid).
    For each file_field in file_order:
        Set evidence_path to [[guideline_path.joinpath]](file_field).
        Set region_info to [[evidence_regions]](evidence_path).
        Set census_count to [[region_info.pop]](0).
        Set locator_ids to [[region_info.pop]](0).
        Set claimed_ids to [[file_ids.get]](file_field).
        Set claimed_count to [[len]](claimed_ids).
        If claimed_count does not equal census_count:
            Do [[violation]]("coverage", "rows " plus [[str]](claimed_count) plus " differ from census " plus [[str]](census_count) plus " for: " plus file_field).
        If locator_ids:
            Set locator_count to [[len]](locator_ids).
            If locator_count does not equal census_count:
                Do [[violation]]("coverage", "locators " plus [[str]](locator_count) plus " differ from census " plus [[str]](census_count) plus " for: " plus file_field).
            Set locator_known to {}.
            For each region_id in locator_ids:
                Set seen_before to region_id is in locator_known.
                If seen_before:
                    Do [[violation]]("coverage", "duplicate evidence locator: " plus region_id).
                Do [[locator_known.update]]({region_id: True}).
            For each claimed_id in claimed_ids:
                Set anchored to claimed_id is in locator_known.
                If not anchored:
                    Do [[violation]]("coverage", "coverage row without evidence region: " plus claimed_id).
    Set meter to "goal: coverage ok " plus guideline_path.name plus " " plus [[str]](row_count) plus " regions; ace=" plus [[str]](ace_count) plus " restates=" plus [[str]](restates_count) plus " uncovered=" plus [[str]](uncovered_count) plus " pending=" plus [[str]](pending_count).
    Do [[print]](meter).

Define [[lexicon_entry]] taking line_text:
    Set head_parts to [[line_text.split]]("(", 1).
    Set kind to [[head_parts.pop]](0).
    If [[len]](head_parts) does not equal 1:
        Do [[violation]]("lexicon-entry", "malformed entry: " plus line_text).
    Set rest to [[head_parts.pop]](0).
    Set quoted to [[rest.split]]("'").
    Set surface to "".
    Set lemma to "".
    If [[len]](quoted) is greater than 3:
        Do [[quoted.pop]](0).
        Set surface to [[quoted.pop]](0).
        Do [[quoted.pop]](0).
        Set lemma to [[quoted.pop]](0).
    Otherwise:
        Set plain to [[rest.split]](",").
        If [[len]](plain) is less than 2:
            Do [[violation]]("lexicon-entry", "malformed entry: " plus line_text).
        Set surface to [[plain.pop]](0).
        Set lemma to [[plain.pop]](0).
    Give back <kind, surface, lemma>.

Define [[ace_token_set]] taking ace_paths, docids:
    Set tokens to {}.
    For each docid in docids:
        Set ace_path to [[ace_paths.get]](docid).
        Set text to [[ace_path.read_text]](encoding="utf-8").
        For each raw_token in [[text.split]]():
            Set token to [[raw_token.strip]](token_strip_chars).
            Do [[tokens.update]]({token: True}).
    Give back tokens.

Define [[normalized_lexicon_entry]] taking line_text:
    Set text to [[line_text.strip]]().
    Set text to [[text.removesuffix]](".").
    Set text to [[text.replace]]("'", "").
    Set text to [[text.replace]](" ", "").
    Set text to [[text.replace]]("\t", "").
    Give back text.

Define [[clex_entry_maps]] taking nothing:
    Set clex_path to [[pathlib.Path]](clex_path_text).
    Set data to [[read_corpus_file]](clex_path, "clex-file").
    Set text to [[data.decode]]("utf-8").
    Set entries to {}.
    Set surfaces to {}.
    For each raw_line in [[text.split]]("\n"):
        Set line_text to [[raw_line.strip]]().
        If line_text:
            Set is_comment to [[line_text.startswith]]("%").
            Set is_directive to [[line_text.startswith]](":-").
            If not is_comment:
                If not is_directive:
                    Set normalized to [[normalized_lexicon_entry]](line_text).
                    Do [[entries.update]]({normalized: True}).
                    Set fact to [[lexicon_entry]](line_text).
                    Set fact_copy to [[list]](fact).
                    Set fact_kind to [[fact_copy.pop]](0).
                    Set fact_surface to [[fact_copy.pop]](0).
                    Set surface_known to fact_surface is in surfaces.
                    If not surface_known:
                        Do [[surfaces.update]]({fact_surface: <>}).
                    Set surface_list to [[surfaces.get]](fact_surface).
                    Set fact_present to normalized is in surface_list.
                    If not fact_present:
                        Do [[surface_list.append]](normalized).
    Give back <entries, surfaces>.

Set shadow_ruling_header to "ulex_entry\tclex_entries\truling".

Define [[lexicon_shadow_rulings]] taking guideline_path:
    Set rulings_path to [[guideline_path.joinpath]]("audit", "lexicon-shadow.tsv").
    Set rulings to {}.
    If [[rulings_path.is_symlink]]():
        Do [[violation]]("lexicon-shadow-file", "is a symlink: " plus [[str]](rulings_path)).
    If not [[rulings_path.is_file]]():
        Give back rulings.
    Set data to [[read_corpus_file]](rulings_path, "lexicon-shadow-file").
    Set text to [[data.decode]]("utf-8").
    Set line_list to [[text.split]]("\n").
    Set header_line to [[line_list.pop]](0).
    If header_line does not equal shadow_ruling_header:
        Do [[violation]]("lexicon-shadow-file", "first line is not the 3-column header: " plus [[str]](rulings_path)).
    For each line_text in line_list:
        If line_text:
            Set cell_list to [[line_text.split]]("\t").
            If [[len]](cell_list) does not equal 3:
                Do [[violation]]("lexicon-shadow-file", "row without 3 cells: " plus line_text).
            Set ulex_cell to [[cell_list.pop]](0).
            Set clex_cell to [[cell_list.pop]](0).
            Set ruling_cell to [[cell_list.pop]](0).
            If not ulex_cell:
                Do [[violation]]("lexicon-shadow-file", "empty ulex_entry cell: " plus line_text).
            If not clex_cell:
                Do [[violation]]("lexicon-shadow-file", "empty clex_entries cell: " plus line_text).
            If not ruling_cell:
                Do [[violation]]("lexicon-shadow-file", "empty ruling for: " plus ulex_cell).
            Set row_key to ulex_cell plus "\t" plus clex_cell.
            Set dup_row to row_key is in rulings.
            If dup_row:
                Do [[violation]]("lexicon-shadow-file", "duplicate ruling row: " plus ulex_cell).
            Do [[rulings.update]]({row_key: False}).
    Give back rulings.

Define [[check_lexicon]] taking guideline_path, ace_paths, docids:
    Set lexicon_path to [[guideline_path.joinpath]]("lexicon.ulex").
    Set data to [[read_corpus_file]](lexicon_path, "lexicon-file").
    Set text to [[data.decode]]("utf-8").
    Set all_tokens to [[ace_token_set]](ace_paths, docids).
    Set clex_maps to [[clex_entry_maps]]().
    Set clex_entries to [[clex_maps.pop]](0).
    Set clex_surfaces to [[clex_maps.pop]](0).
    Set shadow_rulings to [[lexicon_shadow_rulings]](guideline_path).
    Set ruled_count to 0.
    Set entries to <>.
    Set seen_entries to {}.
    Set live_lexemes to {}.
    For each raw_line in [[text.split]]("\n"):
        Set line_text to [[raw_line.strip]]().
        If line_text:
            Set normalized to [[normalized_lexicon_entry]](line_text).
            Set redundant to normalized is in clex_entries.
            If redundant:
                Do [[violation]]("lexicon-redundant", "clex already provides: " plus line_text).
            Set repeated to normalized is in seen_entries.
            If repeated:
                Do [[violation]]("lexicon-duplicate", "entry repeated in lexicon: " plus line_text).
            Do [[seen_entries.update]]({normalized: True}).
            Set entry to [[lexicon_entry]](line_text).
            Do [[entries.append]](entry).
            Set entry_copy to [[list]](entry).
            Set entry_kind to [[entry_copy.pop]](0).
            Set entry_surface to [[entry_copy.pop]](0).
            Set entry_lemma to [[entry_copy.pop]](0).
            Set covered to entry_surface is in clex_surfaces.
            If covered:
                Set clex_lines to [[clex_surfaces.get]](entry_surface).
                Set clex_key to "".
                For each clex_line in [[sorted]](clex_lines):
                    If clex_key:
                        Set clex_key to clex_key plus "+" plus clex_line.
                    Otherwise:
                        Set clex_key to clex_line.
                Set shadow_key to normalized plus "\t" plus clex_key.
                Set ruled to shadow_key is in shadow_rulings.
                If ruled:
                    Do [[shadow_rulings.update]]({shadow_key: True}).
                    Set ruled_count to ruled_count plus 1.
                Otherwise:
                    Do [[violation]]("lexicon-shadow", "clex shares surface without ruling: " plus line_text plus " vs " plus clex_key).
            Set referenced to entry_surface is in all_tokens.
            If referenced:
                Do [[live_lexemes.update]]({entry_lemma: True}).
    For each row_key in shadow_rulings:
        Set row_used to [[shadow_rulings.get]](row_key).
        If not row_used:
            Set key_parts to [[row_key.split]]("\t").
            Set ulex_part to [[key_parts.pop]](0).
            Do [[violation]]("lexicon-shadow", "stale ruling matches no live shadow: " plus ulex_part).
    For each entry in entries:
        Set entry_copy to [[list]](entry).
        Set kind to [[entry_copy.pop]](0).
        Set surface to [[entry_copy.pop]](0).
        Set lemma to [[entry_copy.pop]](0).
        Set live to lemma is in live_lexemes.
        If not live:
            Do [[violation]]("lexicon-dead-lexeme", "no ace document references: " plus surface).
    Do [[print]]("goal: lexicon ok " plus [[str]](lexicon_path) plus " " plus [[str]]([[len]](entries)) plus " entries " plus [[str]]([[len]](clex_entries)) plus " clex facts " plus [[str]](ruled_count) plus " ruled shadows").

Define [[check_product_vocabulary]] taking guideline_path, docid:
    Set pl_path to [[guideline_path.joinpath]]("pl", docid plus ".pl").
    Set data to [[read_corpus_file]](pl_path, "product-vocabulary").
    Set text to [[data.decode]]("utf-8").
    For each raw_line in [[text.split]]("\n"):
        Set line_text to [[raw_line.strip]]().
        If line_text:
            Set is_comment to [[line_text.startswith]]("%").
            If not is_comment:
                Set is_directive to [[line_text.startswith]](":- ").
                If is_directive:
                    Set inner to [[line_text.removeprefix]](":- ").
                    Set inner to [[inner.removesuffix]](").").
                    Set decl_parts to [[inner.split]]("(", 1).
                    Set decl_kind to [[decl_parts.pop]](0).
                    If [[len]](decl_parts) does not equal 1:
                        Do [[violation]]("product-vocabulary", "unauthorized directive in " plus docid plus ": " plus line_text).
                    Set decl_spec to [[decl_parts.pop]](0).
                    Set kind_known to decl_kind is in v1_decl_kinds.
                    If not kind_known:
                        Do [[violation]]("product-vocabulary", "unauthorized directive in " plus docid plus ": " plus line_text).
                    Set spec_known to decl_spec is in v1_directives.
                    If not spec_known:
                        Do [[violation]]("product-vocabulary", "undeclared indicator in " plus docid plus ": " plus decl_spec).
                Otherwise:
                    Set functor_parts to [[line_text.split]]("(", 1).
                    Set functor to [[functor_parts.pop]](0).
                    Set functor_known to functor is in v1_functors.
                    If not functor_known:
                        Do [[violation]]("product-vocabulary", "unauthorized clause functor in " plus docid plus ": " plus functor).

Define [[check_corpus]] taking guideline_path, ace_paths, docids, lexicon_path:
    Set ledger_docids to [[check_projection_ledger]](guideline_path).
    For each ledger_docid in ledger_docids:
        Set known to ledger_docid is in docids.
        If not known:
            Do [[violation]]("projection-ledger", "row for unknown docid: " plus ledger_docid).
    For each docid in docids:
        Set covered to docid is in ledger_docids.
        If not covered:
            Do [[violation]]("projection-ledger", "docid missing projection row: " plus docid).
        Do [[check_product_vocabulary]](guideline_path, docid).
    Do [[check_coverage]](guideline_path, docids).
    If lexicon_path does not equal None:
        Do [[check_lexicon]](guideline_path, ace_paths, docids).

Define [[check_command]] taking nothing:
    Do [[check_fork_notices]]().
    Do [[check_compendium]]().
    Set guidelines_root to [[pathlib.Path]]("guidelines").
    Set root_symlink to [[guidelines_root.is_symlink]]().
    If root_symlink:
        Do [[fail]]("guidelines", "guidelines directory is a symlink").
    If not [[guidelines_root.is_dir]]():
        Do [[fail]]("guidelines", "missing guidelines directory").
    Set plans to <>.
    For each entry in [[sorted]]([[guidelines_root.iterdir]]()):
        Set entry_name to entry.name.
        If [[entry.is_symlink]]():
            Do [[violation]]("guideline-entry", "symlink: " plus entry_name).
        If not [[entry.is_dir]]():
            Do [[violation]]("guideline-entry", "not a directory: " plus entry_name).
        If not [[valid_docid]](entry_name):
            Do [[violation]]("guideline-entry", "invalid guideline id: " plus entry_name).
        Do [[check_source_record]](entry).
        Set collected to [[collect_guideline]](entry).
        Set ace_paths to [[collected.pop]](0).
        Set docids to [[collected.pop]](0).
        Set lexicon_path to [[collected.pop]](0).
        Do [[check_pl_inventory]](entry, docids).
        Set plan_record to <entry, ace_paths, docids, lexicon_path>.
        Do [[plans.append]](plan_record).
    If not plans:
        Do [[violation]]("guidelines", "no guideline directories").
    Set red_plan to [[collect_red_probes]]().
    Do [[check_prolog_inventory]]().
    For each plan_record in plans:
        Set record_copy to [[list]](plan_record).
        Set corpus_path to [[record_copy.pop]](0).
        Set corpus_ace_paths to [[record_copy.pop]](0).
        Set corpus_docids to [[record_copy.pop]](0).
        Set corpus_lexicon_path to [[record_copy.pop]](0).
        Do [[check_corpus]](corpus_path, corpus_ace_paths, corpus_docids, corpus_lexicon_path).
    Set swipl_executable to [[resolve_swipl]]().
    Set scratch_path to [[make_scratch]]().
    Set stage_path to [[stage_ape]](scratch_path, swipl_executable).
    Set guideline_count to 0.
    Set document_count to 0.
    For each plan_record in plans:
        Set guideline_path to [[plan_record.pop]](0).
        Set ace_paths to [[plan_record.pop]](0).
        Set docids to [[plan_record.pop]](0).
        Set lexicon_path to [[plan_record.pop]](0).
        Do [[check_documents]](scratch_path, swipl_executable, stage_path, guideline_path, ace_paths, docids, lexicon_path).
        Set guideline_count to guideline_count plus 1.
        Set document_count to document_count plus [[len]](docids).
    Set probe_count to 0.
    For each probe_record in red_plan:
        Set probe_path to [[probe_record.pop]](0).
        Set class_name to [[probe_record.pop]](0).
        Set expected_exit to [[probe_record.pop]](0).
        Do [[run_red_probe]](scratch_path, swipl_executable, stage_path, probe_path, class_name, expected_exit).
        Set probe_count to probe_count plus 1.
    Do [[shutil.rmtree]](scratch_path).
    Do [[print]]("goal: check ok " plus [[str]](guideline_count) plus " guidelines " plus [[str]](document_count) plus " documents " plus [[str]](probe_count) plus " red probes").

Set compiler_source to [[pathlib.Path]]("vendor/ape/prolog/ace_to_pl.pl").
Require that [[compiler_source.is_file]]().
Set argv to [[list]](sys.argv).
Do [[argv.pop]](0).
If [[len]](argv) equals 0:
    Do [[fail]]("usage", "expected: goal compile <guideline-id> | goal check").
Set subcommand to [[argv.pop]](0).
If subcommand equals "compile":
    If [[len]](argv) does not equal 1:
        Do [[fail]]("usage", "expected: goal compile <guideline-id>").
    Set guideline_id to [[argv.pop]](0).
    Do [[compile_command]](guideline_id).
Otherwise:
    If subcommand equals "check":
        If [[len]](argv) does not equal 0:
            Do [[fail]]("usage", "expected: goal check").
        Do [[check_command]]().
    Otherwise:
        Do [[fail]]("usage", "unknown subcommand: " plus subcommand).
