orm-preference-sensitive-decisions establish-continued-opioid-goals-and-maximize-nonpharmacologic-and-nonopioid-treatment-for-tapering-or-higher-dose-patients establish-functional-treatment-goals-for-new-patients-already-receiving-opioids evaluate-further-dosage-increase-through-individualized-benefit-risk-assessment evaluate-patients-and-confirm-diagnosis explain-opioid-benefits-risks-and-alternatives-and-involve-patients-in-start-decisions follow-up-at-least-monthly-with-patients-engaging-in-opioid-tapering increase-reimbursement-and-access-to-effective-noninvasive-therapies jointly-establish-functional-evaluation-and-measurable-goals-before-opioids limit-prescription-quantity maximize-nonopioid-pain-treatment-and-address-behavioral-distress-for-patients-struggling-to-tolerate-taper maximize-nonopioid-therapy monitor-patients-unable-to-taper-on-high-dose-or-high-risk-regimens-and-mitigate-overdose-risk-with-education-and-naloxone offer-medication-treatment offer-naloxone pause-and-reassess-benefits-and-risks-before-increasing-total-opioid-dosage-to-at-least-fifty-mme-per-day prescribe-immediate-release prescribe-immediate-release-opioids-at-lowest-effective-dose-for-expected-severe-pain-duration prescribe-lowest-effective-dosage prescribe-opioids-only-as-needed-and-encourage-taper-after-around-the-clock-use prioritize-shared-decision-making-with-patients-when-continuing-opioid-benefits-and-risks-are-close-or-unclear provide-or-arrange-coordinated-management-of-pain-and-opioid-related-problems-including-opioid-use-disorder recommend-appropriate-noninvasive-nonpharmacologic-approaches reevaluate-benefits-and-risks remain-alert-to-and-screen-for-anxiety-depression-opioid-misuse-or-opioid-use-disorder-during-taper-and-provide-or-arrange-management reserve-er-la-opioids-for-severe-continuous-pain review-drug-labeling-and-weigh-benefits-and-risks-before-pharmacologic-therapy review-low-cost-pain-management-options-for-all-patients review-pdmp-data use-additional-er-la-opioid-caution-and-consider-longer-dosing-interval-for-renal-or-hepatic-dysfunction use-caution-and-smallest-practical-increase-after-deciding-to-increase-dosage use-nonopioids-when-possible-and-limit-additional-opioids-to-severe-pain-duration-for-long-term-opioid-patients-with-acute-pain use-nsaids-at-lowest-effective-dose-for-shortest-duration-with-caution use-opioid-dosage-recommendations-as-flexible-guideposts-for-clinician-patient-decisions use-particular-caution use-taper-slow-enough-to-minimize-withdrawal-when-reducing-or-discontinuing-opioids use-topical-nsaids-for-superficial-joint-osteoarthritis-after-insufficient-nonpharmacologic-response weigh-context-specific-opioid-benefits-against-risks-before-initiation".
Set v1_functors to <"guideline_schema_version", "guideline_document", "guideline_entity", "guideline_cardinality", "guideline_event", "guideline_arg", "guideline_pp", "guideline_property", "guideline_operator">.
Set v1_directives to <"guideline_schema_version/1", "guideline_document/3", "guideline_entity/4", "guideline_cardinality/5", "guideline_event/3", "guideline_arg/4", "guideline_pp/4", "guideline_property/4", "guideline_operator/3">.
Set v1_decl_kinds to <"multifile", "discontiguous">.
Set token_strip_chars to ".,;:?!\"()".

Define [[sha256_hex]] taking data:
    Set digest to [[hashlib.sha256]](data).
    Give back [[digest.hexdigest]]().

Define [[read_pinned_file]] taking file_path, category:
    If [[file_path.is_symlink]]():
        Do [[violation]](category, "is a symlink: " plus [[str]](file_path)).
    If not [[file_path.is_file]]():
        Do [[violation]](category, "missing: " plus [[str]](file_path)).
    Give back [[file_path.read_bytes]]().

Define [[check_pinned_digest]] taking file_path, pin, category:
    Set data to [[read_pinned_file]](file_path, category).
    Set digest to [[sha256_hex]](data).
    If digest does not equal pin:
        Do [[violation]](category, "digest drift: " plus [[str]](file_path) plus " = " plus digest).

Define [[check_projection_ledger]] taking guideline_path:
    Set ledger_path to [[guideline_path.joinpath]]("audit", "projection-notes.tsv").
    Set data to [[read_pinned_file]](ledger_path, "migration-projection").
    Set text to [[data.decode]]("utf-8").
    If not [[text.endswith]]("\n"):
        Do [[violation]]("migration-projection", "ledger lacks final newline").
    Set lines to [[text.splitlines]]().
    If [[len]](lines) is less than 5:
        Do [[violation]]("migration-projection", "ledger holds no rows").
    Set actual_header to "".
    Set row_lines to <>.
    Set index to 0.
    For each line_text in lines:
        If index is less than 4:
            Set actual_header to actual_header plus line_text plus "\n".
        Otherwise:
            Do [[row_lines.append]](line_text).
        Set index to index plus 1.
    Set expected_header to projection_header_text plus "\n".
    If actual_header does not equal expected_header:
        Do [[violation]]("migration-projection", "header bytes drift").
    Set pair_text to "".
    Set pinned_docids to <>.
    For each row_line in row_lines:
        Set fields to [[row_line.split]]("\t").
        If [[len]](fields) does not equal 4:
            Do [[violation]]("migration-projection", "row without 4 columns: " plus row_line).
        Set docid to [[fields.pop]](0).
        Set region to [[fields.pop]](0).
        Set kept to [[fields.pop]](0).
        Set dropped to [[fields.pop]](0).
        If not [[valid_docid]](docid):
            Do [[violation]]("migration-projection", "invalid docid: " plus docid).
        If not region:
            Do [[violation]]("migration-projection", "empty region for: " plus docid).
        If not kept:
            Do [[violation]]("migration-projection", "empty kept column for: " plus docid).
        If not dropped:
            Do [[violation]]("migration-projection", "empty dropped column for: " plus docid).
        Set pair_text to pair_text plus docid plus "\t" plus region plus "\n".
        Do [[pinned_docids.append]](docid).
    Set pair_digest to [[sha256_hex]]([[pair_text.encode]]("utf-8")).
    If pair_digest does not equal projection_pair_pin:
        Do [[violation]]("migration-projection", "pair digest drift: " plus pair_digest).
    Give back pinned_docids.

Define [[check_v1_docids]] taking pinned_docids:
    Set seen to {}.
    For each docid in v1_docids:
        Set duplicate to docid is in seen.
        If duplicate:
            Do [[violation]]("migration-docids", "duplicate v1 docid: " plus docid).
        Do [[seen.update]]({docid: True}).
        Set pinned to docid is in pinned_docids.
        If not pinned:
            Do [[violation]]("migration-docids", "v1 docid absent from pinned projection pairs: " plus docid).

Define [[lexicon_entry]] taking line_text:
    Set head_parts to [[line_text.split]]("(", 1).
    Set kind to [[head_parts.pop]](0).
    If [[len]](head_parts) does not equal 1:
        Do [[violation]]("lexicon-entry", "malformed entry: " plus line_text).
    Set rest to [[head_parts.pop]](0).
    Set quoted to [[rest.split]]("'").
    Set surface to "".
    Set lemma to "".
    If [[len]](quoted) is greater than 3:
        Do [[quoted.pop]](0).
        Set surface to [[quoted.pop]](0).
        Do [[quoted.pop]](0).
        Set lemma to [[quoted.pop]](0).
    Otherwise:
        Set plain to [[rest.split]](",").
        If [[len]](plain) is less than 2:
            Do [[violation]]("lexicon-entry", "malformed entry: " plus line_text).
        Set surface to [[plain.pop]](0).
        Set lemma to [[plain.pop]](0).
    Give back <kind, surface, lemma>.

Define [[ace_token_set]] taking ace_paths, docids:
    Set tokens to {}.
    For each docid in docids:
        Set ace_path to [[ace_paths.get]](docid).
        Set text to [[ace_path.read_text]](encoding="utf-8").
        For each raw_token in [[text.split]]():
            Set token to [[raw_token.strip]](token_strip_chars).
            Do [[tokens.update]]({token: True}).
    Give back tokens.

Define [[check_lexicon_migration]] taking guideline_path, ace_paths, docids, migrated_count:
    Set lexicon_path to [[guideline_path.joinpath]]("lexicon.ulex").
    Set data to [[read_pinned_file]](lexicon_path, "lexicon-file").
    Set text to [[data.decode]]("utf-8").
    Set all_tokens to [[ace_token_set]](ace_paths, docids).
    Set unmigrated_docids to <>.
    For each docid in docids:
        Set migrated to docid is in v1_docids.
        If not migrated:
            Do [[unmigrated_docids.append]](docid).
    Set unmigrated_tokens to [[ace_token_set]](ace_paths, unmigrated_docids).
    Set mega_lemmas to [[mega_lemmas_text.split]]().
    Set entries to <>.
    Set live_lexemes to {}.
    Set live_unmigrated to {}.
    For each raw_line in [[text.split]]("\n"):
        Set line_text to [[raw_line.strip]]().
        If line_text:
            Set entry to [[lexicon_entry]](line_text).
            Do [[entries.append]](entry).
            Set entry_copy to [[list]](entry).
            Set entry_kind to [[entry_copy.pop]](0).
            Set entry_surface to [[entry_copy.pop]](0).
            Set entry_lemma to [[entry_copy.pop]](0).
            Set referenced to entry_surface is in all_tokens.
            If referenced:
                Do [[live_lexemes.update]]({entry_lemma: True}).
            Set referenced_unmigrated to entry_surface is in unmigrated_tokens.
            If referenced_unmigrated:
                Do [[live_unmigrated.update]]({entry_lemma: True}).
    Set fixture_count to 0.
    For each entry in entries:
        Set entry_copy to [[list]](entry).
        Set kind to [[entry_copy.pop]](0).
        Set surface to [[entry_copy.pop]](0).
        Set lemma to [[entry_copy.pop]](0).
        Set live to lemma is in live_lexemes.
        If not live:
            Do [[violation]]("lexicon-dead-lexeme", "no ace document references: " plus surface).
        Set is_pn to kind equals "pn_sg".
        Set is_mega to lemma is in mega_lemmas.
        Set fixture to is_pn or is_mega.
        If fixture:
            Set fixture_count to fixture_count plus 1.
            Set live_before to lemma is in live_unmigrated.
            If not live_before:
                Do [[violation]]("lexicon-fixture-lexeme", "no unmigrated ace document references: " plus surface).
    Set doc_count to [[len]](docids).
    If migrated_count equals doc_count:
        If fixture_count is greater than 0:
            Do [[violation]]("lexicon-terminal", "fixture-era entries survive full migration: " plus [[str]](fixture_count)).

Define [[check_migrated_product]] taking guideline_path, docid:
    Set pl_path to [[guideline_path.joinpath]]("pl", docid plus ".pl").
    Set data to [[read_pinned_file]](pl_path, "migration-product").
    Set text to [[data.decode]]("utf-8").
    For each raw_line in [[text.split]]("\n"):
        Set line_text to [[raw_line.strip]]().
        If line_text:
            Set is_comment to [[line_text.startswith]]("%").
            If not is_comment:
                Set is_directive to [[line_text.startswith]](":- ").
                If is_directive:
                    Set inner to [[line_text.removeprefix]](":- ").
                    Set inner to [[inner.removesuffix]](").").
                    Set decl_parts to [[inner.split]]("(", 1).
                    Set decl_kind to [[decl_parts.pop]](0).
                    If [[len]](decl_parts) does not equal 1:
                        Do [[violation]]("migration-product", "unauthorized directive in " plus docid plus ": " plus line_text).
                    Set decl_spec to [[decl_parts.pop]](0).
                    Set kind_known to decl_kind is in v1_decl_kinds.
                    If not kind_known:
                        Do [[violation]]("migration-product", "unauthorized directive in " plus docid plus ": " plus line_text).
                    Set spec_known to decl_spec is in v1_directives.
                    If not spec_known:
                        Do [[violation]]("migration-product", "undeclared indicator in " plus docid plus ": " plus decl_spec).
                Otherwise:
                    Set functor_parts to [[line_text.split]]("(", 1).
                    Set functor to [[functor_parts.pop]](0).
                    Set functor_known to functor is in v1_functors.
                    If not functor_known:
                        Do [[violation]]("migration-product", "unauthorized clause functor in " plus docid plus ": " plus functor).

Define [[check_migration]] taking guideline_path, ace_paths, docids:
    Set coverage_path to [[guideline_path.joinpath]]("coverage.tsv").
    Do [[check_pinned_digest]](coverage_path, coverage_pin, "migration-coverage").
    Set census_path to [[guideline_path.joinpath]]("audit", "census-map.tsv").
    Do [[check_pinned_digest]](census_path, census_pin, "migration-census").
    Set pinned_docids to [[check_projection_ledger]](guideline_path).
    Do [[check_v1_docids]](pinned_docids).
    Set migrated_count to [[len]](v1_docids).
    Do [[check_lexicon_migration]](guideline_path, ace_paths, docids, migrated_count).
    For each docid in v1_docids:
        Do [[check_migrated_product]](guideline_path, docid).
    Set pinned_count to [[len]](pinned_docids).
    Do [[print]]("goal: migration migrated=" plus [[str]](migrated_count) plus "/" plus [[str]](pinned_count)).

Define [[check_command]] taking nothing:
    Do [[check_compendium]]().
    Set guidelines_root to [[pathlib.Path]]("guidelines").
    Set root_symlink to [[guidelines_root.is_symlink]]().
    If root_symlink:
        Do [[fail]]("guidelines", "guidelines directory is a symlink").
    If not [[guidelines_root.is_dir]]():
        Do [[fail]]("guidelines", "missing guidelines directory").
    Set plans to <>.
    Set migration_plans to <>.
    For each entry in [[sorted]]([[guidelines_root.iterdir]]()):
        Set entry_name to entry.name.
        If [[entry.is_symlink]]():
            Do [[violation]]("guideline-entry", "symlink: " plus entry_name).
        If not [[entry.is_dir]]():
            Do [[violation]]("guideline-entry", "not a directory: " plus entry_name).
        If not [[valid_docid]](entry_name):
            Do [[violation]]("guideline-entry", "invalid guideline id: " plus entry_name).
        Do [[check_source_record]](entry).
        Set collected to [[collect_guideline]](entry).
        Set ace_paths to [[collected.pop]](0).
        Set docids to [[collected.pop]](0).
        Set lexicon_path to [[collected.pop]](0).
        Do [[check_pl_inventory]](entry, docids).
        Set plan_record to <entry, ace_paths, docids, lexicon_path>.
        Do [[plans.append]](plan_record).
        If entry_name equals migration_guideline_id:
            Set migration_record to <entry, ace_paths, docids>.
            Do [[migration_plans.append]](migration_record).
    If not plans:
        Do [[violation]]("guidelines", "no guideline directories").
    Set red_plan to [[collect_red_probes]]().
    Do [[check_prolog_inventory]]().
    For each migration_record in migration_plans:
        Set record_copy to [[list]](migration_record).
        Set migration_path to [[record_copy.pop]](0).
        Set migration_ace_paths to [[record_copy.pop]](0).
        Set migration_docids to [[record_copy.pop]](0).
        Do [[check_migration]](migration_path, migration_ace_paths, migration_docids).
    Set swipl_executable to [[resolve_swipl]]().
    Set scratch_path to [[make_scratch]]().
    Set stage_path to [[stage_ape]](scratch_path, swipl_executable).
    Set guideline_count to 0.
    Set document_count to 0.
    For each plan_record in plans:
        Set guideline_path to [[plan_record.pop]](0).
        Set ace_paths to [[plan_record.pop]](0).
        Set docids to [[plan_record.pop]](0).
        Set lexicon_path to [[plan_record.pop]](0).
        Do [[check_documents]](scratch_path, swipl_executable, stage_path, guideline_path, ace_paths, docids, lexicon_path).
        Set guideline_count to guideline_count plus 1.
        Set document_count to document_count plus [[len]](docids).
    Set probe_count to 0.
    For each probe_record in red_plan:
        Set probe_path to [[probe_record.pop]](0).
        Set class_name to [[probe_record.pop]](0).
        Set expected_exit to [[probe_record.pop]](0).
        Do [[run_red_probe]](scratch_path, swipl_executable, stage_path, probe_path, class_name, expected_exit).
        Set probe_count to probe_count plus 1.
    Do [[shutil.rmtree]](scratch_path).
    Do [[print]]("goal: check ok " plus [[str]](guideline_count) plus " guidelines " plus [[str]](document_count) plus " documents " plus [[str]](probe_count) plus " red probes").

Set compiler_source to [[pathlib.Path]]("vendor/ape/prolog/ace_to_pl.pl").
Require that [[compiler_source.is_file]]().
Set argv to [[list]](sys.argv).
Do [[argv.pop]](0).
If [[len]](argv) equals 0:
    Do [[fail]]("usage", "expected: goal compile <guideline-id> | goal check").
Set subcommand to [[argv.pop]](0).
If subcommand equals "compile":
    If [[len]](argv) does not equal 1:
        Do [[fail]]("usage", "expected: goal compile <guideline-id>").
    Set guideline_id to [[argv.pop]](0).
    Do [[compile_command]](guideline_id).
Otherwise:
    If subcommand equals "check":
        If [[len]](argv) does not equal 0:
            Do [[fail]]("usage", "expected: goal check").
        Do [[check_command]]().
    Otherwise:
        Do [[fail]]("usage", "unknown subcommand: " plus subcommand).
