Use hashlib.
Use os.
Use pathlib.
Use re.
Use shutil.
Use subprocess.
Use sys.

Define [[fail]] taking category, detail:
    Set safe_detail to [[detail.replace]]("\n", "\\n").
    Set safe_detail to [[safe_detail.replace]]("\r", "\\r").
    Do [[print]]("goal: " plus category plus ": " plus safe_detail, file=sys.stderr).
    Exit with 2.

Define [[violation]] taking category, detail:
    Set safe_detail to [[detail.replace]]("\n", "\\n").
    Set safe_detail to [[safe_detail.replace]]("\r", "\\r").
    Do [[print]]("goal: " plus category plus ": " plus safe_detail).
    Exit with 1.

Define [[cleanup_and_fail]] taking scratch_path, category, detail:
    Do [[shutil.rmtree]](scratch_path).
    Do [[fail]](category, detail).

Define [[cleanup_violation]] taking scratch_path, category, detail:
    Do [[shutil.rmtree]](scratch_path).
    Do [[violation]](category, detail).

Define [[relay_failure]] taking scratch_path, result:
    Do [[shutil.rmtree]](scratch_path).
    Do [[sys.stderr.buffer.write]](result.stderr).
    Exit with result.returncode.

Define [[valid_docid]] taking docid:
    Set allowed to [[set]]("abcdefghijklmnopqrstuvwxyz0123456789-").
    Set chars to [[set]](docid).
    Set subset to [[chars.issubset]](allowed).
    Set leading_dash to [[docid.startswith]]("-").
    If not docid:
        Give back False.
    If leading_dash:
        Give back False.
    Give back subset.

Define [[resolve_swipl]] taking nothing:
    Set swipl to [[os.environ.get]]("SWIPL", "swipl").
    Set swipl_executable to [[shutil.which]](swipl).
    If swipl_executable equals None:
        Do [[fail]]("swipl-exec", "not executable: " plus swipl).
    Give back swipl_executable.

Define [[make_scratch]] taking nothing:
    Set pid_text to [[str]]([[os.getpid]]()).
    Set scratch_path to [[pathlib.Path]](".goal.tmp." plus pid_text).
    If [[scratch_path.exists]]():
        Do [[fail]]("scratch", "already exists: " plus [[str]](scratch_path)).
    Do [[scratch_path.mkdir]]().
    Give back scratch_path.

Define [[stage_ape]] taking scratch_path, swipl_executable:
    Set stage_path to [[scratch_path.joinpath]]("ape-stage").
    Do [[shutil.copytree]]("vendor/ape", stage_path).
    Set parser_dir to [[stage_path.joinpath]]("prolog", "parser").
    Set build_goal to "working_directory(_, '" plus [[parser_dir.as_posix]]() plus "'), [fit_to_plp], halt.".
    Set command to <swipl_executable, "-O", "-f", "none", "-F", "none", "-g", build_goal, "-t", "halt">.
    Set result to [[subprocess.run]](command, capture_output=True).
    If result.returncode does not equal 0:
        Do [[relay_failure]](scratch_path, result).
    Set grammar_path to [[parser_dir.joinpath]]("grammar.plp").
    If not [[grammar_path.is_file]]():
        Do [[cleanup_and_fail]](scratch_path, "ape-stage", "missing grammar.plp after build").
    Give back stage_path.

Define [[compiler_command]] taking swipl_executable, stage_path, tail_args:
    Set compiler_path to [[stage_path.joinpath]]("prolog", "ace_to_pl.pl").
    Set command to <swipl_executable, "-q", "-f", "none", "-F", "none", "-s", [[str]](compiler_path), "-g", "main", "-t", "halt(9)", "--">.
    For each tail_arg in tail_args:
        Do [[command.append]](tail_arg).
    Give back command.

Define [[compile_doc]] taking scratch_path, swipl_executable, stage_path, docid, ace_path, lexicon_path, extra_args:
    Set ace_bytes to [[ace_path.read_bytes]]().
    Set tail_args to <[[str]](stage_path), docid>.
    If lexicon_path does not equal None:
        Do [[tail_args.append]]([[str]](lexicon_path)).
    For each extra_arg in extra_args:
        Do [[tail_args.append]](extra_arg).
    Set command to [[compiler_command]](swipl_executable, stage_path, tail_args).
    Set result to [[subprocess.run]](command, input=ace_bytes, capture_output=True).
    If result.returncode does not equal 0:
        Do [[relay_failure]](scratch_path, result).
    If result.stderr:
        Do [[cleanup_and_fail]](scratch_path, "compiler-stderr", "non-empty stderr for document: " plus docid).
    If not result.stdout:
        Do [[cleanup_and_fail]](scratch_path, "compiler-stdout", "empty stdout for document: " plus docid).
    Set newline_bytes to [[bytes]](<10>).
    Set final_newline to [[result.stdout.endswith]](newline_bytes).
    If not final_newline:
        Do [[cleanup_and_fail]](scratch_path, "compiler-stdout", "missing final newline for document: " plus docid).
    Give back result.stdout.

Define [[check_doc_queries]] taking scratch_path, swipl_executable, stage_path, pl_path:
    Set tail_args to <"check", [[str]](pl_path)>.
    Set command to [[compiler_command]](swipl_executable, stage_path, tail_args).
    Set result to [[subprocess.run]](command, capture_output=True).
    If result.returncode does not equal 0:
        Do [[relay_failure]](scratch_path, result).
    If result.stdout:
        Do [[cleanup_and_fail]](scratch_path, "check-stdout", "non-empty stdout for: " plus [[str]](pl_path)).
    If result.stderr:
        Do [[cleanup_and_fail]](scratch_path, "check-stderr", "non-empty stderr for: " plus [[str]](pl_path)).

Define [[collect_guideline]] taking guideline_path:
    Set ace_dir to [[guideline_path.joinpath]]("ace").
    Set ace_symlink to [[ace_dir.is_symlink]]().
    If ace_symlink:
        Do [[fail]]("guideline", "ace directory is a symlink: " plus [[str]](ace_dir)).
    If not [[ace_dir.is_dir]]():
        Do [[fail]]("guideline", "missing ace directory: " plus [[str]](ace_dir)).
    Set ace_paths to {}.
    Set docids to <>.
    For each entry in [[sorted]]([[ace_dir.iterdir]]()):
        Set entry_name to entry.name.
        Set regular to [[entry.is_file]]().
        Set symlink to [[entry.is_symlink]]().
        If not regular:
            Do [[fail]]("guideline", "entry is not a regular file: " plus entry_name).
        If symlink:
            Do [[fail]]("guideline", "entry is not a regular file: " plus entry_name).
        If not [[entry_name.endswith]](".ace"):
            Do [[fail]]("guideline", "unsupported ace entry: " plus entry_name).
        Set docid to [[entry_name.removesuffix]](".ace").
        If not [[valid_docid]](docid):
            Do [[fail]]("docid", "invalid document id: " plus docid).
        Do [[ace_paths.update]]({docid: entry}).
        Do [[docids.append]](docid).
    If not docids:
        Do [[fail]]("guideline", "no .ace documents in: " plus [[str]](ace_dir)).
    Set lexicon_path to [[guideline_path.joinpath]]("lexicon.ulex").
    Set lexicon_symlink to [[lexicon_path.is_symlink]]().
    If lexicon_symlink:
        Do [[fail]]("guideline", "lexicon is a symlink: " plus [[str]](lexicon_path)).
    Set lexicon_present to [[lexicon_path.is_file]]().
    If not lexicon_present:
        Set lexicon_path to None.
    Give back <ace_paths, [[sorted]](docids), lexicon_path>.

Define [[check_source_record]] taking guideline_path:
    Set readme_path to [[guideline_path.joinpath]]("README.md").
    Set readme_symlink to [[readme_path.is_symlink]]().
    If readme_symlink:
        Do [[violation]]("source-record", "README.md is a symlink under: " plus [[str]](guideline_path)).
    If not [[readme_path.is_file]]():
        Do [[violation]]("source-record", "missing README.md under: " plus [[str]](guideline_path)).
    Set source_dir to [[guideline_path.joinpath]]("source").
    Set source_symlink to [[source_dir.is_symlink]]().
    If source_symlink:
        Do [[violation]]("source-record", "source is a symlink under: " plus [[str]](guideline_path)).
    If not [[source_dir.is_dir]]():
        Do [[violation]]("source-record", "missing source directory under: " plus [[str]](guideline_path)).
    Set record_count to 0.
    For each entry in [[sorted]]([[source_dir.iterdir]]()):
        Set symlink to [[entry.is_symlink]]().
        If symlink:
            Do [[violation]]("source-record", "symlink under source: " plus entry.name).
        Set regular to [[entry.is_file]]().
        If regular:
            Set record_count to record_count plus 1.
    If record_count equals 0:
        Do [[violation]]("source-record", "no source files under: " plus [[str]](guideline_path)).

Define [[check_pl_inventory]] taking guideline_path, docids:
    Set pl_dir to [[guideline_path.joinpath]]("pl").
    Set pl_symlink to [[pl_dir.is_symlink]]().
    If pl_symlink:
        Do [[violation]]("pl-dir", "is a symlink: " plus [[str]](pl_dir)).
    If not [[pl_dir.is_dir]]():
        Do [[violation]]("missing-pl", [[str]](pl_dir)).
    Set expected_names to <>.
    For each docid in docids:
        Do [[expected_names.append]](docid plus ".pl").
    Set actual_names to <>.
    For each entry in [[sorted]]([[pl_dir.iterdir]]()):
        Set entry_name to entry.name.
        Set regular to [[entry.is_file]]().
        Set symlink to [[entry.is_symlink]]().
        If not regular:
            Do [[violation]]("pl-entry", "not a regular file: " plus entry_name).
        If symlink:
            Do [[violation]]("pl-entry", "not a regular file: " plus entry_name).
        Do [[actual_names.append]](entry_name).
    If [[sorted]](expected_names) does not equal actual_names:
        Do [[violation]]("pl-inventory", "committed pl/ does not match ace/ document set").

Define [[compiled_pl_path]] taking tracked:
    Set parts to [[tracked.split]]("/").
    If [[len]](parts) does not equal 4:
        Give back False.
    Set root_part to [[parts.pop]](0).
    Set id_part to [[parts.pop]](0).
    Set dir_part to [[parts.pop]](0).
    Set file_part to [[parts.pop]](0).
    If root_part does not equal "guidelines":
        Give back False.
    If not [[valid_docid]](id_part):
        Give back False.
    If dir_part does not equal "pl":
        Give back False.
    If not [[file_part.endswith]](".pl"):
        Give back False.
    Set stem to [[file_part.removesuffix]](".pl").
    Give back [[valid_docid]](stem).

Define [[check_prolog_inventory]] taking nothing:
    Set git_res to [[subprocess.run]](<"git", "ls-files", "--", "*.pl">, capture_output=True, check=True).
    Set tracked_text to [[git_res.stdout.decode]]("utf-8").
    For each tracked in [[sorted]]([[tracked_text.splitlines]]()):
        Set vendored to [[tracked.startswith]]("vendor/ape/").
        Set compiled to [[compiled_pl_path]](tracked).
        If not vendored:
            If not compiled:
                Do [[violation]]("prolog-inventory", "unauthorized tracked prolog: " plus tracked).

Define [[check_documents]] taking scratch_path, swipl_executable, stage_path, guideline_path, ace_paths, docids, lexicon_path:
    Set pl_dir to [[guideline_path.joinpath]]("pl").
    Set payload_dir to [[scratch_path.joinpath]]("payloads").
    If not [[payload_dir.is_dir]]():
        Do [[payload_dir.mkdir]]().
    Set manifest_pairs to <>.
    For each docid in docids:
        Set ace_path to [[ace_paths.get]](docid).
        Set migrated to docid is in v1_docids.
        Set extra_args to <>.
        If migrated:
            Do [[extra_args.append]]("schema=v1").
        Set first_bytes to [[compile_doc]](scratch_path, swipl_executable, stage_path, docid, ace_path, lexicon_path, extra_args).
        Set second_bytes to [[compile_doc]](scratch_path, swipl_executable, stage_path, docid, ace_path, lexicon_path, extra_args).
        If first_bytes does not equal second_bytes:
            Do [[cleanup_violation]](scratch_path, "determinism", "two compiles differ for document: " plus docid).
        Set committed_path to [[pl_dir.joinpath]](docid plus ".pl").
        Set committed_bytes to [[committed_path.read_bytes]]().
        If first_bytes does not equal committed_bytes:
            Do [[cleanup_violation]](scratch_path, "stale", "committed pl differs from fresh compile: " plus [[str]](committed_path)).
        If migrated:
            Set proof_args to <"schema=v1", "proof">.
            Set first_payload to [[compile_doc]](scratch_path, swipl_executable, stage_path, docid, ace_path, lexicon_path, proof_args).
            Set second_payload to [[compile_doc]](scratch_path, swipl_executable, stage_path, docid, ace_path, lexicon_path, proof_args).
            If first_payload does not equal second_payload:
                Do [[cleanup_violation]](scratch_path, "determinism", "two proof runs differ for document: " plus docid).
            Set payload_path to [[payload_dir.joinpath]](docid plus ".proof").
            Do [[payload_path.write_bytes]](first_payload).
            Do [[manifest_pairs.append]](<committed_path, payload_path>).
        Do [[check_doc_queries]](scratch_path, swipl_executable, stage_path, committed_path).
    Do [[check_aggregate]](scratch_path, swipl_executable, stage_path, manifest_pairs).

Define [[write_manifest]] taking manifest_path, manifest_pairs:
    Set manifest_text to "".
    For each manifest_pair in manifest_pairs:
        Set pair_copy to [[list]](manifest_pair).
        Set pl_path to [[pair_copy.pop]](0).
        Set payload_path to [[pair_copy.pop]](0).
        Set manifest_text to manifest_text plus [[str]](pl_path) plus "\t" plus [[str]](payload_path) plus "\n".
    Do [[manifest_path.write_text]](manifest_text, encoding="utf-8").

Define [[run_aggregate]] taking scratch_path, swipl_executable, stage_path, manifest_path, doc_count:
    Set tail_args to <"aggregate-check", [[str]](manifest_path)>.
    Set command to [[compiler_command]](swipl_executable, stage_path, tail_args).
    Set result to [[subprocess.run]](command, capture_output=True).
    If result.returncode does not equal 0:
        Do [[relay_failure]](scratch_path, result).
    If result.stderr:
        Do [[cleanup_and_fail]](scratch_path, "aggregate-stderr", "non-empty stderr for manifest: " plus [[str]](manifest_path)).
    Set stdout_text to [[result.stdout.decode]]("utf-8", errors="replace").
    Set expected_prefix to "ace_to_pl aggregate ok " plus [[str]](doc_count) plus " documents ".
    If not [[stdout_text.startswith]](expected_prefix):
        Do [[cleanup_violation]](scratch_path, "aggregate-report", "unexpected report: " plus [[stdout_text.strip]]()).
    If not [[stdout_text.endswith]](" obligations\n"):
        Do [[cleanup_violation]](scratch_path, "aggregate-report", "unexpected report: " plus [[stdout_text.strip]]()).
    Give back stdout_text.

Define [[check_aggregate]] taking scratch_path, swipl_executable, stage_path, manifest_pairs:
    Set doc_count to [[len]](manifest_pairs).
    Set forward_path to [[scratch_path.joinpath]]("manifest-forward").
    Do [[write_manifest]](forward_path, manifest_pairs).
    Set forward_report to [[run_aggregate]](scratch_path, swipl_executable, stage_path, forward_path, doc_count).
    Set reverse_pairs to [[list]](manifest_pairs).
    Do [[reverse_pairs.reverse]]().
    Set reverse_path to [[scratch_path.joinpath]]("manifest-reverse").
    Do [[write_manifest]](reverse_path, reverse_pairs).
    Set reverse_report to [[run_aggregate]](scratch_path, swipl_executable, stage_path, reverse_path, doc_count).
    If forward_report does not equal reverse_report:
        Do [[cleanup_violation]](scratch_path, "aggregate-order", "forward and reverse manifests disagree").

Define [[compile_command]] taking guideline_id:
    If not [[valid_docid]](guideline_id):
        Do [[fail]]("guideline", "invalid guideline id: " plus guideline_id).
    Set guidelines_root to [[pathlib.Path]]("guidelines").
    Set guideline_path to [[guidelines_root.joinpath]](guideline_id).
    Set guideline_symlink to [[guideline_path.is_symlink]]().
    If guideline_symlink:
        Do [[fail]]("guideline", "is a symlink: " plus [[str]](guideline_path)).
    If not [[guideline_path.is_dir]]():
        Do [[fail]]("guideline", "not a directory: " plus [[str]](guideline_path)).
    Set collected to [[collect_guideline]](guideline_path).
    Set ace_paths to [[collected.pop]](0).
    Set docids to [[collected.pop]](0).
    Set lexicon_path to [[collected.pop]](0).
    Set pl_dir to [[guideline_path.joinpath]]("pl").
    Set pl_symlink to [[pl_dir.is_symlink]]().
    If pl_symlink:
        Do [[fail]]("pl-dir", "is a symlink: " plus [[str]](pl_dir)).
    Set pl_exists to [[pl_dir.exists]]().
    If pl_exists:
        If not [[pl_dir.is_dir]]():
            Do [[fail]]("pl-dir", "not a directory: " plus [[str]](pl_dir)).
    Set swipl_executable to [[resolve_swipl]]().
    Set scratch_path to [[make_scratch]]().
    Set stage_path to [[stage_ape]](scratch_path, swipl_executable).
    Set outputs to {}.
    For each docid in docids:
        Set ace_path to [[ace_paths.get]](docid).
        Set migrated to docid is in v1_docids.
        Set extra_args to <>.
        If migrated:
            Do [[extra_args.append]]("schema=v1").
        Set pl_bytes to [[compile_doc]](scratch_path, swipl_executable, stage_path, docid, ace_path, lexicon_path, extra_args).
        Do [[outputs.update]]({docid: pl_bytes}).
    Set new_dir to [[scratch_path.joinpath]]("pl-new").
    Do [[new_dir.mkdir]]().
    For each docid in [[sorted]](outputs):
        Set payload to [[outputs.get]](docid).
        Set target to [[new_dir.joinpath]](docid plus ".pl").
        Do [[target.write_bytes]](payload).
    If pl_exists:
        Set backup_dir to [[scratch_path.joinpath]]("pl-old").
        Do [[os.rename]](pl_dir, backup_dir).
    Do [[os.rename]](new_dir, pl_dir).
    Do [[shutil.rmtree]](scratch_path).
    For each docid in [[sorted]](outputs):
        Do [[print]]("goal: wrote " plus [[str]]([[pl_dir.joinpath]](docid plus ".pl"))).
    Do [[print]]("goal: compile ok " plus [[str]]([[len]](outputs)) plus " documents").

Define [[red_probe_class]] taking probe_name:
    Set stem to [[probe_name.removesuffix]](".ace").
    Set parts to [[stem.split]]("--").
    If [[len]](parts) is greater than 1:
        Set class_name to [[parts.pop]](0).
        If class_name:
            Give back class_name.
    Do [[violation]]("red-probe", "probe name lacks <class>-- prefix: " plus probe_name).

Define [[red_expected_exit]] taking class_name:
    Set exit_one to <"input_utf8", "ape_messages", "empty_drs", "sentence_lines", "unsupported", "safety", "query_failed", "proof">.
    Set exit_two to <"usage", "ape_load", "ulex_load", "check_load", "uncaught">.
    Set is_one to class_name is in exit_one.
    Set is_two to class_name is in exit_two.
    If is_one:
        Give back 1.
    If is_two:
        Give back 2.
    Do [[violation]]("red-class", "unknown error class: " plus class_name).

Define [[collect_red_probes]] taking nothing:
    Set red_dir to [[pathlib.Path]]("tests/red").
    Set red_symlink to [[red_dir.is_symlink]]().
    If red_symlink:
        Do [[violation]]("red-dir", "is a symlink: " plus [[str]](red_dir)).
    If not [[red_dir.is_dir]]():
        Do [[violation]]("red-dir", "missing: " plus [[str]](red_dir)).
    Set probes to <>.
    Set ace_stems to <>.
    Set ulex_stems to <>.
    For each entry in [[sorted]]([[red_dir.iterdir]]()):
        Set entry_name to entry.name.
        Set regular to [[entry.is_file]]().
        Set symlink to [[entry.is_symlink]]().
        If not regular:
            Do [[violation]]("red-entry", "not a regular file: " plus entry_name).
        If symlink:
            Do [[violation]]("red-entry", "not a regular file: " plus entry_name).
        Set is_ace to [[entry_name.endswith]](".ace").
        Set is_ulex to [[entry_name.endswith]](".ulex").
        If is_ace:
            Set class_name to [[red_probe_class]](entry_name).
            Set expected_exit to [[red_expected_exit]](class_name).
            Set probe_record to <entry, class_name, expected_exit>.
            Do [[probes.append]](probe_record).
            Do [[ace_stems.append]]([[entry_name.removesuffix]](".ace")).
        Otherwise:
            If is_ulex:
                Do [[ulex_stems.append]]([[entry_name.removesuffix]](".ulex")).
            Otherwise:
                Do [[violation]]("red-entry", "unsupported entry: " plus entry_name).
    For each ulex_stem in ulex_stems:
        Set paired to ulex_stem is in ace_stems.
        If not paired:
            Do [[violation]]("red-entry", "orphan ulex without ace probe: " plus ulex_stem).
    If not probes:
        Do [[violation]]("red-dir", "no red probes found").
    Give back probes.

Define [[run_red_probe]] taking scratch_path, swipl_executable, stage_path, probe_path, class_name, expected_exit:
    Set probe_name to probe_path.name.
    Set probe_bytes to [[probe_path.read_bytes]]().
    Set lexicon_path to [[probe_path.with_suffix]](".ulex").
    Set lexicon_present to [[lexicon_path.is_file]]().
    Set tail_args to <[[str]](stage_path), "red-probe">.
    If lexicon_present:
        Do [[tail_args.append]]([[str]](lexicon_path)).
    If "--v1-" is in probe_name:
        Do [[tail_args.append]]("schema=v1").
    Set command to [[compiler_command]](swipl_executable, stage_path, tail_args).
    Set result to [[subprocess.run]](command, input=probe_bytes, capture_output=True).
    If result.returncode does not equal expected_exit:
        Do [[cleanup_violation]](scratch_path, "red-exit", "status " plus [[str]](result.returncode) plus " for probe: " plus probe_name).
    If result.stdout:
        Do [[cleanup_violation]](scratch_path, "red-stdout", "non-empty stdout for probe: " plus probe_name).
    Set newline_bytes to [[bytes]](<10>).
    Set newline_count to [[result.stderr.count]](newline_bytes).
    Set final_newline to [[result.stderr.endswith]](newline_bytes).
    If newline_count does not equal 1:
        Do [[cleanup_violation]](scratch_path, "red-stderr", "stderr is not one LF line for probe: " plus probe_name).
    If not final_newline:
        Do [[cleanup_violation]](scratch_path, "red-stderr", "stderr is not one LF line for probe: " plus probe_name).
    Set stderr_text to [[result.stderr.decode]]("utf-8", errors="replace").
    Set expected_prefix to "ace_to_pl_error(" plus class_name plus ",".
    If not [[stderr_text.startswith]](expected_prefix):
        Do [[cleanup_violation]](scratch_path, "red-class", "stderr class mismatch for probe: " plus probe_name).
    If not [[stderr_text.endswith]](").\n"):
        Do [[cleanup_violation]](scratch_path, "red-stderr", "stderr lacks canonical term suffix for probe: " plus probe_name).

Set bal_pattern to "(?:[^()]|\\([^()]*\\))*".
Set access_rx to [[re.compile]]("^(open|unverified|paywalled\\([^)]+\\)|login\\([^)]+\\))$").
Set status_rx to [[re.compile]]("^(unqueued|provisional\\(" plus bal_pattern plus "\\)|queued|in-progress|done|blocked\\(" plus bal_pattern plus "\\)|excluded\\(" plus bal_pattern plus "\\))$").
Set swept_rx to [[re.compile]]("^(pending|-|\\d{4}-\\d{2}-\\d{2} .+|blocked\\(" plus bal_pattern plus "\\))$").
Set year_rx to [[re.compile]]("\\((\\d{4})(;\\s*pub\\s*(\\d{4}))?\\)\\s*$").
Set token_rx to [[re.compile]]("guestAccessKey|accessKey=|token=").
Set org_header to <"org", "abbrev", "class", "CPGs", "index URL", "enum sources", "swept">.
Set row_header to "org\ttitle (year)\tURL\taccess\tstatus\tnotes".
Set class_names to <"federal", "society", "other">.
Set cpgs_names to <"yes", "unverified", "no">.

Define [[read_compendium_file]] taking path_text:
    Set file_path to [[pathlib.Path]](path_text).
    If [[file_path.is_symlink]]():
        Do [[fail]]("compendium", "is a symlink: " plus path_text).
    If not [[file_path.is_file]]():
        Do [[fail]]("compendium", "missing: " plus path_text).
    Give back [[file_path.read_text]](encoding="utf-8").

Define [[org_section_text]] taking comp_text:
    Set head_parts to [[comp_text.split]]("\n## Organizations\n", 1).
    If [[len]](head_parts) does not equal 2:
        Do [[violation]]("compendium-org-table", "missing `## Organizations` section in .agent/compendium.md").
    Do [[head_parts.pop]](0).
    Set tail_text to [[head_parts.pop]](0).
    Set tail_parts to [[tail_text.split]]("\n## Guidelines\n", 1).
    Set section_text to [[tail_parts.pop]](0).
    Give back section_text.

Define [[org_table_rows]] taking section_text:
    Set rows to <>.
    Set seen_header to False.
    Set separator_chars to [[set]]("- ").
    For each raw_line in [[section_text.split]]("\n"):
        Set line_text to [[raw_line.strip]]().
        Set starts_pipe to [[line_text.startswith]]("|").
        Set ends_pipe to [[line_text.endswith]]("|").
        If starts_pipe:
            If ends_pipe:
                Set inner_text to [[line_text.removeprefix]]("|").
                Set inner_text to [[inner_text.removesuffix]]("|").
                Set cell_list to <>.
                For each cell_text in [[inner_text.split]]("|"):
                    Do [[cell_list.append]]([[cell_text.strip]]()).
                If not seen_header:
                    If cell_list does not equal org_header:
                        Do [[violation]]("compendium-org-table", "organization table header mismatch").
                    Set seen_header to True.
                Otherwise:
                    Set joined_text to "".
                    For each cell_text in cell_list:
                        Set joined_text to joined_text plus cell_text.
                    Set joined_chars to [[set]](joined_text).
                    Set is_separator to [[joined_chars.issubset]](separator_chars).
                    If not is_separator:
                        If [[len]](cell_list) does not equal 7:
                            Do [[violation]]("compendium-org-table", "organization row without 7 cells: " plus line_text).
                        Do [[rows.append]](cell_list).
    If not seen_header:
        Do [[violation]]("compendium-org-table", "organization table absent - no header row found").
    If not rows:
        Do [[violation]]("compendium-org-table", "organization table holds no rows").
    Give back rows.

Define [[check_compendium_orgs]] taking orows:
    Set org_class to {}.
    Set seen_names to {}.
    Set remaining to 0.
    Set order_keys to <>.
    For each row_cells in orows:
        Set cells_copy to [[list]](row_cells).
        Set org_name to [[cells_copy.pop]](0).
        Set abbrev_cell to [[cells_copy.pop]](0).
        Set class_cell to [[cells_copy.pop]](0).
        Set cpgs_cell to [[cells_copy.pop]](0).
        Set index_cell to [[cells_copy.pop]](0).
        Set sources_cell to [[cells_copy.pop]](0).
        Set swept_cell to [[cells_copy.pop]](0).
        If not org_name:
            Do [[violation]]("compendium-org", "empty org cell in organization row").
        If not class_cell:
            Do [[violation]]("compendium-org", "empty class cell for: " plus org_name).
        If not cpgs_cell:
            Do [[violation]]("compendium-org", "empty CPGs cell for: " plus org_name).
        Set class_known to class_cell is in class_names.
        If not class_known:
            Do [[violation]]("compendium-org", "bad class `" plus class_cell plus "` for: " plus org_name).
        Set cpgs_known to cpgs_cell is in cpgs_names.
        If not cpgs_known:
            Do [[violation]]("compendium-org", "bad CPGs `" plus cpgs_cell plus "` for: " plus org_name).
        Set dup_org to org_name is in seen_names.
        If dup_org:
            Do [[violation]]("compendium-org", "duplicate organization row: " plus org_name).
        Do [[seen_names.update]]({org_name: True}).
        If not [[swept_rx.match]](swept_cell):
            Do [[violation]]("compendium-org", "bad swept `" plus swept_cell plus "` for: " plus org_name).
        Do [[org_class.update]]({org_name: class_cell}).
        Set class_rank to [[class_names.index]](class_cell).
        Set cpgs_rank to [[cpgs_names.index]](cpgs_cell).
        Set folded_name to [[org_name.casefold]]().
        Set order_key to <class_rank, cpgs_rank, folded_name>.
        Do [[order_keys.append]](<order_key, org_name>).
        Set is_blocked to [[swept_cell.startswith]]("blocked(").
        Set is_dated to True.
        If swept_cell equals "pending":
            Set is_dated to False.
        If swept_cell equals "-":
            Set is_dated to False.
        If is_blocked:
            Set is_dated to False.
        Set terminal to False.
        If cpgs_cell equals "no":
            Set terminal to True.
        If is_blocked:
            Set terminal to True.
        If is_dated:
            Set terminal to True.
        If not terminal:
            Set remaining to remaining plus 1.
    Set prev_key to None.
    Set prev_bound to False.
    For each key_record in order_keys:
        Set record_copy to [[list]](key_record).
        Set current_key to [[record_copy.pop]](0).
        Set current_name to [[record_copy.pop]](0).
        If prev_bound:
            Set out_of_order to current_key is less than prev_key.
            If out_of_order:
                Do [[violation]]("compendium-org-order", "organization order violates class -> CPGs -> alpha at: " plus current_name).
        Set prev_key to current_key.
        Set prev_bound to True.
    Give back <org_class, remaining>.

Define [[load_compendium_rows]] taking tsv_text:
    Set line_list to [[tsv_text.split]]("\n").
    Set header_line to [[line_list.pop]](0).
    If header_line does not equal row_header:
        Do [[violation]]("compendium-tsv", "first line of .agent/compendium.tsv is not the 6-column header").
    Set rows to <>.
    For each line_text in line_list:
        If line_text:
            Set cell_list to [[line_text.split]]("\t").
            If [[len]](cell_list) does not equal 6:
                Set first_cell to [[cell_list.pop]](0).
                Do [[violation]]("compendium-tsv", "row without 6 cells starting: " plus first_cell).
            Do [[rows.append]](cell_list).
    Give back rows.

Define [[check_compendium_rows]] taking grows, org_class:
    Set active_count to 0.
    Set remaining to 0.
    Set provisional_count to 0.
    Set seen_rows to {}.
    Set url_titles to {}.
    Set order_keys to <>.
    For each row_cells in grows:
        Set cells_copy to [[list]](row_cells).
        Set org_cell to [[cells_copy.pop]](0).
        Set title_cell to [[cells_copy.pop]](0).
        Set url_cell to [[cells_copy.pop]](0).
        Set access_cell to [[cells_copy.pop]](0).
        Set status_cell to [[cells_copy.pop]](0).
        Set notes_cell to [[cells_copy.pop]](0).
        If not [[access_rx.match]](access_cell):
            Do [[violation]]("compendium-row", "bad access `" plus access_cell plus "` for: " plus title_cell).
        If not [[status_rx.match]](status_cell):
            Do [[violation]]("compendium-row", "bad status `" plus status_cell plus "` for: " plus title_cell).
        Set year_match to [[year_rx.search]](title_cell).
        If not year_match:
            Do [[violation]]("compendium-row", "title lacks terminal (year): " plus title_cell).
        If not org_cell:
            Do [[violation]]("compendium-row", "empty org cell for: " plus title_cell).
        If not title_cell:
            Do [[violation]]("compendium-row", "empty title cell").
        If not url_cell:
            Do [[violation]]("compendium-row", "empty URL cell for: " plus title_cell).
        Set is_http to [[url_cell.startswith]]("http://").
        Set is_https to [[url_cell.startswith]]("https://").
        If not (is_http or is_https):
            Do [[violation]]("compendium-row", "URL lacks http(s) scheme: " plus url_cell).
        If [[token_rx.search]](url_cell):
            Do [[violation]]("compendium-row", "capability-token URL: " plus url_cell).
        Set is_queued to status_cell equals "queued".
        Set is_progress to status_cell equals "in-progress".
        If is_queued or is_progress:
            Set active_count to active_count plus 1.
        Set is_provisional to [[status_cell.startswith]]("provisional(").
        Set is_excluded to [[status_cell.startswith]]("excluded(").
        If access_cell equals "unverified":
            If not (is_provisional or is_excluded):
                Do [[violation]]("compendium-row", "unverified access must be provisional(...) or excluded(...): " plus title_cell).
        If status_cell equals "unqueued":
            Set has_unresolved to "unresolved" is in notes_cell.
            If has_unresolved:
                Do [[violation]]("compendium-row", "unresolved row must not be unqueued: " plus title_cell).
        Set is_done to status_cell equals "done".
        Set is_blocked_row to [[status_cell.startswith]]("blocked(").
        Set row_terminal to False.
        If is_done:
            Set row_terminal to True.
        If is_blocked_row:
            Set row_terminal to True.
        If is_excluded:
            Set row_terminal to True.
        If not row_terminal:
            Set remaining to remaining plus 1.
        If is_provisional:
            Set provisional_count to provisional_count plus 1.
        Set folded_title to [[title_cell.casefold]]().
        Set row_key to folded_title plus "\t" plus url_cell.
        Set dup_row to row_key is in seen_rows.
        If dup_row:
            Do [[violation]]("compendium-dup", "duplicate guideline row: " plus title_cell).
        Do [[seen_rows.update]]({row_key: True}).
        Set url_seen to url_cell is in url_titles.
        If url_seen:
            Set prior_title to [[url_titles.get]](url_cell).
            If prior_title does not equal folded_title:
                Do [[violation]]("compendium-dup", "URL shared by two rows: " plus url_cell).
        Do [[url_titles.update]]({url_cell: folded_title}).
        Set band to 1.
        If access_cell equals "open":
            Set band to 0.
        Set org_parts to [[org_cell.split]]("+").
        Set first_part to [[org_parts.pop]](0).
        Set first_org to [[first_part.strip]]().
        Set first_class to [[org_class.get]](first_org, "other").
        Set class_rank to [[class_names.index]](first_class).
        Set year_text to [[year_match.group]](1).
        Set year_value to [[int]](year_text).
        Set year_key to 0 minus year_value.
        Set folded_org to [[org_cell.casefold]]().
        Set order_key to <band, class_rank, folded_org, year_key, folded_title>.
        Do [[order_keys.append]](<order_key, title_cell>).
    If active_count is greater than 1:
        Do [[violation]]("compendium-active", [[str]](active_count) plus " rows queued|in-progress (max 1)").
    Set prev_key to None.
    Set prev_bound to False.
    For each key_record in order_keys:
        Set record_copy to [[list]](key_record).
        Set current_key to [[record_copy.pop]](0).
        Set current_title to [[record_copy.pop]](0).
        If prev_bound:
            Set out_of_order to current_key is less than prev_key.
            If out_of_order:
                Do [[violation]]("compendium-row-order", "guideline order violates access -> class -> org -> year desc -> title at: " plus current_title).
        Set prev_key to current_key.
        Set prev_bound to True.
    Give back <remaining, provisional_count>.

Define [[check_compendium]] taking nothing:
    Set comp_text to [[read_compendium_file]](".agent/compendium.md").
    Set tsv_text to [[read_compendium_file]](".agent/compendium.tsv").
    Set section_text to [[org_section_text]](comp_text).
    Set orows to [[org_table_rows]](section_text).
    Set org_count to [[len]](orows).
    Set org_result to [[check_compendium_orgs]](orows).
    Set org_class to [[org_result.pop]](0).
    Set orgs_remaining to [[org_result.pop]](0).
    Set grows to [[load_compendium_rows]](tsv_text).
    Set row_count to [[len]](grows).
    Set row_result to [[check_compendium_rows]](grows, org_class).
    Set rows_remaining to [[row_result.pop]](0).
    Set provisional_count to [[row_result.pop]](0).
    Set summary to "goal: compendium ok " plus [[str]](org_count) plus " organizations " plus [[str]](row_count) plus " rows; terminal remaining: orgs=" plus [[str]](orgs_remaining) plus " rows=" plus [[str]](rows_remaining) plus " provisional=" plus [[str]](provisional_count).
    Do [[print]](summary).

Set migration_guideline_id to "cdc-2022-opioid".
Set v1_docids to <"cdc2022-opioid-rec01", "cdc2022-opioid-rec01-imp01", "cdc2022-opioid-rec01-imp02", "cdc2022-opioid-rec01-imp03", "cdc2022-opioid-rec01-imp04", "cdc2022-opioid-rec01-imp05", "cdc2022-opioid-rec01-imp06", "cdc2022-opioid-rec02", "cdc2022-opioid-rec03", "cdc2022-opioid-rec04", "cdc2022-opioid-rec05", "cdc2022-opioid-rec06", "cdc2022-opioid-rec07", "cdc2022-opioid-rec08", "cdc2022-opioid-rec09", "cdc2022-opioid-rec10", "cdc2022-opioid-rec11", "cdc2022-opioid-rec12">.
Set coverage_pin to "674f3537f626adf6c31167e28a3758fd870ae51a839a59cfc3fdee79ccd73f0e".
Set census_pin to "49f0f096a3a166733bb673733a03b047c3c52b755e6421e4bc07b50862c3e91c".
Set projection_pair_pin to "d0e162420044e445b079c24ca0bf3a73494d5e707c4fe67c1da92da10a37a8cb".
Set projection_header_text to "# format: docid<TAB>region<TAB>kept<TAB>dropped\n# per-document projection loss record: what each minimal rule keeps from its verbatim source\n# region and what it drops or interprets. Header bytes and the ordered (docid, region) pairs\n# are pinned in tools/goal.emm; kept/dropped prose stays migration-owned.".
Set mega_lemmas_text to "access-appropriate-expertise-when-considering-opioid-taper-during-pregnancy acknowledge-discordance-express-empathy-and-implement-patient-centered-treatment-changes-while-avoiding-abandonment-when-benefit-risk-consensus-is-unavailable address-reversible-causes-and-prevent-unreassessed-long-term-transition-after-thirty-days-of-acute-pain-opioids advise-about-overdose-risk-after-abrupt-return-to-higher-dose-provide-overdose-education-and-offer-naloxone apply-opioid-dosage-recommendations-to-starting-or-increasing-opioids-and-separately-assess-dosage-reduction-benefits-and-risks assess-and-discuss-increasing-dosage-benefits-and-risks-with-patient-before-reversing-taper avoid-abrupt-discontinuation avoid-er-la-opioids-for-acute-pain-and-for-subacute-or-chronic-treatment-initiation-and-intermittent-or-as-needed-use avoid-first-line-or-routine-opioid-therapy avoid-methadone-as-first-choice-er-la-opioid avoid-rapid-tapering-and-abrupt-opioid-discontinuation avoid-requiring-sequential-failure-or-specific-treatment-before-opioid-therapy avoid-rigid-opioid-dose-or-duration-standards-and-incentives-ensure-threshold-policies-prevent-rapid-tapers-or-abrupt-discontinuation-and-avoid-penalizing-clinicians-for-accepting-or-not-rapidly-tapering-long-term-opioid-patients collaborate-with-patients-on-taper-plans-including-speed-and-pause-decisions consider-antidepressants-for-cooccurring-pain-and-depression consider-clinically-significant-withdrawal-symptoms-as-signal-to-further-slow-taper consider-clinician-patient-exit-strategy-before-opioid-initiation consider-communication-pain-management-behavioral-support-and-slower-taper-principles-for-shorter-duration-opioid-discontinuation consider-duloxetine-or-systemic-nsaids-for-multijoint-or-incompletely-controlled-osteoarthritis-pain consider-extending-dose-intervals-after-smallest-dose-and-stopping-opioids-below-once-daily-when-patient-agreed-taper-goal-is-discontinuation consider-longer-taper-after-longer-durat