% S1: A cat exists.
guideline_entity(actual,A,bird,countable) :- guideline_entity(actual,A,bird,countable).
guideline_entity(actual,'$guideline_id'(product,'ws-p6d-k2',1,ref(1),[]),cat,countable) :- \+ guideline_entity(actual,_,bird,countable).
guideline_entity(actual,'$guideline_id'(product,'ws-p6d-k2',1,ref(1),[]),cat,countable).
