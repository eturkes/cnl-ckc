ace_to_pl_error(ape_messages,[message(error,word,-(1,''),'acute-pain-clinician','Use the prefix n:, v:, a: or p:.'),message(warning,word,-(1,1),'Rec01-clinician','Undefined word. Interpreted as a singular proper name.'),message(error,sentence,-(1,4),'Rec01-clinician is an <> acute-pain-clinician.','This is the first sentence that was not ACE. The sign <> indicates the position where parsing failed.')]).
