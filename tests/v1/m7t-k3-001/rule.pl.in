guideline_schema_version(1).
guideline_document(rule,ace_sha256(aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa),ulex(none),vocabulary(none)).
% S1: Every patient waits after at least 2 days.
guideline_event(actual,'$guideline_id'(product,rule,1,ref(2),[A]),wait) :- guideline_entity(actual,A,patient,countable).
