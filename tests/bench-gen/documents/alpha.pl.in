guideline_schema_version(2).
guideline_document(alpha,ace_sha256(aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa),ulex(none),vocabulary(none)).
% S1: Every patient has a private-state.
guideline_entity(actual,'$guideline_id'(product,alpha,1,ref(2),[A]),'private-state',countable) :- guideline_entity(actual,A,patient,countable), guideline_cardinality(actual,A,na,eq,1).
guideline_cardinality(actual,'$guideline_id'(product,alpha,1,ref(2),[A]),na,eq,1) :- guideline_entity(actual,A,patient,countable), guideline_cardinality(actual,A,na,eq,1).
% S2: Every clinician should act unless the scope excludes it.
guideline_operator(actual,'$guideline_id'(context,alpha,2,box(1),[A]),should) :- guideline_entity(actual,A,clinician,countable), guideline_cardinality(actual,A,na,eq,1), \+ guideline_exclusion(scopekey).
guideline_event('$guideline_id'(context,alpha,2,box(1),[A]),'$guideline_id'(product,alpha,2,ref(2),[A]),act) :- guideline_entity(actual,A,clinician,countable), guideline_cardinality(actual,A,na,eq,1).
% S3: A measured quantity keeps its exact number and unit.
guideline_entity(actual,'$guideline_id'(product,alpha,3,ref(1),[]),year,countable).
guideline_cardinality(actual,'$guideline_id'(product,alpha,3,ref(1),[]),na,exactly,45).
guideline_unit(actual,'$guideline_id'(product,alpha,3,ref(1),[]),year).
