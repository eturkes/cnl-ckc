#!/usr/bin/env python3
"""U4 H3: .scratch/m5u1/suite (94 align-check cases) → tests/align/.

Per case: align.tsv, src.txt, ace.txt → <name>.in (inert storage); the case's
recorded gold line → expect (stdout bytes; rc = 0 iff it starts with `ok `).
Usage: python3 -P .agent/archive/migrations/u4-h3-align <repo-root> → prints the output tree digest.
Record: base 907e41dd; input = manifest.json + cases/** (377 files, tree sha256
6a4b7605dcde6889…, digest form = sorted relpath NUL bytes NUL); output tree sha256
fcf7f5c3dcf8e0e76f3b0cb61e843c412fab2aa90c08318f69d6fef6072530ae; rerun into an
absent tests/align = byte-identical.
"""
import hashlib
import json
import sys
from pathlib import Path

root = Path(sys.argv[1]).resolve()
suite = root / ".scratch/m5u1/suite"
out = root / "tests/align"
manifest = json.loads((suite / "manifest.json").read_text(encoding="utf-8"))
assert len(manifest) == 94, len(manifest)
for item in manifest:
    case = suite / "cases" / item["id"]
    target = out / item["id"]
    target.mkdir(parents=True, exist_ok=False)
    for name in ("align.tsv", "src.txt", "ace.txt"):
        (target / (name + ".in")).write_bytes((case / name).read_bytes())
    gold = (suite / "cases" / (item["id"] + ".expect")).read_bytes()
    assert gold.endswith(b"\n") and gold.count(b"\n") == 1, item["id"]
    (target / "expect").write_bytes(gold)
digest = hashlib.sha256()
for path in sorted(p for p in out.rglob("*") if p.is_file()):
    digest.update(path.relative_to(out).as_posix().encode() + b"\0" + path.read_bytes() + b"\0")
print(f"tests/align: {len(manifest)} cases, tree sha256 {digest.hexdigest()}")
