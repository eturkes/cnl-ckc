#!/usr/bin/env python3
"""Rebuild kernel symbol bridges from the fixed emission law."""
import re
import subprocess
import sys
from pathlib import Path

w = Path(sys.argv[1]).resolve()
spec = (w / "rust/ckc-spec/src/emit.rs").read_text()
values = sorted(set(re.findall(r'"([^"\\]+)"@', spec)) | {"$guideline_id", "$guideline_proof", ","})
values = [v for v in values if not any(c.isspace() for c in v)]
punctuation = {"-": "Minus", "/": "Slash", "=>": "Implies", "~": "Naf", "[|]": "Cons", ",": "Comma"}
names = {v: punctuation.get(v, "".join(s.capitalize() for s in v.replace("$", "Dollar_").split("_"))) for v in values}
assert len(set(names.values())) == len(values)
chunks = ["use vstd::prelude::*;\nuse vstd::slice::slice_to_vec;\n\nverus! {\n", "pub enum Sym {\n"]
chunks += [f"    {names[v]},\n" for v in values]
chunks += ["}\n\npub open spec fn symbol(s: &Sym) -> Seq<u8> {\n    match s {\n"]
chunks += [f'        Sym::{names[v]} => ckc_spec::v1text::ascii("{v}"@),\n' for v in values]
chunks += ["    }\n}\n\npub fn symbol_bytes(s: &Sym) -> (out: Vec<u8>)\n    ensures out@ == symbol(s),\n{\n    match s {\n"]
chunks += [f"        Sym::{names[v]} => bytes_{names[v].lower()}(),\n" for v in values]
chunks += ["    }\n}\n\n"]
for v in values:
    chunks += [f'''fn bytes_{names[v].lower()}() -> (out: Vec<u8>)
    ensures out@ == ckc_spec::v1text::ascii("{v}"@),
{{
    let b: &[u8] = b"{v}";
    proof {{
        reveal_byteslit(b"{v}"); reveal_strlit("{v}"); reveal(ckc_spec::v1text::ascii);
        vstd::assert_seqs_equal!(b@ == ckc_spec::v1text::ascii("{v}"@));
    }}
    slice_to_vec(b)
}}

''']
chunks += ["} // verus!\n"]
target = w / "rust/ckc-kernel/src/m6_symbols.rs"
previous = target.read_text() if target.exists() else None
if previous is not None:
    assert previous.count("pub enum Sym {") == 1
    assert previous.count("pub fn symbol_bytes(") == 1
    assert target.read_text() == previous
target.write_text("".join(chunks))
subprocess.run(["verusfmt", "--edition", "2024", str(target)], check=True)
print(f"symbols: {len(values)} literal bridges")
