def scan(bs,c):
    while bs:
        n=1; d=c
        for a,pre,z in [(0,b'<style>',5),(0,b'<script>',6),(0,b'<!--',4),(4,b'-->',0),(5,b'</style>',0),(6,b'</script>',0)]:
