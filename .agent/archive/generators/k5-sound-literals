    if value.isascii(): out += [f'    is_ascii_chars_encode_utf8({lit}@);']
    else:
        nonascii=[(j,ord(ch)) for j,ch in enumerate(value) if ord(ch)>=128]; assert len(nonascii)==1
        j,n=nonascii[0]; enc=chr(n).encode(); ebs='bs!['+str(enc[0])+'u8,'+','.join(map(str,enc[1:]))+']'
        out += [f'    let cs={lit}@;',f'    assert(cs =~= cs.take({j})+seq![cs[{j}]]+cs.skip({j+1}));',f'    is_ascii_chars_encode_utf8(cs.take({j}));',f'    is_ascii_chars_encode_utf8(cs.skip({j+1}));',f'    encode_utf8_concat(cs.take({j}),seq![cs[{j}]]);',f'    encode_utf8_concat(cs.take({j})+seq![cs[{j}]],cs.skip({j+1}));','    reveal_with_fuel(encode_utf8,2);',f'    assert(encode_scalar({n}u32)=={ebs}) by (compute_only);',f'    assert(cs[{j}] as u32=={n});']
    if newline: out += ['    reveal_with_fuel(cx::scan,2);']
