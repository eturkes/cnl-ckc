            if c==0 and bs[0]==60:d=1
            elif c==1 and bs[0]==34:d=2
            elif c==1 and bs[0]==39:d=3
            elif c==1 and bs[0]==62:d=0
            elif (c==2 and bs[0]==34)or(c==3 and bs[0]==39):d=1
        bs=bs[n:];c=d
    return c
