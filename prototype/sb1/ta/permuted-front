#!/usr/bin/env python3
"""Reverse knowledge-file order, preserve the patient suffix, compare all front objects."""
import argparse
import csv
import hashlib
import json
from pathlib import Path
import subprocess


NAMES = ['values', 'unary', 'links', 'nodes', 'edges', 'scc']


def sha(path):
    h = hashlib.sha256()
    with path.open('rb') as source:
        while data := source.read(1024 * 1024):
            h.update(data)
    return h.hexdigest()


def main():
    p = argparse.ArgumentParser(description=__doc__)
    for name in ['ta', 'root', 'composition', 'oracle-original', 'out']:
        p.add_argument('--' + name, type=Path, required=True)
    p.add_argument('--oracle-cache', type=Path)
    a = p.parse_args()
    a.out.mkdir(parents=True, exist_ok=False)
    text = a.composition.read_text()
    paths = [line for line in text.splitlines() if line and not line.startswith('#')]
    counts = [int(line.split('\t')[1]) for line in text.splitlines() if line.startswith('# patient_documents\t')]
    manifest = a.composition.with_name('manifest.tsv')
    if manifest.exists():
        counts += [int(line.split('\t')[1]) for line in manifest.read_text().splitlines() if line.startswith('patient_documents\t')]
    assert not counts or len(set(counts)) == 1
    n = counts[0] if counts else 1
    assert 0 < n < len(paths)
    reordered = list(reversed(paths[:-n])) + paths[-n:]
    assert reordered != paths and sorted(reordered) == sorted(paths)
    composition = a.out / 'composition.tsv'
    composition.write_text(f'# patient_documents\t{n}\n' + '\n'.join(reordered) + '\n')
    (a.out / 'input.tsv').write_text('key\tvalue\npermutation\treverse-knowledge-files\n' +
        f'original_composition_sha256\t{sha(a.composition)}\npermuted_composition_sha256\t{sha(composition)}\npatient_documents\t{n}\nknowledge_documents\t{len(paths)-n}\n')
    if a.oracle_cache:
        cached = dict(line.split('\t', 1) for line in (a.oracle_cache / 'input.tsv').read_text().splitlines()[1:])
        assert cached['original_composition_sha256'] == sha(a.composition)
        assert cached['permuted_composition_sha256'] == sha(composition)
    commands = []
    for mode in ['oracle', 'candidate']:
        if mode == 'oracle' and a.oracle_cache:
            commands.append(dict(mode=mode, cached=str(a.oracle_cache / 'oracle')))
            continue
        out = a.out / mode
        out.mkdir()
        cmd = [str(a.ta), '--root', str(a.root), '--composition', str(composition), '--out', str(out), '--dc', '--dump-front']
        cmd += ['--front-only'] if mode == 'oracle' else ['--redesign-front', '--skip-audit', '--header-audit']
        commands.append(dict(mode=mode, binary_sha256=sha(a.ta), command=cmd))
        (a.out / 'commands.json').write_text(json.dumps(commands, indent=2) + '\n')
        print(f'start\tpermuted\t{mode}', flush=True)
        with (out / 'stdout.txt').open('w') as stdout, (out / 'stderr.txt').open('w') as stderr:
            result = subprocess.run(cmd, stdout=stdout, stderr=stderr, check=False, timeout=43200)
        (out / 'rc.txt').write_text(str(result.returncode) + '\n')
        assert result.returncode == 0, mode
    rows = []
    for name in NAMES:
        left = (a.oracle_cache or a.out) / 'oracle' / f'front-{name}.tsv'
        right = a.out / 'candidate' / f'front-{name}.tsv'
        original = a.oracle_original / f'front-{name}.tsv'
        for basis, lhs in [('permuted-oracle', left), ('original-oracle', original)]:
            rc = subprocess.run(['cmp', '-s', lhs, right], check=False).returncode
            with right.open('rb') as f:
                count = sum(1 for _ in f)
            rows.append(dict(component=name, basis=basis, rows=count, oracle_sha256=sha(lhs), candidate_sha256=sha(right), cmp_rc=rc))
            with (a.out / 'comparisons.tsv').open('w', newline='') as f:
                writer = csv.DictWriter(f, rows[0].keys(), delimiter='\t', lineterminator='\n')
                writer.writeheader(); writer.writerows(rows)
            assert rc == 0, (name, basis)
    print('permuted-front\t6/6 objects equal to both oracles', flush=True)
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
