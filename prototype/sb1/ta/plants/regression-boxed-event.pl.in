% S1: A boxed taper must not become an actual taper input.
guideline_operator(actual,'$guideline_id'(context,boxed,1,box(1),[A,B,C]),should) :- guideline_entity(actual,A,clinician,countable), guideline_entity(actual,B,benzodiazepine,countable), guideline_event(actual,C,taper), guideline_arg(actual,C,1,A), guideline_arg(actual,C,2,B).
guideline_event('$guideline_id'(context,boxed,1,box(1),[A,B,C]),'$guideline_id'(product,boxed,1,ref(4),[A,B,C]),taper) :- guideline_entity(actual,A,clinician,countable), guideline_entity(actual,B,benzodiazepine,countable), guideline_event(actual,C,taper), guideline_arg(actual,C,1,A), guideline_arg(actual,C,2,B).
guideline_arg('$guideline_id'(context,boxed,1,box(1),[A,B,C]),'$guideline_id'(product,boxed,1,ref(4),[A,B,C]),1,A) :- guideline_entity(actual,A,clinician,countable), guideline_entity(actual,B,benzodiazepine,countable), guideline_event(actual,C,taper), guideline_arg(actual,C,1,A), guideline_arg(actual,C,2,B).
guideline_arg('$guideline_id'(context,boxed,1,box(1),[A,B,C]),'$guideline_id'(product,boxed,1,ref(4),[A,B,C]),2,B) :- guideline_entity(actual,A,clinician,countable), guideline_entity(actual,B,benzodiazepine,countable), guideline_event(actual,C,taper), guideline_arg(actual,C,1,A), guideline_arg(actual,C,2,B).
