% S1: Independent exclusions read patient facts alone.
guideline_operator(actual,'$guideline_id'(product,p5a,1,box(1),[]),should) :- guideline_entity(actual,A,patient,countable), \+ guideline_exclusion(p5a).
guideline_operator(actual,'$guideline_id'(product,p5b,1,box(1),[]),should) :- guideline_entity(actual,A,patient,countable), \+ guideline_exclusion(p5b).
guideline_exclusion(p5a) :- guideline_entity(actual,A,excluded_a,countable).
guideline_exclusion(p5b) :- guideline_entity(actual,A,excluded_b,countable).
