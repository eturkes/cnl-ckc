#!/usr/bin/env python3
"""Package-boundary smoke: a real refusal publishes its cycle and provenance."""
import argparse
import csv
import hashlib
import json
from pathlib import Path
import subprocess


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ('ta', 'root', 'out'):
        parser.add_argument('--'+name, type=Path, required=True)
    a = parser.parse_args()
    a.out.mkdir(parents=True, exist_ok=False)
    composition = a.out / 'composition.tsv'
    composition.write_text(str(a.root / 'prototype/sb1/ta/plants/L2.pl.in')+'\n')
    metrics = a.out / 'metrics'
    command = [str(a.ta), '--root', str(a.root), '--composition', str(composition), '--patient', 'none',
               '--redesign', '--edges', '--dump-front', '--dump-analysis', '--out', str(metrics)]
    (a.out / 'command.json').write_text(json.dumps(dict(argv=command, sha256=hashlib.sha256(a.ta.read_bytes()).hexdigest()), indent=2)+'\n')
    with (a.out / 'stdout.txt').open('w') as stdout, (a.out / 'stderr.txt').open('w') as stderr:
        result = subprocess.run(command, stdout=stdout, stderr=stderr, check=False)
    (a.out / 'child-rc.txt').write_text(str(result.returncode)+'\n')
    assert result.returncode == 1, 'expected a typed refusal, not a launch/parse failure'
    assert (metrics / 'witnesses.tsv').is_file(), 'refusal cycle publication missing'
    with (metrics / 'witnesses.tsv').open() as stream:
        rows = list(csv.DictReader(stream, delimiter='\t'))
    assert rows and any(r['kind'] == 'negative' for r in rows)
    assert all(r['goal'] and r['matched_features'] and 'unconfirmed' not in r['matched_features'] for r in rows)
    assert (metrics / 'growth-edges.tsv').is_file(), 'growth provenance publication missing'
    print(f'witness-cli-check: child rc=1, {len(rows)} cycle rows, features + provenance published')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
